<Window x:Class="HRManagement.Views.Windows.OtDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule OT" Height="220" Width="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Date:" Width="80" VerticalAlignment="Center" />
            <DatePicker x:Name="DpDate" SelectedDate="{Binding SelectedDate}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.Row="1">
            <TextBlock Text="Start (HH:mm):" Width="80" VerticalAlignment="Center" />
            <TextBox x:Name="TbStart" Width="100" />
            <TextBlock Text="End (HH:mm):" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBox x:Name="TbEnd" Width="100" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Example time format: 18:30" Foreground="Gray" FontSize="12" />

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
