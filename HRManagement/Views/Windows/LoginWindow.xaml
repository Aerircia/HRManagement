<Window x:Class="HRManagement.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HRManagement.Views.Windows"
        xmlns:vm="clr-namespace:HRManagement.ViewModels"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Border
                Width="340"
                Padding="30"
                Style="{StaticResource CardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock
                    Text="HR Manager"
                    FontSize="28"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Human Resource Management"
                    Margin="0,5,0,30"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox
                    Margin="0,6,0,20"
                    Height="38"/>

                <TextBlock Text="Password"/>

                <PasswordBox
                    Margin="0,6,0,30"
                    Height="38"/>

                <Button
                    Content="Login"
                    Command="{Binding LoginCommand}"
                    Height="40"/>
            </StackPanel>
        </Border>
    
    </Grid>
</Window>
