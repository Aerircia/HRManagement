<Window x:Class="HRManagement.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:HRManagement.Views.Shared"
        Title="{Binding WindowTitle}"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <Border x:Name="RootBorder"
        CornerRadius="14"
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect Color="#1A2B3674" BlurRadius="24" ShadowDepth="6" Opacity="0.22" Direction="270"/>
        </Border.Effect>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding DataContext.IsCollapsed, ElementName=SidebarHost, Converter={StaticResource CollapsedToWidthConverter}, FallbackValue=240}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.Clip>
                <RectangleGeometry x:Name="ContentClipGeometry" RadiusX="14" RadiusY="14"/>
            </Grid.Clip>

            <!-- Sidebar -->

            <shared:Sidebar x:Name="SidebarHost"
                Grid.Column="0"
                Grid.Row="1"
                Grid.RowSpan="3"/>

            <!-- TitleBar -->

            <shared:TitleBar
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Grid.Row="0"/>

            <!-- User Toolbar -->

            <shared:TopBar
                Grid.Column="1"
                Grid.Row="1"/>

            <!-- Current Page -->

            <Border Grid.Column="1"
                    Grid.Row="2"
                    Margin="20"
                    Background="{DynamicResource WindowBackgroundBrush}">

                <ContentControl
                    Content="{Binding CurrentPage}" />

            </Border>

        </Grid>

    </Border>

</Window>
