<UserControl x:Class="HRManagement.Views.Shared.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HRManagement.Views.Shared"
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">
    <Border Background="{DynamicResource TitleBarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid Margin="16,0,12,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition/>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <!-- App icon + name (replaces the old plain "HR Manager" text) -->

            <!-- App branding: collapses to just the icon -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Border Style="{StaticResource AppLogoBadgeStyle}">
                    <Image Source="/Assets/logo.png"
                           Margin="-10"
                           Width="40" Height="40"
                           Stretch="Uniform"/>
                </Border>

                <TextBlock Text="HR Management"
                           Style="{StaticResource AppNameTextStyle}"
                           Margin="10,0,0,0"/>

            </StackPanel>

            <Button Grid.Column="2"
                    Width="40"
                    Height="40"
                    Command="{Binding MinimizeCommand}"
                    Style="{StaticResource ShellIconButtonStyle}">

                <fa:IconBlock Icon="WindowMinimize"
                              Foreground="{DynamicResource ShellSecondaryTextBrush}"/>

            </Button>

            <Button Grid.Column="3"
                    Width="40"
                    Height="40"
                    Command="{Binding MaximizeCommand}"
                    Style="{StaticResource ShellIconButtonStyle}">

                <fa:IconBlock Icon="WindowMaximize"
                              Foreground="{DynamicResource ShellSecondaryTextBrush}"/>

            </Button>

            <Button Grid.Column="4"
                    Width="40"
                    Height="40"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource ShellIconButtonStyle}">

                <fa:IconBlock Icon="Xmark"
                              Foreground="{DynamicResource ShellSecondaryTextBrush}"/>

            </Button>

        </Grid>

    </Border>
</UserControl>
