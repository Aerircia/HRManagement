<UserControl x:Class="HRManagement.Views.Shared.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HRManagement.Views.Shared"
             mc:Ignorable="d" 
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp">
    <Border Background="{DynamicResource CardBackgroundBrush}"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid Margin="12,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Text="HR Manager"/>

            <Button Grid.Column="1"
                    Width="40"
                    Height="40"
                    Command="{Binding MinimizeCommand}"
                    Background="Transparent"
                    BorderThickness="0">

                <fa:IconBlock Icon="WindowMinimize"/>

            </Button>

            <Button Grid.Column="2"
                    Width="40"
                    Height="40"
                    Command="{Binding MaximizeCommand}"
                    Background="Transparent"
                    BorderThickness="0">

                <fa:IconBlock Icon="WindowMaximize"/>

            </Button>

            <Button Grid.Column="3"
                    Width="40"
                    Height="40"
                    Command="{Binding CloseCommand}"
                    Background="Transparent"
                    BorderThickness="0">

                <fa:IconBlock Icon="Xmark"/>

            </Button>

        </Grid>

    </Border>
</UserControl>
