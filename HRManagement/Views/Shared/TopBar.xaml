<UserControl x:Class="HRManagement.Views.Shared.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d">

    <Border Background="{DynamicResource ShellChromeGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}">

        <Grid Margin="24,0">

            <Grid.ColumnDefinitions>

                <!-- Search -->
                <ColumnDefinition Width="360"/>

                <!-- Spacer -->
                <ColumnDefinition Width="*"/>

                <!-- Notification -->
                <ColumnDefinition Width="Auto"/>

                <!-- Support -->
                <ColumnDefinition Width="Auto"/>

                <!-- Divider -->
                <ColumnDefinition Width="Auto"/>

                <!-- User -->
                <ColumnDefinition Width="Auto"/>

                <!-- Logout -->
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <!-- ================= Notification ================= -->

            <Button Grid.Column="2"
                    Margin="0,0,8,0"
                    Style="{StaticResource ShellIconButtonStyle}">

                <fa:IconBlock Icon="Bell"
                  Width="16"
                  Height="16"
                  Foreground="{DynamicResource ShellSecondaryTextBrush}"/>

            </Button>

            <!-- ================= Support ================= -->

            <Button Grid.Column="3"
                    Margin="0,0,16,0"
                    Style="{StaticResource ShellIconButtonStyle}">

                <fa:IconBlock Icon="CircleQuestion"
                      Width="16"
                      Height="16"
                      Foreground="{DynamicResource ShellSecondaryTextBrush}" />

            </Button>

            <!-- ================= Divider ================= -->

            <Border Grid.Column="4"
                    Width="1"
                    Height="28"
                    Margin="0,0,16,0"
                    Background="{DynamicResource ShellDividerBrush}"/>

            <!-- ================= User ================= -->

            <StackPanel Grid.Column="5"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Grid Width="42"
                      Height="42">

                    <Ellipse Fill="{DynamicResource PrimaryTintBrush}"/>

                    <Image Source="{Binding Avatar, Converter={StaticResource AvatarPathConverter}}"
                           Stretch="UniformToFill">

                        <Image.Clip>

                            <EllipseGeometry
                                Center="21,21"
                                RadiusX="21"
                                RadiusY="21"/>

                        </Image.Clip>

                    </Image>

                </Grid>

                <StackPanel Margin="12,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ShellTextBrush}"
                        Text="{Binding UserName}" />

                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource ShellSecondaryTextBrush}"
                        Text="{Binding RoleName}" />

                </StackPanel>

            </StackPanel>

            <!-- ================= Logout ================= -->

            <Button Grid.Column="6"
                    Margin="16,0,0,0"
                    Style="{StaticResource ShellIconButtonStyle}"
                    Command="{Binding LogoutCommand}"
                    ToolTip="Log out">

                <fa:IconBlock Icon="RightFromBracket"
                      Width="16"
                      Height="16"
                      Foreground="{DynamicResource ShellSecondaryTextBrush}" />

            </Button>

        </Grid>

    </Border>

</UserControl>
