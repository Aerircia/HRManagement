<UserControl x:Class="HRManagement.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HRManagement.Controls"
             mc:Ignorable="d"
             Background="{DynamicResource WindowBackgroundBrush}"
             d:DesignHeight="820" d:DesignWidth="900">

    <UserControl.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RowDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="AboutLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="AboutValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="PasswordStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PasswordChangeSucceeded}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AboutRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="30">
        <StackPanel>

            <TextBlock Text="Settings"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,24"/>

            <!-- ===== Accessibility ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Accessibility" Style="{StaticResource CardTitleStyle}"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Dark Theme" Style="{StaticResource RowLabelStyle}"/>
                            <TextBlock Text="Switch between light and dark appearance."
                                       Style="{StaticResource RowDescriptionStyle}"/>
                        </StackPanel>

                        <controls:ToggleSwitch
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Privacy ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Privacy" Style="{StaticResource CardTitleStyle}"/>

                    <TextBlock Text="Current Password" Style="{StaticResource RowLabelStyle}" Margin="0,0,0,6"/>
                    <controls:BindablePasswordBox Password="{Binding CurrentPassword}"
                                                   Margin="0,0,0,14"/>

                    <TextBlock Text="New Password" Style="{StaticResource RowLabelStyle}" Margin="0,0,0,6"/>
                    <controls:BindablePasswordBox Password="{Binding NewPassword}"
                                                   Margin="0,0,0,14"/>

                    <TextBlock Text="Confirm New Password" Style="{StaticResource RowLabelStyle}" Margin="0,0,0,6"/>
                    <controls:BindablePasswordBox Password="{Binding ConfirmPassword}"
                                                   Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding PasswordStatusMessage}"
                               Style="{StaticResource PasswordStatusStyle}"
                               Margin="0,0,0,14"/>

                    <Button Content="Save Password"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SavePasswordCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ===== About ===== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource CardTitleStyle}"/>

                    <Grid Style="{StaticResource AboutRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Application Name" Style="{StaticResource AboutLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ApplicationName}" Style="{StaticResource AboutValueStyle}"/>
                    </Grid>

                    <Grid Style="{StaticResource AboutRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Version" Style="{StaticResource AboutLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource AboutValueStyle}"/>
                    </Grid>

                    <Grid Style="{StaticResource AboutRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text=".NET Version" Style="{StaticResource AboutLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DotNetVersion}" Style="{StaticResource AboutValueStyle}"/>
                    </Grid>

                    <Grid Style="{StaticResource AboutRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Database" Style="{StaticResource AboutLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding DatabaseName}" Style="{StaticResource AboutValueStyle}"/>
                    </Grid>

                    <Grid Style="{StaticResource AboutRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Developer" Style="{StaticResource AboutLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Developer}" Style="{StaticResource AboutValueStyle}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Copyright" Style="{StaticResource AboutLabelStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Copyright}"
                                   Style="{StaticResource AboutValueStyle}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
