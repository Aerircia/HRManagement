<UserControl x:Class="HRManagement.Views.Pages.ManageContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utilities="clr-namespace:HRManagement.Utilities"
             mc:Ignorable="d"
             d:DesignWidth="1240" d:DesignHeight="820"
             Background="{StaticResource WindowBackgroundBrush}">

    <UserControl.Resources>

        <utilities:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
            CardStyle -> SurfaceCardStyle, StatusPillStyle, RowIconButtonStyle, and
            GridCellTextStyle -> TableCellTextStyle now come from the shared
            Resources/TableStyles.xaml (merged in App.xaml) so this page matches
            Manage Profiles, Requests, Manage Requests, and Manage Attendances.
            Only styles specific to this page's Add/Edit form remain local.
        -->

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="12,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <!-- Page content (Admin / Manager only)-->
        <Grid Margin="28"
              Visibility="{Binding HasAccess, Converter={StaticResource BoolToVisibility}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Manage Contracts"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="Manage employee contracts and salary terms"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ New Contract"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}"
                        Width="170"/>
            </Grid>

            <!-- Search -->
            <Border Grid.Row="2"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="14"
                    Padding="14,0"
                    Height="48"
                    HorizontalAlignment="Left"
                    Width="340">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             Tag="Search by employee or contract type..."/>
                </Grid>
            </Border>

            <!-- Contract table -->
            <Border Grid.Row="4" Style="{StaticResource SurfaceCardStyle}" Padding="0">

                <DataGrid ItemsSource="{Binding ContractsView}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="56"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}"/>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="1.6*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTextColumn Header="Contract Type" Binding="{Binding ContractType}" Width="1.2*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTextColumn Header="Start Date" Binding="{Binding StartDateDisplay}" Width="1.1*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTextColumn Header="End Date" Binding="{Binding EndDateDisplay}" Width="1.1*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPillStyle}">
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Base Salary" Binding="{Binding BaseSalaryDisplay}" Width="1.1*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource RowIconButtonStyle}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource RowIconButtonStyle}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

        <!-- Access denied  -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="360"
                    Visibility="{Binding HasNoAccess, Converter={StaticResource BoolToVisibility}}">

            <Border Width="64" Height="64"
                    CornerRadius="32"
                    Background="{StaticResource InputBackgroundBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                           Foreground="{StaticResource DangerBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Access restricted"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Manage Contracts is only available to Admin and Manager accounts. Contact your administrator if you believe this is a mistake."
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>

        </StackPanel>

        <!--Add / Edit overlay  -->
        <Grid Background="#66000000"
              Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="480"
                    MaxHeight="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="{Binding FormTitle}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="{Binding FormErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="Employee" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Employees}"
                              SelectedItem="{Binding FormSelectedEmployee}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource FormComboBoxStyle}"
                              Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Role" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding FormSelectedRole}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contract Type" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ContractTypeOptionsList}"
                                      SelectedItem="{Binding FormContractType}"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start Date" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding FormStartDate}"
                                        Style="{StaticResource FormDatePickerStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End Date (optional)" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding FormEndDate}"
                                        Style="{StaticResource FormDatePickerStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding StatusOptionsList}"
                                      SelectedItem="{Binding FormStatus}"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Base Salary" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding FormBaseSalary, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelCommand}"/>
                        <Button Grid.Column="2" Content="Save"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}"/>
                    </Grid>

                </StackPanel>

            </Border>
        </Grid>

        <!-- Delete confirmation overlay  -->
        <Grid Background="#66000000"
              Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Remove contract?"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20">
                        <Run Text="This will permanently delete the"/>
                        <Run Text="{Binding PendingDelete.ContractType, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="contract for"/>
                        <Run Text="{Binding PendingDelete.EmployeeName, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="."/>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDeleteCommand}"/>
                        <Button Grid.Column="2" Content="Delete"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="{StaticResource DangerBrush}"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </Grid>

                </StackPanel>

            </Border>
        </Grid>

    </Grid>

</UserControl>
