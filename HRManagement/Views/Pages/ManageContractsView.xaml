<UserControl x:Class="HRManagement.Views.Pages.ManageContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utilities="clr-namespace:HRManagement.Utilities"
             mc:Ignorable="d"
             d:DesignWidth="1240" d:DesignHeight="820"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>

        <utilities:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
            CardStyle -> SurfaceCardStyle, StatusPillStyle, RowIconButtonStyle,
            GridCellTextStyle -> TableCellTextStyle, StatCardStyle,
            StatIconBadgeStyle, and FormLabelStyle / FormTextBoxStyle /
            FormComboBoxStyle / FormDatePickerStyle all now come from shared
            dictionaries (Resources/TableStyles.xaml, Resources/FormStyles.xaml,
            merged in App.xaml) so this page matches Manage Profiles,
            Manage Requests, Manage Attendances, and the other Add/Edit forms
            (Manage Announcements, Profile). No page-local style overrides
            remain here.
        -->

    </UserControl.Resources>

    <Grid>

        <!-- Page content (Admin / Manager only)-->
        <Grid Margin="28"
              Visibility="{Binding HasAccess, Converter={StaticResource BoolToVisibility}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Manage Contracts"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Manage employee contracts and salary terms"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ New Contract"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}"
                        Width="170"/>
            </Grid>

            <!-- Summary stat cards -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Contracts -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Total Contracts" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding TotalContractsCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIconBadgeStyle}"
                                Background="{DynamicResource PrimaryBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Active -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Active" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ActiveContractsCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIconBadgeStyle}"
                                Background="{DynamicResource SuccessBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Expired -->
                <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Expired" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ExpiredContractsCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIconBadgeStyle}"
                                Background="{DynamicResource WarningBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource WarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Terminated -->
                <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Terminated" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding TerminatedContractsCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIconBadgeStyle}"
                                Background="{DynamicResource DangerBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource DangerBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Search + Sort -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="14"
                        Padding="14,0"
                        Height="48"
                        HorizontalAlignment="Left"
                        Width="340">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 Tag="Search by employee or contract type..."/>
                    </Grid>
                </Border>

                <!-- Sort -->
                <ComboBox Grid.Column="2"
                          Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort}"/>

            </Grid>

            <!-- Contract table -->
            <Border Grid.Row="6" Style="{StaticResource SurfaceCardStyle}" Padding="0">

                <DataGrid ItemsSource="{Binding ContractsView}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="56"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}"/>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="1.6*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTextColumn Header="Contract Type" Binding="{Binding ContractType}" Width="1.2*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTextColumn Header="Start Date" Binding="{Binding StartDateDisplay}" Width="1.1*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTextColumn Header="End Date" Binding="{Binding EndDateDisplay}" Width="1.1*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPillStyle}">
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Base Salary" Binding="{Binding BaseSalaryDisplay}" Width="1.1*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource RowIconButtonStyle}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource RowIconButtonStyle}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

        <!-- Access denied  -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="360"
                    Visibility="{Binding HasNoAccess, Converter={StaticResource BoolToVisibility}}">

            <Border Width="64" Height="64"
                    CornerRadius="32"
                    Background="{DynamicResource InputBackgroundBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                           Foreground="{DynamicResource DangerBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Access restricted"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Manage Contracts is only available to Admin and Manager accounts. Contact your administrator if you believe this is a mistake."
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

        </StackPanel>

        <!--Add / Edit overlay  -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="480"
                    MaxHeight="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="{Binding FormTitle}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="{Binding FormErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="Employee" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Employees}"
                              SelectedItem="{Binding FormSelectedEmployee}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource FormComboBoxStyle}"
                              Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Role" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding FormSelectedRole}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contract Type" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ContractTypeOptionsList}"
                                      SelectedItem="{Binding FormContractType}"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start Date" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding FormStartDate}"
                                        Style="{StaticResource FormDatePickerStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End Date (optional)" Style="{StaticResource FormLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding FormEndDate}"
                                        Style="{StaticResource FormDatePickerStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding StatusOptionsList}"
                                      SelectedItem="{Binding FormStatus}"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Base Salary" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding FormBaseSalary, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelCommand}"/>
                        <Button Grid.Column="2" Content="Save"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}"/>
                    </Grid>

                </StackPanel>

            </Border>
        </Grid>

        <!-- Delete confirmation overlay  -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Remove contract?"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20">
                        <Run Text="This will permanently delete the"/>
                        <Run Text="{Binding PendingDelete.ContractType, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="contract for"/>
                        <Run Text="{Binding PendingDelete.EmployeeName, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="."/>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDeleteCommand}"/>
                        <Button Grid.Column="2" Content="Delete"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="{DynamicResource DangerBrush}"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </Grid>

                </StackPanel>

            </Border>
        </Grid>

    </Grid>

</UserControl>
