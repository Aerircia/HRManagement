<UserControl x:Class="HRManagement.Views.Pages.SalaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="760"
             Background="Transparent">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="10,0,10,20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page header -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Salary"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBlock Text="View your monthly salary details and attendance summary."
                                   Margin="0,6,0,0"
                                   FontSize="14"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>

                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="18,10"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Salary period:"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding SalaryPeriod}"
                                       Margin="8,0,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- Period filter -->

                <Border Grid.Row="1"
                        Margin="0,0,0,20"
                        Padding="22"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Month"
                                   Margin="0,0,10,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>

                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Months}"
                                  SelectedItem="{Binding SelectedMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Column="3"
                                   Text="Year"
                                   Margin="0,0,10,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>

                        <ComboBox Grid.Column="4"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemsSource="{Binding Years}"
                                  SelectedItem="{Binding SelectedYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="6"
                                Content="View salary"
                                MinWidth="135"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding LoadSalaryCommand}"/>

                    </Grid>

                </Border>

                <!-- Status message -->

                <Border Grid.Row="2"
                        Margin="0,0,0,20"
                        Padding="16,12"
                        Background="{DynamicResource WarningBadgeBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,1,1,1"
                        CornerRadius="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="13"
                                Background="{DynamicResource WarningBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="!" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource WhiteBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>

                </Border>

                <!-- Employee information -->

                <Border Grid.Row="3"
                        Margin="0,0,0,20"
                        Padding="24"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Employee information"
                                   Margin="0,0,0,18"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <Border Grid.Row="1"
                                Background="{DynamicResource DividerBrush}"/>

                        <Grid Grid.Row="2"
                              Margin="0,20,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Employee ID -->

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,20,0">

                                <TextBlock Text="Employee ID"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <TextBlock Text="{Binding Salary.EmployeeId}"
                                           Margin="0,7,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                            </StackPanel>

                            <!-- Full name -->

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,20,0">

                                <TextBlock Text="Full name"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <TextBlock Text="{Binding Salary.FullName,
                                                          TargetNullValue=Not available}"
                                           Margin="0,7,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                            </StackPanel>

                            <!-- Department -->

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,20,0">

                                <TextBlock Text="Department"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <TextBlock Text="{Binding Salary.DepartmentName,
                                                          TargetNullValue=Not available}"
                                           Margin="0,7,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                            </StackPanel>

                            <!-- Role -->

                            <StackPanel Grid.Column="3">

                                <TextBlock Text="Role"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <TextBlock Text="{Binding Salary.RoleName,
                                                          TargetNullValue=Not available}"
                                           Margin="0,7,0,0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>

                <!-- Salary content -->

                <Grid Grid.Row="4">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Summary cards -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Base salary -->

                        <Border Grid.Column="0"
                                Padding="20"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">

                            <Grid>
                                <Border Height="4" CornerRadius="14,14,0,0" VerticalAlignment="Top"
                                        Margin="-20,-20,-20,0"
                                        Background="{DynamicResource CardAccentBlueBrush}"/>

                                <StackPanel Margin="0,4,0,0">

                                    <TextBlock Text="Base salary"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding Salary.BaseSalary,
                                                              StringFormat='{}{0:$#,##0.00}'}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                </StackPanel>
                            </Grid>

                        </Border>

                        <!-- Working days -->

                        <Border Grid.Column="2"
                                Padding="20"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">

                            <Grid>
                                <Border Height="4" CornerRadius="14,14,0,0" VerticalAlignment="Top"
                                        Margin="-20,-20,-20,0"
                                        Background="{DynamicResource CardAccentGreenBrush}"/>

                                <StackPanel Margin="0,4,0,0">

                                    <TextBlock Text="Working days"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding Salary.WorkingDays,
                                                              StringFormat={}{0} days}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"/>

                                </StackPanel>
                            </Grid>

                        </Border>

                        <!-- Reward -->

                        <Border Grid.Column="4"
                                Padding="20"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">

                            <Grid>
                                <Border Height="4" CornerRadius="14,14,0,0" VerticalAlignment="Top"
                                        Margin="-20,-20,-20,0"
                                        Background="{DynamicResource CardAccentGreenBrush}"/>

                                <StackPanel Margin="0,4,0,0">

                                    <TextBlock Text="Reward"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding Salary.Reward,
                                                              StringFormat='{}{0:+$#,##0.00}'}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"/>

                                </StackPanel>
                            </Grid>

                        </Border>

                        <!-- Penalty -->

                        <Border Grid.Column="6"
                                Padding="20"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">

                            <Grid>
                                <Border Height="4" CornerRadius="14,14,0,0" VerticalAlignment="Top"
                                        Margin="-20,-20,-20,0"
                                        Background="{DynamicResource CardAccentRedBrush}"/>

                                <StackPanel Margin="0,4,0,0">

                                    <TextBlock Text="Penalty"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding Salary.Penalty,
                                                              StringFormat='{}{0:-$#,##0.00}'}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"/>

                                </StackPanel>
                            </Grid>

                        </Border>

                    </Grid>

                    <!-- Detailed salary breakdown -->

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="24"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Salary breakdown"
                                           Margin="0,0,0,18"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource DividerBrush}"/>

                                <!-- Role salary -->

                                <Grid Grid.Row="2"
                                      Margin="0,18,0,0">

                                    <TextBlock Text="Base salary × Pay rate"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Text="{Binding RoleSalary,
                                                              StringFormat='{}{0:$#,##0.00}'}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                </Grid>

                                <!-- Pay rate -->

                                <Grid Grid.Row="3"
                                      Margin="0,14,0,0">

                                    <TextBlock Text="Role pay rate"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Text="{Binding Salary.PayRate,
                                                              StringFormat='{}{0:N2}x'}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                </Grid>

                                <!-- Daily salary -->

                                <Grid Grid.Row="4"
                                      Margin="0,14,0,0">

                                    <TextBlock Text="Daily salary"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Text="{Binding DailySalary,
                                                              StringFormat='{}{0:$#,##0.00}'}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                </Grid>

                                <!-- Attendance salary -->

                                <Grid Grid.Row="5"
                                      Margin="0,14,0,0">

                                    <TextBlock Text="Attendance salary"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Text="{Binding AttendanceSalary,
                                                              StringFormat='{}{0:$#,##0.00}'}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                </Grid>

                                <!-- Absent days -->

                                <Grid Grid.Row="6"
                                      Margin="0,14,0,18">

                                    <TextBlock Text="Absent days"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>

                                    <TextBlock Text="{Binding Salary.AbsentDays,
                                                              StringFormat={}{0} days}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DangerBrush}"/>

                                </Grid>

                                <Border Grid.Row="7"
                                        Background="{DynamicResource DividerBrush}"/>

                                <Grid Grid.Row="8"
                                      Margin="0,18,0,0">

                                    <TextBlock Text="Attendance salary"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                                    <TextBlock Text="{Binding AttendanceSalary,
                                                              StringFormat='{}{0:$#,##0.00}'}"
                                               HorizontalAlignment="Right"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}"/>

                                </Grid>

                            </Grid>

                        </Border>

                        <!-- Net salary -->

                        <Border Grid.Column="2"
                                Padding="26"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="16">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">

                                    <TextBlock Text="NET SALARY"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WhiteBrush}"
                                               Opacity="0.8"/>

                                    <TextBlock Text="{Binding SalaryPeriod}"
                                               Margin="0,6,0,0"
                                               FontSize="15"
                                               Foreground="{DynamicResource WhiteBrush}"/>

                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Margin="0,35,0,35"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Salary.TotalSalary,
                                                              StringFormat='{}{0:$#,##0.00}'}"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource WhiteBrush}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="$"
                                               Margin="0,5,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WhiteBrush}"
                                               Opacity="0.8"/>

                                </StackPanel>

                                <StackPanel Grid.Row="2">

                                    <Border Height="1"
                                            Margin="0,0,0,16"
                                            Background="{DynamicResource WhiteBrush}"
                                            Opacity="0.25"/>

                                    <Grid>

                                        <TextBlock Text="Reward"
                                                   Foreground="{DynamicResource WhiteBrush}"
                                                   Opacity="0.8"/>

                                        <TextBlock Text="{Binding Salary.Reward,
                                                                  StringFormat='{}{0:+$#,##0.00}'}"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WhiteBrush}"/>

                                    </Grid>

                                    <Grid Margin="0,10,0,0">

                                        <TextBlock Text="Penalty"
                                                   Foreground="{DynamicResource WhiteBrush}"
                                                   Opacity="0.8"/>

                                        <TextBlock Text="{Binding Salary.Penalty,
                                                                  StringFormat='{}{0:-$#,##0.00}'}"
                                                   HorizontalAlignment="Right"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WhiteBrush}"/>

                                    </Grid>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>

                </Grid>

            </Grid>

        </ScrollViewer>

    </Grid>

</UserControl>