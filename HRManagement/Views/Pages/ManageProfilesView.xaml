<UserControl x:Class="HRManagement.Views.Pages.ManageProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utilities="clr-namespace:HRManagement.Utilities" xmlns:controls="clr-namespace:HRManagement.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1240" d:DesignHeight="820"
             Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>

        <!-- ============ Page content (Admin / Manager only) ============ -->
        <Grid Margin="28"
              Visibility="{Binding HasAccess, Converter={StaticResource BoolToVisibility}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Manage Profiles"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="View, add, and update employee records"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ New Employee"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}"
                        Width="170"/>
            </Grid>

            <!-- ============ Summary stat cards ============ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Employees -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Total Employees" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding TotalEmployeesCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIconBadgeStyle}"
                                Background="{DynamicResource PrimaryBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Active -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Active Employees" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ActiveEmployeesCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIconBadgeStyle}"
                                Background="{DynamicResource SuccessBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- On Leave -->
                <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="On Leave" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding OnLeaveEmployeesCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIconBadgeStyle}"
                                Background="{DynamicResource WarningBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource WarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Inactive -->
                <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Inactive Employees" FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding InactiveEmployeesCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIconBadgeStyle}"
                                Background="{DynamicResource DangerBadgeBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource DangerBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ Toolbar: Search + Department/Role filters + Sort ============ -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="14"
                        Padding="14,0"
                        Height="48"
                        HorizontalAlignment="Left"
                        Width="340">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 Tag="Search by name or email..."/>
                    </Grid>
                </Border>

                <!-- Department filter (Admin only - Manager is scoped to their own department) -->
                <ComboBox Grid.Column="2"
                          Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding DepartmentFilterOptions}"
                          SelectedItem="{Binding SelectedDepartmentFilter}"
                          DisplayMemberPath="Name"
                          Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Role filter (Admin only) -->
                <ComboBox Grid.Column="4"
                          Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding RoleFilterOptions}"
                          SelectedItem="{Binding SelectedRoleFilter}"
                          DisplayMemberPath="Name"
                          Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Sort -->
                <ComboBox Grid.Column="6"
                          Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort}"/>

            </Grid>

            <!-- Employee table -->
            <Border Grid.Row="6" Style="{StaticResource SurfaceCardStyle}" Padding="0">

                <DataGrid ItemsSource="{Binding EmployeesView}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="56"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}"/>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <!-- Employee name & Position (Role) -->
                        <DataGridTemplateColumn Header="Employee Name &amp; Position" Width="2.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="36" Height="36" CornerRadius="18"
                                                    Background="{DynamicResource PrimaryTintBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName, Converter={StaticResource InitialsConverter}}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding RoleName}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Account status pill: green "Account" when a login already
                                             exists, muted "No Account" when one still needs to be
                                             created for this employee. -->
                                        <Border Grid.Column="1"
                                                CornerRadius="10"
                                                Padding="9,4"
                                                Margin="10,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAccount}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBadgeBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="No Account"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAccount}" Value="True">
                                                                <Setter Property="Text" Value="Account"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="1.3*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <!-- Mail & Phone -->
                        <DataGridTemplateColumn Header="Mail &amp; Phone" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Email}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Phone}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Hire Date" Binding="{Binding HireDateDisplay}" Width="1.2*"
                                             ElementStyle="{StaticResource TableCellTextStyle}"/>

                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusPillStyle}">
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource RowIconButtonStyle}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource RowIconButtonStyle}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

        <!-- ============ Add / Edit overlay ============ -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource SurfaceCardStyle}"
                        Width="480"
                        MaxHeight="640"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="{Binding FormErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="Full Name" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                        <TextBlock Text="Email" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                        <TextBlock Text="Phone" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Department" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Departments}"
                                          SelectedItem="{Binding FormSelectedDepartment}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FormComboBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Role" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding RoleOptions}"
                                          SelectedItem="{Binding FormSelectedRole}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource FormComboBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Date of Birth" Style="{StaticResource FormLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding FormDateOfBirth}"
                                            Style="{StaticResource FormDatePickerStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hire Date" Style="{StaticResource FormLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding FormHireDate}"
                                            Style="{StaticResource FormDatePickerStyle}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Status" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding StatusOptionsList}"
                                  SelectedItem="{Binding FormStatus}"
                                  Style="{StaticResource FormComboBoxStyle}"
                                  Margin="0,0,0,20"/>
                        <!-- ============ Account access ============ -->
                        <Border Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,20">
                            <StackPanel>

                                <TextBlock Text="Login Account"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Margin="0,0,0,10"/>

                                <!-- Employee already has an account (edit mode) -->
                                <TextBlock Text="This employee already has a login account."
                                           FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding FormHasExistingAccount, Converter={StaticResource BoolToVisibility}}"/>

                                <!-- Checkbox + fields, shown when there's no existing account to protect -->
                                <StackPanel Visibility="{Binding CanCreateAccount, Converter={StaticResource BoolToVisibility}}">

                                    <CheckBox Content="Create a login account for this employee"
                                              IsChecked="{Binding FormCreateAccount}"
                                              Foreground="{StaticResource PrimaryTextBrush}"
                                              FontSize="12"
                                              Margin="0,0,0,12"/>

                                    <StackPanel Visibility="{Binding FormCreateAccount, Converter={StaticResource BoolToVisibility}}">

                                        <TextBlock Text="Username" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Text="{Binding FormAccountUsername, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                                        <TextBlock Text="Password" Style="{StaticResource FormLabelStyle}"/>

                                        <controls:BindablePasswordBox Password="{Binding FormAccountPassword}"
                                                  Margin="0,0,0,14"
                                                  Height="42"
                                                  Background="{StaticResource InputBackgroundBrush}"
                                                  Foreground="{StaticResource PrimaryTextBrush}"
                                                  BorderThickness="0"
                                                  Padding="12,0"
                                                  VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ============ Reset password (edit mode, existing account only) ============ -->
                        <Border Background="{StaticResource InputBackgroundBrush}"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,20"
                                Visibility="{Binding CanResetPassword, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>

                                <TextBlock Text="Reset Password"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Margin="0,0,0,10"/>

                                <CheckBox Content="Set a new password for this employee"
                                          IsChecked="{Binding FormResetPassword}"
                                          Foreground="{StaticResource PrimaryTextBrush}"
                                          FontSize="12"
                                          Margin="0,0,0,12"/>

                                <StackPanel Visibility="{Binding FormResetPassword, Converter={StaticResource BoolToVisibility}}">

                                    <TextBlock Text="New Password" Style="{StaticResource FormLabelStyle}"/>
                                    <controls:BindablePasswordBox Password="{Binding FormNewPassword}"
                                              Margin="0,0,0,14"
                                              Height="42"
                                              Background="{StaticResource InputBackgroundBrush}"
                                              Foreground="{StaticResource PrimaryTextBrush}"
                                              BorderThickness="0"
                                              Padding="12,0"
                                              VerticalContentAlignment="Center"/>

                                    <TextBlock Text="Confirm New Password" Style="{StaticResource FormLabelStyle}"/>
                                    <controls:BindablePasswordBox Password="{Binding FormConfirmNewPassword}"
                                              Margin="0,0,0,4"
                                              Height="42"
                                              Background="{StaticResource InputBackgroundBrush}"
                                              Foreground="{StaticResource PrimaryTextBrush}"
                                              BorderThickness="0"
                                              Padding="12,0"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CancelCommand}"/>
                            <Button Grid.Column="2" Content="Save"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveCommand}"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- ============ Delete confirmation overlay ============ -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Remove employee?"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20">
                        <Run Text="This will permanently delete"/>
                        <Run Text="{Binding PendingDelete.FullName, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="from the system."/>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDeleteCommand}"/>
                        <Button Grid.Column="2" Content="Delete"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="{DynamicResource DangerBrush}"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </Grid>

                </StackPanel>

            </Border>
        </Grid>

        <!-- ============ Access denied (non Admin/Manager) ============ -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="360"
                    Visibility="{Binding HasNoAccess, Converter={StaticResource BoolToVisibility}}">

            <Border Width="64" Height="64"
                    CornerRadius="32"
                    Background="{DynamicResource InputBackgroundBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                           Foreground="{DynamicResource DangerBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Access restricted"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Manage Profiles is only available to Admin and Manager accounts. Contact your administrator if you believe this is a mistake."
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

        </StackPanel>

    </Grid>

</UserControl>
