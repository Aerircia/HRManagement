<UserControl x:Class="HRManagement.Views.Pages.ManageAttendancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HRManagement.Views.Pages"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Left fixed width for employee list (slightly smaller) -->
            <ColumnDefinition Width="300" />
            <!-- Right takes remaining space (larger) -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Manage Attendances" FontSize="30" FontWeight="Bold" Margin="0,0,0,12" Foreground="{StaticResource PrimaryTextBrush}" Grid.ColumnSpan="2" />

        <!-- Left: Filters + Employee list -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="6,42,10,0" BorderBrush="#E6EEF8" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Employee ID:" VerticalAlignment="Center" Width="90" />
                        <TextBox Width="140" Text="{Binding EmployeeIdFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Department:" VerticalAlignment="Center" Width="90" />
                        <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" DisplayMemberPath="DepartmentName" Width="167" Height="24" SelectionChanged="ComboBox_SelectionChanged" />
                    </StackPanel>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Employees}" AutoGenerateColumns="False" CanUserAddRows="False" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}" IsReadOnly="True" Height="720" VerticalAlignment="Top" RowHeight="32" GridLinesVisibility="None" HeadersVisibility="Column" RowBackground="#FFFFFF" AlternatingRowBackground="#F7F9FB" BorderThickness="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="#333" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding EmployeeId}" Width="60" ElementStyle="{StaticResource {x:Type TextBlock}}" />
                        <DataGridTextColumn Header="Name" Binding="{Binding EmployeeName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Right: Calendar + Summary (visible only after selecting an employee) -->
        <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="12" Margin="12,8,0,0" Visibility="{Binding IsEmployeeSelected, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Summary on top -->
                    <RowDefinition Height="*" />    <!-- Calendar below -->
                </Grid.RowDefinitions>

                <!-- Summary row: horizontal layout with four items -->
                <Border Grid.Row="0" Background="#FAFBFC" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <UniformGrid Columns="4">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Days worked" FontSize="12" Foreground="#666" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ChildAttendanceViewModel.TotalDaysWorked}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="On-time" FontSize="12" Foreground="#666" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ChildAttendanceViewModel.TotalOnTime}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Late" FontSize="12" Foreground="#666" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ChildAttendanceViewModel.TotalLate}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Absent" FontSize="12" Foreground="#666" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ChildAttendanceViewModel.TotalAbsent}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Calendar row: larger area to ensure full visibility -->
                <Border Grid.Row="1" Background="Transparent" Padding="0">
                    <DockPanel DataContext="{Binding ChildAttendanceViewModel}">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Button Content="&lt;" Width="32" Command="{Binding PrevMonthCommand}" />
                            <TextBlock Text="{Binding CurrentMonth, StringFormat='MMMM yyyy'}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" />
                            <Button Content=">" Width="32" Command="{Binding NextMonthCommand}" />
                        </StackPanel>

                        <UniformGrid Columns="7" DockPanel.Dock="Top">
                            <TextBlock Text="Mon" HorizontalAlignment="Center" FontWeight="Bold" />
                            <TextBlock Text="Tue" HorizontalAlignment="Center" FontWeight="Bold" />
                            <TextBlock Text="Wed" HorizontalAlignment="Center" FontWeight="Bold" />
                            <TextBlock Text="Thu" HorizontalAlignment="Center" FontWeight="Bold" />
                            <TextBlock Text="Fri" HorizontalAlignment="Center" FontWeight="Bold" />
                            <TextBlock Text="Sat" HorizontalAlignment="Center" FontWeight="Bold" />
                            <TextBlock Text="Sun" HorizontalAlignment="Center" FontWeight="Bold" />
                        </UniformGrid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#EEE" BorderThickness="1" Margin="6" Padding="10" Background="{Binding Background}" MinHeight="120" MinWidth="140" CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Date, StringFormat='dd/MM'}" FontWeight="Bold" Foreground="#111" FontSize="13" />
                                                <StackPanel x:Name="TimesPanel" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding CheckIn, StringFormat='Check-in: {0:HH:mm}'}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding CheckOut, StringFormat='Check-out: {0:HH:mm}'}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DisplayStatus}" FontSize="12" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ShouldShowTimes}" Value="False">
                                                <Setter TargetName="TimesPanel" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBeforeHireDate}" Value="True">
                                                <Setter TargetName="TimesPanel" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>