<UserControl x:Class="HRManagement.Views.Pages.ContractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utilities="clr-namespace:HRManagement.Utilities"
             mc:Ignorable="d"
             d:DesignWidth="1240" d:DesignHeight="1200"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <utilities:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="DocumentPaperStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NeutralBgBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="64,48"/>
            <Setter Property="Margin" Value="0,20,0,40"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.15" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DocumentTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <Style x:Key="DocumentSectionTitleStyle" TargetType="Run">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DynamicDataStyle" TargetType="Run">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ============ Page content ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="28" MaxWidth="850" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Contract Document"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Your official signed agreement"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Contract Document Paper -->
                <Border Grid.Row="1" Style="{StaticResource DocumentPaperStyle}"
                        Visibility="{Binding HasContract, Converter={StaticResource BoolToVisibility}}">

                    <StackPanel>
                        <!-- Document Title -->
                        <TextBlock Text="EMPLOYMENT CONTRACT"
                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,32"/>

                        <!-- Introduction -->
                        <TextBlock Style="{StaticResource DocumentTextStyle}">
                            <Run Text="This employment agreement (&quot;Agreement&quot;) is made and effective as of "/>
                            <Run Text="{Binding StartDateDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                            <Run Text=" by and between:"/>
                        </TextBlock>

                        <!-- Parties -->
                        <Grid Margin="32,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource DocumentTextStyle}" Margin="0">
                                <Run Text="Employer: " FontWeight="Bold"/>
                                <Run Text="{Binding EmployerNameDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                                <Run Text=", (&quot;Employer&quot;) with a mailing address of"/>
                                <Run Text="{Binding EmployerAddressDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                                <Run Text="."/>
                            </TextBlock>

                            <TextBlock Grid.Row="2" Style="{StaticResource DocumentTextStyle}" Margin="0">
                                <Run Text="Employee: " FontWeight="Bold"/>
                                <Run Text="{Binding EmployeeNameDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                                <Run Text=", (&quot;Employee&quot;) with a mailing address of"/>
                                <Run Text="{Binding EmployeeAddressDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                                <Run Text="."/>
                            </TextBlock>
                        </Grid>

                        <TextBlock Style="{StaticResource DocumentTextStyle}">
                            WHEREAS the Employer intends to hire the Employee for the Position and the Employee desires to provide their services to the Employer for payment.
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocumentTextStyle}">
                            IN CONSIDERATION of promises and other good and valuable consideration, the parties agree to the following:
                        </TextBlock>

                        <!-- Section I -->
                        <TextBlock Style="{StaticResource DocumentTextStyle}">
                            <Run Text="I. EMPLOYEE DUTIES." Style="{StaticResource DocumentSectionTitleStyle}"/>
                            <Run Text=" The Employee agrees that they will act in accordance with this Agreement and with the best interests of the Employer in mind, which may or may not require them to present the best of their skills, experience, and talents, to perform all the duties required of the Position. In carrying out the duties and responsibilities of their Position within the "/>
                            <Run Text="{Binding DepartmentDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                            <Run Text=" department, the Employee agrees to adhere to any and all policies, procedures, rules, regulations, as administered by the Employer. In addition, the Employee agrees to abide by all local, county, State, and Federal laws while employed by the Employer."/>
                        </TextBlock>

                        <!-- Section II -->
                        <TextBlock Style="{StaticResource DocumentTextStyle}">
                            <Run Text="II. RESPONSIBILITIES." Style="{StaticResource DocumentSectionTitleStyle}"/>
                            <Run Text=" The Employee shall be given the job title of "/>
                            <Run Text="{Binding RoleDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                            <Run Text=" (&quot;Position&quot;) which shall involve standard duties associated with this role."/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocumentTextStyle}">
                            <Run Text="The Employer may also assign duties to the Employee from time to time by the Employer. The Employee shall be expected to work "/>
                            <Run Text="{Binding ContractType, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                            <Run Text="."/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocumentTextStyle}">
                            <Run Text="Compensation: The Employee will receive a base salary of "/>
                            <Run Text="{Binding BaseSalaryDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                            <Run Text="."/>
                        </TextBlock>

                        <!-- Section III -->
                        <TextBlock Style="{StaticResource DocumentTextStyle}">
                            <Run Text="III. EMPLOYMENT PERIOD." Style="{StaticResource DocumentSectionTitleStyle}"/>
                            <Run Text=" The Employer agrees to hire the Employee currently listed under "/>
                            <Run Text="{Binding Status, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                            <Run Text=" status. If applicable, this contract will expire on: "/>
                            <Run Text="{Binding EndDateDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                            <Run Text="."/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource DocumentTextStyle}" Margin="32,8,0,0">
                            <Run Text="a.) Employee's Termination." FontWeight="Bold"/>
                            <Run Text=" The Employee shall have the right to terminate this Agreement by providing at least "/>
                            <Run Text="{Binding NoticePeriodDaysDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                            <Run Text=" days' notice."/>
                            <LineBreak/><LineBreak/>
                            <Run Text="b.) Employer's Termination." FontWeight="Bold"/>
                            <Run Text=" The Employer shall have the right to terminate this Agreement by providing at least "/>
                            <Run Text="{Binding NoticePeriodDaysDisplay, Mode=OneWay}" Style="{StaticResource DynamicDataStyle}"/>
                            <Run Text=" days' notice."/>
                        </TextBlock>

                        <Grid Margin="0,64,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}">
                                <Run Text="Employee's Initials: "/>
                                <Run Text="____________"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right">
                                <Run Text="Employer's Initials: "/>
                                <Run Text="____________"/>
                            </TextBlock>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- No contract on file -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Margin="0,40,0,0"
                            Visibility="{Binding HasNoContract, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="No contract on file yet."
                               FontSize="15"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>