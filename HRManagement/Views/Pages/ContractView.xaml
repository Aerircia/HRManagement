<UserControl x:Class="HRManagement.Views.Pages.ContractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utilities="clr-namespace:HRManagement.Utilities"
             mc:Ignorable="d"
             d:DesignWidth="1240" d:DesignHeight="820"
             Background="{StaticResource WindowBackgroundBrush}">

    <UserControl.Resources>

        <utilities:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1A2B3674" BlurRadius="18" ShadowDepth="4" Opacity="0.12" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <!-- ============ Page content (Employee / Manager only) ============ -->
        <Grid Margin="28"
              MaxWidth="760"
              HorizontalAlignment="Center"
              Visibility="{Binding HasAccess, Converter={StaticResource BoolToVisibility}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Contract"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Your work contract on file"
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Contract card -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasContract, Converter={StaticResource BoolToVisibility}}"
                    VerticalAlignment="Top" Height="609" Margin="-310,20,-308,0" Grid.RowSpan="2">

                <StackPanel>

                    <!-- Top row: employee name + status -->
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding EmployeeNameDisplay}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding ContractIdDisplay}"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,22"/>

                    <!-- Field grid: 2 columns -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Contract Type" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="{Binding ContractType}" Style="{StaticResource FieldValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Role" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="{Binding RoleDisplay}" Style="{StaticResource FieldValueStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Department" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="{Binding DepartmentDisplay}" Style="{StaticResource FieldValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Base Salary" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="{Binding BaseSalaryDisplay}" Style="{StaticResource FieldValueStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start Date" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="{Binding StartDateDisplay}" Style="{StaticResource FieldValueStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="End Date" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="{Binding EndDateDisplay}" Style="{StaticResource FieldValueStyle}"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>

            </Border>

            <!-- No contract on file -->
            <StackPanel Grid.Row="2"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,0"
                        Visibility="{Binding HasNoContract, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="No contract on file yet."
                           FontSize="15"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"/>

            </StackPanel>

        </Grid>

        <!-- ============ Access denied (Admin) ============ -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="360"
                    Visibility="{Binding HasNoAccess, Converter={StaticResource BoolToVisibility}}">

            <Border Width="64" Height="64"
                    CornerRadius="32"
                    Background="{StaticResource InputBackgroundBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                           Foreground="{StaticResource DangerBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Not applicable"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="This page shows your own work contract and is only available to Employee and Manager accounts. Use Manage Contracts to view or edit contracts."
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>

        </StackPanel>

    </Grid>

</UserControl>
