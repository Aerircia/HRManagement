<UserControl x:Class="HRManagement.Views.Pages.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HRManagement.Views.Pages"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HRManagement;component/Resources/AttendanceResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
            <TextBlock Text="Attendance" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
        </StackPanel>

        <!-- Left: Calendar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Month navigation -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource CalendarNavButtonStyle}"
                            Command="{Binding PrevMonthCommand}" />
                    <TextBlock Text="{Binding CurrentMonth, StringFormat='MMMM yyyy'}"
                               FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center" Margin="16,0" />
                    <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource CalendarNavButtonStyle}"
                            Command="{Binding NextMonthCommand}" />
                </StackPanel>

                <!-- Days of week header -->
                <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
                    <TextBlock Text="Mon" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Tue" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Wed" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Thu" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Fri" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Sat" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Sun" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" />
                </UniformGrid>

                <!-- Calendar grid: every cell gets the SAME fixed height regardless of how
                     many week-rows the visible month needs, so the card size never jumps
                     between a 4-row and a 6-row month. The ScrollViewer only kicks in if
                     a 6-row month can't fit the available vertical space. -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Fixed Height keeps every cell identical no matter how many
                                     lines of content (times, lateness, status) it has, and no
                                     matter whether the month renders 5 or 6 week-rows. -->
                                <Border Height="96"
                                        Margin="4"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <!-- Leading/trailing days from adjacent months: subdued placeholder -->
                                                <DataTrigger Binding="{Binding IsFillerCell}" Value="True">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid Margin="8,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Date number -->
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Date, StringFormat='dd/MM'}"
                                                   FontWeight="Bold" FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasStatus}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Weekend">
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Before Hire Date">
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Check-in / Check-out -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                                    Visibility="{Binding ShouldShowTimes, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding CheckIn, StringFormat='In: {0:HH:mm}'}" FontSize="11" Foreground="White" Opacity="0.95" />
                                            <TextBlock Text="{Binding CheckOut, StringFormat='Out: {0:HH:mm}'}" FontSize="11" Foreground="White" Opacity="0.95" />
                                        </StackPanel>

                                        <!-- Status label -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding DisplayStatus}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Weekend">
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Before Hire Date">
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasStatus}" Value="False">
                                                            <Setter Property="Foreground" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right: Summary and actions -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" Padding="16" Margin="12,0,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Summary" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,10" />

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Days worked:" Width="120" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding TotalDaysWorked}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="On-time days:" Width="120" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding TotalOnTime}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Late days:" Width="120" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding TotalLate}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Absent days:" Width="120" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding TotalAbsent}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Check In"
                            Style="{StaticResource CheckInButtonStyle}"
                            Command="{Binding CheckInCommand}" Width="106" Margin="0,0,10,0" />
                    <Button Content="Check Out"
                            Style="{StaticResource CheckOutButtonStyle}"
                            Command="{Binding CheckOutCommand}" Width="106" />
                </StackPanel>

                <TextBlock Text="Legend" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,18,0,6" />
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{StaticResource SuccessBgBrush}" Stroke="{StaticResource BorderBrush}" />
                        <TextBlock Text=" On time / Present" Margin="8,0" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{StaticResource WarningBgBrush}" Stroke="{StaticResource BorderBrush}" />
                        <TextBlock Text=" Late" Margin="8,0" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{StaticResource DangerBgBrush}" Stroke="{StaticResource BorderBrush}" />
                        <TextBlock Text=" Absent" Margin="8,0" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{StaticResource WeekendBgBrush}" Stroke="{StaticResource BorderBrush}" />
                        <TextBlock Text=" Weekend (Sat/Sun)" Margin="8,0" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{StaticResource OtBgBrush}" Stroke="{StaticResource BorderBrush}" />
                        <TextBlock Text=" OT" Margin="8,0" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{StaticResource NeutralBgBrush}" Stroke="{StaticResource BorderBrush}" />
                        <TextBlock Text=" Before hire date" Margin="8,0" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
