<UserControl x:Class="HRManagement.Views.Pages.ManageKpiSetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:local="clr-namespace:HRManagement.Models"
             mc:Ignorable="d"
             d:DesignWidth="1400" d:DesignHeight="900"
             Background="{DynamicResource CardBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Header Section ============ -->
        <Border Grid.Row="0" Padding="28,24,28,20" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title and Description -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Quản lý Bộ KPI" FontSize="32" FontWeight="Bold" 
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Cấu hình và theo dõi các chỉ tiêu KPI theo kỳ hạn - Configure and track KPI items according to the period" 
                               FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.8"/>
                </StackPanel>

                <!-- Top Right Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" CornerRadius="6" Margin="0,0,8,0">
                        <Button x:Name="BtnPeriod" Padding="10,8,10,8"
                               Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12" Cursor="Hand" BorderThickness="0"
                               Click="BtnPeriod_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Calendar" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Q2/2026" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" CornerRadius="6" Margin="0,0,8,0">
                        <Button x:Name="BtnDepartment" Padding="10,8,10,8"
                               Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12" Cursor="Hand" BorderThickness="0"
                               Click="BtnDepartment_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Users" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Tất cả phòng ban" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" CornerRadius="6" Margin="0,0,12,0">
                        <Button x:Name="BtnRefresh" Padding="10,8,10,8"
                               Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12" Cursor="Hand" BorderThickness="0"
                               Click="BtnRefresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="RotateRight" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Làm mới" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6">
                        <Button Command="{Binding AddCommand}" Padding="12,8,12,8"
                               Background="Transparent" Foreground="White"
                               FontSize="12" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Plus" Width="14" Height="14" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="Thêm bộ KPI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Statistics Cards Section ============ -->
        <Border Grid.Row="1" Padding="28,16,28,16" Background="{DynamicResource PrimaryTintBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Total KPI Sets -->
                <Border Grid.Column="0" Margin="0,0,12,0" Background="White" Padding="12,12,12,12" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource PrimaryTintBrush}" CornerRadius="6" Width="40" Height="40" Padding="8">
                            <fa:IconImage Icon="ListCheck" Width="24" Height="24" Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="5" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Bộ KPI" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: In Progress -->
                <Border Grid.Column="1" Margin="0,0,12,0" Background="White" Padding="12,12,12,12" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FFFAF0" CornerRadius="6" Width="40" Height="40" Padding="8">
                            <fa:IconImage Icon="Hourglass" Width="24" Height="24" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="24" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Tổng chỉ tiêu" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: Completed -->
                <Border Grid.Column="2" Margin="0,0,12,0" Background="White" Padding="12,12,12,12" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F0FDF4" CornerRadius="6" Width="40" Height="40" Padding="8">
                            <fa:IconImage Icon="CheckCircle" Width="24" Height="24" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="24" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Chỉ tiêu được dùng" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 4: Issues -->
                <Border Grid.Column="3" Background="White" Padding="12,12,12,12" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FEF2F2" CornerRadius="6" Width="40" Height="40" Padding="8">
                            <fa:IconImage Icon="ExclamationTriangle" Width="24" Height="24" Foreground="{DynamicResource DangerBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Lỗi" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Search and Filter Section ============ -->
        <Border Grid.Row="2" Padding="28,16,28,16" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="0,1,0,1" 
                BorderBrush="{DynamicResource DividerBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Department Filter -->
                <Border BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" CornerRadius="6" Margin="0,0,8,0">
                    <ComboBox  Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}" Padding="12,8,12,8" FontSize="12">
                        <ComboBoxItem>Tất cả phòng ban</ComboBoxItem>
                        <ComboBoxItem>Sales</ComboBoxItem>
                        <ComboBoxItem>Marketing</ComboBoxItem>
                    </ComboBox>
                </Border>

                <!-- Spacer -->
                <Border Grid.Column="1"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" CornerRadius="6" Margin="0,0,8,0">
                        <Button x:Name="BtnAddByCriteria" Padding="10,8,10,8"
                               Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12" Cursor="Hand" BorderThickness="0"
                               Click="BtnAddByCriteria_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Plus" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Thêm theo tiêu chí" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" CornerRadius="6" Margin="0,0,8,0">
                        <Button x:Name="BtnCopyPeriod" Padding="10,8,10,8"
                               Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12" Cursor="Hand" BorderThickness="0"
                               Click="BtnCopyPeriod_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Copy" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Copy kỳ trước" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" CornerRadius="6">
                        <Button x:Name="BtnExport" Padding="10,8,10,8"
                               Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12" Cursor="Hand" BorderThickness="0"
                               Click="BtnExport_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="Download" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Xuất báo cáo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ KPI Sets List ============ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DepartmentGroups}" Margin="28,20,28,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,24" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" 
                               BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
                            <StackPanel>
                                <!-- KPI Set Header (Group Header) -->
                                <Border Padding="20,16,20,16" Background="{DynamicResource PrimaryBrush}" CornerRadius="8,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <fa:IconImage Icon="FolderOpen" Width="18" Height="18" Foreground="White" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding Key}" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,12,0"/>
                                            <Border Padding="6,3,6,3" Background="White" CornerRadius="12" Opacity="0.25">
                                                <TextBlock Text="{Binding Count, StringFormat='{}{0} sets'}" 
                                                          FontSize="11" Foreground="White" FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button x:Name="BtnGroupAdd" Padding="6" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                                   Click="BtnGroupAdd_Click" Tag="{Binding}">
                                                <fa:IconImage Icon="Plus" Width="16" Height="16" Foreground="White"/>
                                            </Button>
                                            <Button x:Name="BtnGroupMore" Padding="6" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                   Click="BtnGroupMore_Click" Tag="{Binding}">
                                                <fa:IconImage Icon="Ellipsis" Width="16" Height="16" Foreground="White"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- KPI Sets in this group -->
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="local:KpiSetRow">
                                            <StackPanel>
                                                <!-- KPI Set Row -->
                                                <Border Padding="20,16,20,16" BorderThickness="0,0,0,1" 
                                                       BorderBrush="{DynamicResource DividerBrush}" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- KPI Set Info -->
                                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                                            <TextBlock Text="{Binding KpiSetName}" FontSize="14" FontWeight="SemiBold" 
                                                                      Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" 
                                                                      Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                <Border Padding="4,2,4,2" Background="{DynamicResource PrimaryTintBrush}" CornerRadius="3" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding DetailCount, StringFormat='{}Có {0} chỉ tiêu'}" 
                                                                              FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="11" 
                                                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Action Buttons -->
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <Button x:Name="BtnRowEdit" Padding="8" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                                                   Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}">
                                                                <fa:IconImage Icon="Edit" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}"/>
                                                            </Button>
                                                            <Button x:Name="BtnRowCopy" Padding="8" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                                                   Click="BtnRowCopy_Click" Tag="{Binding}">
                                                                <fa:IconImage Icon="Copy" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}"/>
                                                            </Button>
                                                            <Button x:Name="BtnRowDelete" Padding="8" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}">
                                                                <fa:IconImage Icon="Trash" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- KPI Details Table Header -->
                                                <Border Padding="20,12,20,12" Background="{DynamicResource InputBackgroundBrush}" 
                                                       BorderThickness="0,1,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="STT" FontWeight="SemiBold" FontSize="11"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"/>
                                                        <TextBlock Grid.Column="1" Text="Chỉ tiêu" FontWeight="SemiBold" FontSize="11"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"/>
                                                        <TextBlock Grid.Column="2" Text="Kế hoạch" FontWeight="SemiBold" FontSize="11"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"/>
                                                        <TextBlock Grid.Column="3" Text="Cần tính" FontWeight="SemiBold" FontSize="11"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"/>
                                                        <TextBlock Grid.Column="4" Text="Tỷ trọng" FontWeight="SemiBold" FontSize="11"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"/>
                                                        <TextBlock Grid.Column="5" Text="KPI tối đa" FontWeight="SemiBold" FontSize="11"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"/>
                                                        <TextBlock Grid.Column="6" Text="Cách chấm" FontWeight="SemiBold" FontSize="11"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"/>
                                                        <TextBlock Grid.Column="7" Text="Cách tính" FontWeight="SemiBold" FontSize="11"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"/>
                                                        <TextBlock Grid.Column="8" Text="Trạng thái" FontWeight="SemiBold" FontSize="11"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"
                                                                  HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="9" Text="Thao tác" FontWeight="SemiBold" FontSize="11"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.7"
                                                                  HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Table Rows -->
                                                <ItemsControl ItemsSource="{Binding Details}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="local:KpiSetDetailRow">
                                                            <Border Padding="20,14,20,14" BorderThickness="0,0,0,1" 
                                                                   BorderBrush="{DynamicResource DividerBrush}" Background="Transparent">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="40"/>
                                                                        <ColumnDefinition Width="200"/>
                                                                        <ColumnDefinition Width="100"/>
                                                                        <ColumnDefinition Width="100"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="100"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Row Number -->
                                                                    <TextBlock Grid.Column="0" Text="1" FontSize="12"
                                                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                                                              VerticalAlignment="Center"/>

                                                                    <!-- KPI Name -->
                                                                    <TextBlock Grid.Column="1" Text="{Binding KpiName}" FontSize="12"
                                                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                                                              VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                                    <!-- Target Value -->
                                                                    <TextBlock Grid.Column="2" Text="{Binding TargetValue}" FontSize="12"
                                                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                                                              VerticalAlignment="Center"/>

                                                                    <!-- Plan Value -->
                                                                    <TextBlock Grid.Column="3" Text="{Binding TargetValue}" FontSize="12"
                                                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                                                              VerticalAlignment="Center"/>

                                                                    <!-- Weight -->
                                                                    <TextBlock Grid.Column="4" Text="{Binding Weight, StringFormat='0%'}" FontSize="12"
                                                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                                                              VerticalAlignment="Center"/>

                                                                    <!-- Major KPI (indicator) -->
                                                                    <Border Grid.Column="5" Padding="6,3,6,3" Background="{DynamicResource WarningBrush}" CornerRadius="4"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Opacity="0.2">
                                                                        <TextBlock Text="Cần chấm" FontSize="10" Foreground="{DynamicResource WarningBrush}" FontWeight="Medium"/>
                                                                    </Border>

                                                                    <!-- Scoring Method -->
                                                                    <TextBlock Grid.Column="6" Text="Nhập trực tiếp" FontSize="12"
                                                                              Foreground="{DynamicResource PrimaryBrush}" FontWeight="Medium"
                                                                              VerticalAlignment="Center"/>

                                                                    <!-- Calculation Formula -->
                                                                    <TextBlock Grid.Column="7" Text="{Binding MeasurementUnit}" FontSize="12"
                                                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                                                              VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                                    <!-- Status Badge -->
                                                                    <Border Grid.Column="8" Padding="6,3,6,3" Background="{DynamicResource SuccessBrush}" CornerRadius="4"
                                                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                           Opacity="0.15">
                                                                        <TextBlock Text="Đang dùng" FontSize="10" Foreground="{DynamicResource SuccessBrush}" FontWeight="Medium"/>
                                                                    </Border>

                                                                    <!-- Actions -->
                                                                    <StackPanel Grid.Column="9" Orientation="Horizontal" VerticalAlignment="Center" 
                                                                               HorizontalAlignment="Center">
                                                                        <Button x:Name="BtnDetailEdit" Padding="4" Background="Transparent" BorderThickness="0" 
                                                                               Cursor="Hand" Margin="0,0,8,0" Click="BtnDetailEdit_Click" Tag="{Binding}">
                                                                            <fa:IconImage Icon="Edit" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}"/>
                                                                        </Button>
                                                                        <Button x:Name="BtnDetailCopy" Padding="4" Background="Transparent" BorderThickness="0" 
                                                                               Cursor="Hand" Margin="0,0,8,0" Click="BtnDetailCopy_Click" Tag="{Binding}">
                                                                            <fa:IconImage Icon="Copy" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}"/>
                                                                        </Button>
                                                                        <Button x:Name="BtnDetailDelete" Padding="4" Background="Transparent" BorderThickness="0" 
                                                                               Cursor="Hand" Click="BtnDetailDelete_Click" Tag="{Binding}">
                                                                            <fa:IconImage Icon="Trash" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
