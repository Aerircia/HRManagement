<UserControl x:Class="HRManagement.Views.Pages.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:HRManagement.Controls"
             xmlns:utilities="clr-namespace:HRManagement.Utilities"
             mc:Ignorable="d"
             d:DesignWidth="1300" d:DesignHeight="900"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>

        <utilities:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
            Redesigned per User_Profile_Page_UI_Improvement_Task.md: left
            profile card + right "At-a-glance Global Stats" row and detail
            cards (Personal Details / Job History / Compensation & Benefits).

            Reuses existing app-wide styles wherever possible:
              - StatCardStyle / StatIconBadgeStyle (Resources/ManageRequestsStyles.xaml)
              - SurfaceCardStyle / TableCellTextStyle (Resources/TableStyles.xaml)
              - PrimaryButtonStyle / SecondaryButtonStyle (Resources/ButtonStyles.xaml)
              - controls:DonutProgress (Controls/DonutProgress.xaml) for the
                performance ring, matching how the old dashboard tiles on this
                same page already used it.

            Only a handful of page-local styles remain below, for elements
            that don't already have an app-wide equivalent (profile card
            chrome, timeline connector, benefit pill).
        -->

        <Style x:Key="ProfileCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource CardShadowColor}" BlurRadius="18" ShadowDepth="4" Opacity="0.10" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailCardStyle" TargetType="Border" BasedOn="{StaticResource ProfileCardStyle}">
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="CardHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="CardSubtleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <Style x:Key="ProfileFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <Style x:Key="ProfileFieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <!-- Global-stat number tile: icon badge + label + big value, reusing
             StatIconBadgeStyle from ManageRequestsStyles.xaml for the badge
             chrome so it matches Manage Requests' stat cards exactly.
             Value bumped 16->22px (matches TableStyles.xaml's new
             StatCardValueStyle) so the number leads visually instead of
             reading at the same weight as its label. -->
        <Style x:Key="GlobalStatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="GlobalStatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <!-- Top-accent strip for the four global stat cards below - reuses
             the CardAccentXBrush tokens from Brushes.xaml/DarkBrushes.xaml
             so each card's strip matches its own icon badge color
             (PTO=blue, Retirement=green, Tenure=amber, Performance=red).

             Margin is negative and matches StatCardStyle's own
             Padding="18,16" exactly (18 left/right, 16 top) so the strip
             bleeds flush to the card's actual outer edge instead of
             floating inset within the card's padding. An inset strip
             visually reads as "a small colored card nested inside the
             white card" rather than an edge accent - this fixes that. -->
        <Style x:Key="GlobalStatAccentStripStyle" TargetType="Border">
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="16,16,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="-18,-16,-18,0"/>
        </Style>

        <!-- Job-history timeline dot -->
        <Style x:Key="TimelineDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <Style x:Key="TimelineDotCurrentStyle" TargetType="Ellipse" BasedOn="{StaticResource TimelineDotStyle}">
            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
        </Style>

        <!-- Benefit pill -->
        <Style x:Key="BenefitPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryTintBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= Page Header ================= -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="My Profile"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding SubHeading}"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ================= Body: Left profile card + Right content ================= -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ========== LEFT GRID: Profile Card ========== -->
                    <!-- Stretches to fill the row (matches the right column's
                         full height, see Grid.Row="2" below) so the card's
                         bottom - and its Edit Profile button - lines up with
                         the bottom of the Structured Information row instead
                         of the card floating at a shorter, content-sized
                         height while the right side runs taller. Internally
                         a 2-row Grid keeps the identity fields pinned to the
                         top and the Edit Profile button pinned to the
                         bottom, with the divider/spacer absorbing the extra
                         vertical space in between. -->
                    <Border Grid.Column="0" Style="{StaticResource ProfileCardStyle}" VerticalAlignment="Stretch">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top: avatar / name / role / status / identity fields -->
                            <StackPanel Grid.Row="0">

                                <!-- Avatar -->
                                <Ellipse Width="96" Height="96" HorizontalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarPathConverter}}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Full name / role -->
                                <TextBlock Text="{Binding FullName}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,14,0,0"/>

                                <TextBlock Text="{Binding RoleLabel}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>

                                <Border Background="{DynamicResource SuccessBadgeBrush}"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>

                                <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,20,0,16"/>

                                <!-- Identity fields -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Employee ID" Style="{StaticResource ProfileFieldLabelStyle}" Width="100"/>
                                    <TextBlock Grid.Column="1" Text="{Binding EmployeeIdDisplay}" Style="{StaticResource ProfileFieldValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Department" Style="{StaticResource ProfileFieldLabelStyle}" Width="100"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Department}" Style="{StaticResource ProfileFieldValueStyle}"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Work Email" Style="{StaticResource ProfileFieldLabelStyle}" Width="100"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Email}" Style="{StaticResource ProfileFieldValueStyle}"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Work Phone" Style="{StaticResource ProfileFieldLabelStyle}" Width="100"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Phone}" Style="{StaticResource ProfileFieldValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hire Date" Style="{StaticResource ProfileFieldLabelStyle}" Width="100"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HireDateDisplay}" Style="{StaticResource ProfileFieldValueStyle}" HorizontalAlignment="Right"/>
                                </Grid>

                            </StackPanel>

                            <!-- Middle: flexible spacer - absorbs whatever
                                 extra height the card has once it's
                                 stretched to match the right column, keeping
                                 the button pinned to the bottom instead of
                                 riding up under the identity fields. -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding LastUpdatedDisplay}"
                                       Style="{StaticResource CardSubtleStyle}"
                                       VerticalAlignment="Bottom"
                                       Margin="0,20,0,20"/>

                            <!-- Edit Profile button anchored at the bottom -->
                            <Button Grid.Row="2"
                                    Content="Edit Profile"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding EditProfileCommand}"
                                    HorizontalAlignment="Stretch"/>

                        </Grid>

                    </Border>

                    <!-- ========== RIGHT GRID ========== -->
                    <!-- 3-row Grid instead of a StackPanel: the Structured
                         Information detail row (row 2) is given "*" height
                         so it stretches to fill the same overall height as
                         the left profile card (both sit in the Grid.Row="2"
                         "*" row above), rather than sizing to its own
                         content and leaving a gap under a short left card
                         or a gap under itself when its content is short. -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Row: At-a-glance Global Stats -->
                        <TextBlock Grid.Row="0"
                                   Text="At-a-glance Global Stats"
                                   Style="{StaticResource CardHeadingStyle}"
                                   Margin="4,0,0,12"/>

                        <Grid Grid.Row="1" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- PTO Balance -->
                            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                                <Grid>
                                    <Border Style="{StaticResource GlobalStatAccentStripStyle}" Background="{DynamicResource CardAccentBlueBrush}"/>
                                    <StackPanel Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Style="{StaticResource StatIconBadgeStyle}" Background="{DynamicResource PrimaryBadgeBrush}">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="PTO BALANCE" Style="{StaticResource GlobalStatLabelStyle}"/>
                                        <TextBlock Text="{Binding PtoBalanceDisplay}" Style="{StaticResource GlobalStatValueStyle}" Margin="0,4,0,4"/>
                                        <TextBlock Text="{Binding PtoUsedDisplay}" Style="{StaticResource CardSubtleStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Retirement Savings -->
                            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                                <Grid>
                                    <Border Style="{StaticResource GlobalStatAccentStripStyle}" Background="{DynamicResource CardAccentGreenBrush}"/>
                                    <StackPanel Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Style="{StaticResource StatIconBadgeStyle}" Background="{DynamicResource SuccessBadgeBrush}">
                                                <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="RETIREMENT SAVINGS" Style="{StaticResource GlobalStatLabelStyle}"/>
                                        <TextBlock Text="{Binding RetirementSavingsDisplay}" Style="{StaticResource GlobalStatValueStyle}" Margin="0,4,0,4"/>
                                        <TextBlock Text="7% of salary / year tenured" Style="{StaticResource CardSubtleStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tenure -->
                            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                                <Grid>
                                    <Border Style="{StaticResource GlobalStatAccentStripStyle}" Background="{DynamicResource CardAccentAmberBrush}"/>
                                    <StackPanel Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Style="{StaticResource StatIconBadgeStyle}" Background="{DynamicResource WarningBadgeBrush}">
                                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="TENURE" Style="{StaticResource GlobalStatLabelStyle}"/>
                                        <TextBlock Text="{Binding TenureDisplay}" Style="{StaticResource GlobalStatValueStyle}" Margin="0,4,0,4"/>
                                        <TextBlock Text="{Binding HireDateDisplay}" Style="{StaticResource CardSubtleStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Performance Snapshot -->
                            <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                                <Grid>
                                    <Border Style="{StaticResource GlobalStatAccentStripStyle}" Background="{DynamicResource CardAccentRedBrush}"/>
                                    <StackPanel Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Style="{StaticResource StatIconBadgeStyle}" Background="{DynamicResource DangerBadgeBrush}">
                                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DangerBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="PERFORMANCE SNAPSHOT" Style="{StaticResource GlobalStatLabelStyle}"/>
                                        <TextBlock Text="{Binding PerformanceRewardRatioDisplay}" Style="{StaticResource GlobalStatValueStyle}" Margin="0,4,0,4"/>
                                        <TextBlock Text="{Binding PerformanceSummaryDisplay}" Style="{StaticResource CardSubtleStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>

                        <!-- Bottom Row: Personal Details / Job History / Compensation & Benefits -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Structured Information"
                                       Style="{StaticResource CardHeadingStyle}"
                                       Margin="4,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Personal Details -->
                                <Border Grid.Column="0" Style="{StaticResource DetailCardStyle}" VerticalAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="Personal Details" Style="{StaticResource CardHeadingStyle}" FontSize="13" Margin="0,0,0,14"/>

                                        <TextBlock Text="Address" Style="{StaticResource ProfileFieldLabelStyle}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding AddressDisplay}" Style="{StaticResource ProfileFieldValueStyle}"
                                                   TextWrapping="Wrap" Margin="0,0,0,14"/>

                                        <TextBlock Text="Date of Birth" Style="{StaticResource ProfileFieldLabelStyle}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding DateOfBirthDisplay}" Style="{StaticResource ProfileFieldValueStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Job History timeline -->
                                <Border Grid.Column="2" Style="{StaticResource DetailCardStyle}" VerticalAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="Job History" Style="{StaticResource CardHeadingStyle}" FontSize="13" Margin="0,0,0,14"/>

                                        <ItemsControl ItemsSource="{Binding JobHistory}"
                                                      Visibility="{Binding HasJobHistory, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Ellipse Grid.Column="0" VerticalAlignment="Top" Margin="0,3,0,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse" BasedOn="{StaticResource TimelineDotStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>

                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding ContractType}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Text="{Binding DateRangeDisplay}"
                                                                       Style="{StaticResource CardSubtleStyle}"
                                                                       Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding Status}"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Visibility="{Binding HasNoJobHistory, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource CardEmptyStateIconStyle}"/>
                                            <TextBlock Text="No contract history on file." Style="{StaticResource CardEmptyStateTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Compensation & Benefits -->
                                <Border Grid.Column="4" Style="{StaticResource DetailCardStyle}" VerticalAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="Compensation &amp; Benefits" Style="{StaticResource CardHeadingStyle}" FontSize="13" Margin="0,0,0,14"/>

                                        <TextBlock Text="{Binding CurrentSalaryPeriodDisplay, StringFormat='Est. Net Salary ({0})'}"
                                                   Style="{StaticResource ProfileFieldLabelStyle}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding CurrentNetSalaryDisplay}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Margin="0,0,0,14"/>

                                        <TextBlock Text="Current Base Salary" Style="{StaticResource ProfileFieldLabelStyle}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding CurrentBaseSalaryDisplay}" Style="{StaticResource ProfileFieldValueStyle}" Margin="0,0,0,14"/>

                                        <TextBlock Text="Pay Rate" Style="{StaticResource ProfileFieldLabelStyle}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding CurrentPayRateDisplay}" Style="{StaticResource ProfileFieldValueStyle}" Margin="0,0,0,14"/>

                                        <TextBlock Text="Benefits" Style="{StaticResource ProfileFieldLabelStyle}" Margin="0,0,0,6"/>

                                        <ItemsControl ItemsSource="{Binding Benefits}"
                                                      Visibility="{Binding HasBenefits, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource BenefitPillStyle}">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Visibility="{Binding HasNoBenefits, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource CardEmptyStateIconStyle}"/>
                                            <TextBlock Text="No contract on file to derive benefits from." Style="{StaticResource CardEmptyStateTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Grid>

                    </Grid>

                </Grid>

            </Grid>

        </ScrollViewer>

        <!-- ================= Edit Profile overlay ================= -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource ProfileCardStyle}"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Edit Profile"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="{Binding FormErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="Full Name" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Email" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Phone" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Address" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextAreaStyle}" Height="70" Margin="0,0,0,14"/>

                    <TextBlock Text="Date of Birth" Style="{StaticResource FormLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding FormDateOfBirth}"
                                Style="{StaticResource PaperDatePickerLineStyle}"
                                Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelEditCommand}"/>
                        <Button Grid.Column="2" Content="Save"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveProfileCommand}"/>
                    </Grid>

                </StackPanel>

            </Border>
        </Grid>

    </Grid>

</UserControl>
