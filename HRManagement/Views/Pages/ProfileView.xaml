<UserControl x:Class="HRManagement.Views.Pages.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:HRManagement.Controls"
             xmlns:utilities="clr-namespace:HRManagement.Utilities"
             mc:Ignorable="d"
             d:DesignWidth="1240" d:DesignHeight="820"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>

        <utilities:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!--
            FormLabelStyle / FormTextBoxStyle / FormDatePickerStyle now come
            from the shared Resources/FormStyles.xaml (merged in App.xaml) so
            this page's Edit Profile overlay matches Manage Profiles, Manage
            Contracts, and Manage Announcements. DashboardCardStyle and the
            other styles below are specific to this page's dashboard-style
            layout and remain local.
        -->

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1A2B3674" BlurRadius="18" ShadowDepth="4" Opacity="0.12" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="CardSubtleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>


        <Style x:Key="InfoRowIconStyle" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        </Style>

    </UserControl.Resources>

    <Grid>

        <Grid Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--Page Header  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="My Profile"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding SubHeading}"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                    Content="Edit Profile"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding EditProfileCommand}"
                    Width="150"/>
            </Grid>

            <!-- Body: info card + dashboard-->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Profile Info Card -->
                <Border Grid.Column="0"
                    Style="{StaticResource DashboardCardStyle}"
                    VerticalAlignment="Top" Height="549">

                    <StackPanel>

                        <Ellipse Width="96" Height="96" HorizontalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <TextBlock Text="{Binding FullName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"/>

                        <Border Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="12"
                            Padding="12,4"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                            <TextBlock Text="{Binding RoleLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>

                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,20,0,16"/>

                        <!-- Contact -->
                        <StackPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource InfoRowIconStyle}">
                                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Email" Style="{StaticResource CardSubtleStyle}"/>
                                    <TextBlock Text="{Binding Email}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource InfoRowIconStyle}">
                                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Phone" Style="{StaticResource CardSubtleStyle}"/>
                                    <TextBlock Text="{Binding Phone}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource InfoRowIconStyle}">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Date of Birth" Style="{StaticResource CardSubtleStyle}"/>
                                    <TextBlock Text="{Binding DateOfBirthDisplay}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,4,0,16"/>

                        <!-- Employment -->
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Employee ID" Style="{StaticResource CardSubtleStyle}"/>
                                    <TextBlock Text="{Binding EmployeeIdDisplay}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Department" Style="{StaticResource CardSubtleStyle}"/>
                                    <TextBlock Text="{Binding Department}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Status" Style="{StaticResource CardSubtleStyle}"/>
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Hire Date" Style="{StaticResource CardSubtleStyle}"/>
                                    <TextBlock Text="{Binding HireDateDisplay}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding LastUpdatedDisplay}"
                               Style="{StaticResource CardSubtleStyle}"
                               Margin="0,20,0,0"/>

                    </StackPanel>
                </Border>

                <!--Dashboard-->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>

                        <!-- Stat: Attendance / Leave Balance / Performance -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Attendance Rate -->
                            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,27">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Attendance" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Grid.Column="1" Text="This Month" Style="{StaticResource CardSubtleStyle}"/>
                                    </Grid>
                                    <controls:DonutProgress Percentage="{Binding AttendanceRate}"
                                                         RingBrush="{DynamicResource PrimaryBrush}"
                                                         TrackBrush="{DynamicResource InputBackgroundBrush}"
                                                         Thickness="12"
                                                         Width="175" Height="204">
                                        <controls:DonutProgress.CenterContent>
                                            <StackPanel>
                                                <TextBlock Text="{Binding AttendanceRateDisplay}"
                                                       FontSize="20" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="present" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </controls:DonutProgress.CenterContent>
                                    </controls:DonutProgress>

                                    <TextBlock Text="{Binding AttendanceSummary}"
                                           Style="{StaticResource CardSubtleStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Requests -->
                            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Margin="0,0,10,27">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Requests" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Grid.Column="1" Text="This Year" Style="{StaticResource CardSubtleStyle}"/>
                                    </Grid>

                                    <controls:DonutProgress Percentage="{Binding RequestApprovalRate}"
                                                         RingBrush="{DynamicResource AccentBrush}"
                                                         TrackBrush="{DynamicResource InputBackgroundBrush}"
                                                         Thickness="12"
                                                         Width="198" Height="202"
                                                         HorizontalAlignment="Center"
                                                         Margin="0,10,0,10">
                                        <controls:DonutProgress.CenterContent>
                                            <StackPanel>
                                                <TextBlock Text="{Binding PendingRequestsCount}"
                                                       FontSize="20" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="pending" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </controls:DonutProgress.CenterContent>
                                    </controls:DonutProgress>

                                    <TextBlock Text="{Binding RequestsSummary}"
                                           Style="{StaticResource CardSubtleStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Bonus / Evaluation -->
                            <Border Grid.Column="4" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,27">
                                <StackPanel>
                                    <TextBlock Text="Latest Evaluation" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,16"/>

                                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,14">
                                        <TextBlock Text="{Binding LatestEvaluationAmountDisplay}"
                                               FontSize="28" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding LatestEvaluationTypeDisplay}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Total bonus this year"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalBonusThisYearDisplay}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Employment details + Quick info -->
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Employment details -->
                            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,-13,0,0">
                                <StackPanel>
                                    <TextBlock Text="Employment Details" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,16"/>

                                    <ItemsControl ItemsSource="{Binding EmploymentDetails}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontSize="13"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Quick info: payroll, evaluation, requests -->
                            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Margin="0,-13,0,0">
                                <StackPanel>
                                    <TextBlock Text="Quick Info" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                            Background="{DynamicResource InputBackgroundBrush}">
                                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Latest Payslip" Style="{StaticResource CardSubtleStyle}"/>
                                            <TextBlock Text="{Binding LatestPayslipDate}" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding LatestPayslipAmount}"
                                               FontWeight="Bold" FontSize="15"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                            Background="{DynamicResource InputBackgroundBrush}">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Contract" Style="{StaticResource CardSubtleStyle}"/>
                                            <TextBlock Text="{Binding ContractTypeDisplay}" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ContractStatusDisplay}"
                                               FontWeight="Bold" FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                            Background="{DynamicResource InputBackgroundBrush}">
                                            <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Pending Requests" Style="{StaticResource CardSubtleStyle}"/>
                                            <TextBlock Text="Awaiting approval" FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding PendingRequestsCount}"
                                               FontWeight="Bold" FontSize="15"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- Edit Profile overlay-->
        <Grid Style="{StaticResource ModalScrimStyle}"
          Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource DashboardCardStyle}"
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Edit Profile"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,0,0,18"/>

                    <TextBlock Text="{Binding FormErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="Full Name" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Email" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Phone" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Date of Birth" Style="{StaticResource FormLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding FormDateOfBirth}"
                            Style="{StaticResource FormDatePickerStyle}"
                            Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelEditCommand}"/>
                        <Button Grid.Column="2" Content="Save"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveProfileCommand}"/>
                    </Grid>

                </StackPanel>

            </Border>
        </Grid>

    </Grid>

</UserControl>
