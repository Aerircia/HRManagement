<UserControl x:Class="HRManagement.Views.Pages.ManageSalariesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1450">


    <!-- Main layout -->

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Manage Salaries"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Margin="0,5,0,0"
                           FontSize="14"
                           Opacity="0.65"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Manage salary components and create monthly payroll records." />

            </StackPanel>

            <Button Grid.Column="1"
                    MinWidth="190"
                    Height="42"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding CreateMonthlyPayrollCommand}"
                    Content="Create Monthly Payroll" />

        </Grid>

        <!-- Filter and search -->

        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Style="{StaticResource SectionCardBorderStyle}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Month -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                    <TextBlock Text="Month"
                               Style="{StaticResource FieldLabelStyle}" />

                </StackPanel>

                <ComboBox Grid.Column="1"
                          Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding Months}"
                          SelectedItem="{Binding SelectedMonth,
                                                 Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}" />

                <!-- Year -->

                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                    <TextBlock Text="Year"
                               Style="{StaticResource FieldLabelStyle}" />

                </StackPanel>

                <ComboBox Grid.Column="4"
                          Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding Years}"
                          SelectedItem="{Binding SelectedYear,
                                                 Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}" />

                <!-- Load button -->

                <Button Grid.Column="6"
                        MinWidth="105"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding LoadSalariesCommand}"
                        Content="Load Data" />

                <!-- Search -->

                <Grid Grid.Column="7"
                      Margin="20,0,12,0">

                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource FormTextBoxStyle}"
                             Text="{Binding SearchText,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="25,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Opacity="0.45"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Search by employee, department, role or status">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Text,
                                                                  ElementName=SearchTextBox}"
                                                 Value="">

                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Text,
                                                                  ElementName=SearchTextBox}"
                                                 Value="{x:Null}">

                                        <Setter Property="Visibility"
                                                Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

                <Button Grid.Column="8"
                        Width="70"
                        Style="{DynamicResource ResourceKey=SecondaryButtonStyle}"
                        Command="{Binding ClearSearchCommand}"
                        Content="Clear" />

            </Grid>

        </Border>

        <!-- Summary cards -->

        <Grid Grid.Row="2"
              Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- Total employees -->

            <Border Grid.Column="0"
                    Style="{StaticResource SummaryCardBorderStyle}">

                <Grid>
                    <Border Style="{StaticResource SummaryCardAccentStripBlueStyle}"/>
                    <StackPanel Margin="0,4,0,0">

                        <TextBlock Text="Total Employees"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Opacity="0.65" />

                        <TextBlock Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{Binding TotalEmployees, Mode=OneWay}" />

                    </StackPanel>
                </Grid>

            </Border>

            <!-- Created payroll -->

            <Border Grid.Column="1"
                    Style="{StaticResource SummaryCardBorderStyle}">

                <Grid>
                    <Border Style="{StaticResource SummaryCardAccentStripGreenStyle}"/>
                    <StackPanel Margin="0,4,0,0">

                        <TextBlock Text="Payroll Created"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Opacity="0.65" />

                        <TextBlock Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Text="{Binding CreatedPayrollCount, Mode=OneWay}" />

                    </StackPanel>
                </Grid>

            </Border>

            <!-- Pending payroll -->

            <Border Grid.Column="2"
                    Style="{StaticResource SummaryCardBorderStyle}">

                <Grid>
                    <Border Style="{StaticResource SummaryCardAccentStripRedStyle}"/>
                    <StackPanel Margin="0,4,0,0">

                        <TextBlock Text="Payroll Pending"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Opacity="0.65" />

                        <TextBlock Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Text="{Binding PendingPayrollCount, Mode=OneWay}" />

                    </StackPanel>
                </Grid>

            </Border>

            <!-- Total salary -->

            <Border Grid.Column="3"
                    Margin="0"
                    Style="{StaticResource SummaryCardBorderStyle}">

                <Grid>
                    <Border Style="{StaticResource SummaryCardAccentStripBlueStyle}"/>
                    <StackPanel Margin="0,4,0,0">

                        <TextBlock Text="Estimated Monthly Salary"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Opacity="0.65" />

                        <TextBlock Margin="0,8,0,0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Text="{Binding TotalMonthlySalary,
                                                  Mode=OneWay,
                                                  StringFormat='{}{0:$#,##0.00}'}" />

                    </StackPanel>
                </Grid>

            </Border>

        </Grid>

        <!-- Content area -->

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.6*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- Salary DataGrid -->

            <Border Grid.Column="0"
                    Style="{StaticResource SectionCardBorderStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Employee Salary List"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.6">

                                <Run Text="Salary period: " />

                                <Run Text="{Binding SelectedPeriod, Mode=OneWay}" />

                            </TextBlock>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh" />

                    </Grid>

                    <Grid Grid.Row="1">

                        <DataGrid ItemsSource="{Binding Salaries, Mode=OneWay}"
                                  SelectedItem="{Binding SelectedSalary,
                                                         Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ManageSalaryDataGridStyle}"
                                  CellStyle="{StaticResource ManageSalaryDataGridCellStyle}"
                                  ColumnHeaderStyle="{StaticResource ManageSalaryColumnHeaderStyle}"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource InputBackgroundBrush}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.CanContentScroll="True">

                            <DataGrid.Columns>

                                <!-- Compact identity column -->
                                <DataGridTextColumn Header="ID"
                                                    Width="0.55*"
                                                    MinWidth="48"
                                                    Binding="{Binding EmployeeId, Mode=OneWay}" />

                                <!-- Main information: receives the largest available width -->
                                <DataGridTextColumn Header="Employee"
                                                    Width="2.2*"
                                                    MinWidth="150"
                                                    Binding="{Binding FullName, Mode=OneWay}" />

                                <DataGridTextColumn Header="Department"
                                                    Width="1.35*"
                                                    MinWidth="105"
                                                    Binding="{Binding DepartmentName, Mode=OneWay}" />

                                <!-- Attendance summary -->
                                <DataGridTextColumn Header="Working"
                                                    Width="0.85*"
                                                    MinWidth="68"
                                                    Binding="{Binding WorkingDays, Mode=OneWay}" />

                                <DataGridTextColumn Header="Absent"
                                                    Width="0.8*"
                                                    MinWidth="64"
                                                    Binding="{Binding AbsentDays, Mode=OneWay}" />

                                <!-- Main payroll value -->
                                <DataGridTextColumn Header="Salary ($)"
                                                    Width="1.35*"
                                                    MinWidth="120"
                                                    Binding="{Binding TotalSalary,
                                                                      Mode=OneWay,
                                                                      StringFormat='{}{0:$#,##0.00}'}" />

                                <DataGridTemplateColumn Header="Status"
                                                        Width="1.05*"
                                                        MinWidth="90">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border Style="{StaticResource PayrollStatusBadgeStyle}"
                                                    Opacity="0.75"
                                                    CornerRadius="10"
                                                    Height="26"
                                                    Width="86">

                                                <TextBlock HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding PayrollStatus, Mode=OneWay}" />

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- Empty state -->

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource EmptyStateStyle}">

                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="No salary records found" />

                            <TextBlock Margin="0,7,0,0"
                                       HorizontalAlignment="Center"
                                       Opacity="0.6"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Select another month or change the search keyword." />

                        </StackPanel>

                        <!-- Loading overlay -->

                        <Border Background="#66000000"
                                CornerRadius="8"
                                Style="{StaticResource LoadingOverlayStyle}">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <ProgressBar Width="180"
                                             Height="5"
                                             IsIndeterminate="True" />

                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Text="Loading salary data..." />

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- Status message -->

                    <Border Grid.Row="2"
                            Margin="0,14,0,0"
                            Padding="12,9"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">

                        <TextBlock FontSize="12"
                                   Opacity="0.8"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{Binding StatusMessage, Mode=OneWay}" />

                    </Border>

                </Grid>

            </Border>

            <!-- Selected employee details -->

            <Border Grid.Column="2"
                    Style="{StaticResource SectionCardBorderStyle}">

                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="Salary Details"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <!-- Selected employee heading -->

                        <Border Padding="14"
                                Margin="0,0,0,18"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="9">

                            <StackPanel>

                                <TextBlock Foreground="White"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedEmployeeName, Mode=OneWay}" />

                                <TextBlock Margin="0,5,0,0"
                                           Foreground="White"
                                           Opacity="0.8">

                                    <Run Text="Period: " />

                                    <Run Text="{Binding SelectedPeriod, Mode=OneWay}" />

                                </TextBlock>

                            </StackPanel>

                        </Border>

                        <!-- Employee information -->

                        <Grid Margin="0,0,0,16">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,10,0">

                                <TextBlock Text="Department"
                                           Style="{StaticResource FieldLabelStyle}" />

                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding SelectedSalary.DepartmentName,
                                                          TargetNullValue=--}" />

                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="Role"
                                           Style="{StaticResource FieldLabelStyle}" />

                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding SelectedSalary.RoleName,
                                                          TargetNullValue=--}" />

                            </StackPanel>

                        </Grid>

                        <Separator Margin="0,0,0,16"
                                   Background="{DynamicResource BorderBrush}" />

                        <!-- Editable salary components -->

                        <TextBlock Text="Editable Components"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,14" />

                        <StackPanel Margin="0,0,0,14">

                            <TextBlock Text="Base Salary"
                                       Style="{StaticResource FieldLabelStyle}" />

                            <TextBox Style="{StaticResource FormTextBoxStyle}"
                                     IsEnabled="{Binding CanEditSelectedSalary}"
                                     Text="{Binding EditingBaseSalary,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=LostFocus,
                                                    StringFormat=F0}" />

                        </StackPanel>

                        <StackPanel Margin="0,0,0,18">

                            <TextBlock Text="Pay Rate"
                                       Style="{StaticResource FieldLabelStyle}" />

                            <TextBox Style="{StaticResource FormTextBoxStyle}"
                                     IsEnabled="{Binding CanEditSelectedSalary}"
                                     Text="{Binding EditingPayRate,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=LostFocus,
                                                    StringFormat=F2}" />

                        </StackPanel>

                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding SaveSalaryComponentsCommand}"
                                    Content="Save Changes" />

                            <Button Grid.Column="2"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding ResetSalaryComponentsCommand}"
                                    Content="Reset" />

                        </Grid>

                        <Separator Margin="0,0,0,16"
                                   Background="{DynamicResource BorderBrush}" />

                        <!-- Payroll details -->

                        <TextBlock Text="Attendance Breakdown"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Calendar working days"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="{Binding SelectedSalary.CalendarWorkingDays,
                                                      Mode=OneWay,
                                                      TargetNullValue=0}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Effective working days"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="{Binding SelectedSalary.EffectiveWorkingDays,
                                                      Mode=OneWay,
                                                      TargetNullValue=0}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Present days"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="{Binding SelectedSalary.PresentDays,
                                                      Mode=OneWay,
                                                      TargetNullValue=0}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Late days"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding SelectedSalary.LateDays,
                                                          Mode=OneWay,
                                                          TargetNullValue=0}" />

                                <TextBlock Margin="6,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Opacity="0.7">
                                    <Run Text="(" />
                                    <Run Text="{Binding SelectedSalary.LateMinutes,
                                                      Mode=OneWay,
                                                      TargetNullValue=0}" />
                                    <Run Text=" min)" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Weekday OT"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding SelectedSalary.WeekdayOtHours,
                                                          Mode=OneWay,
                                                          StringFormat={}{0:N2} h}" />

                                <TextBlock Margin="6,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Opacity="0.7"
                                           Text="× 1.5" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Weekend OT"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding SelectedSalary.WeekendOtHours,
                                                          Mode=OneWay,
                                                          StringFormat={}{0:N2} h}" />

                                <TextBlock Margin="6,0,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Opacity="0.7"
                                           Text="× 2.0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Paid day off"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Text="{Binding SelectedSalary.PaidDayOffDays,
                                                      Mode=OneWay,
                                                      TargetNullValue=0}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Unpaid day off"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding SelectedSalary.UnpaidDayOffDays,
                                                      Mode=OneWay,
                                                      TargetNullValue=0}" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Absent days"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding SelectedSalary.AbsentDays,
                                                      Mode=OneWay,
                                                      TargetNullValue=0}" />
                        </Grid>

                        <Separator Margin="0,0,0,16"
                                   Background="{DynamicResource BorderBrush}" />

                        <TextBlock Text="Salary Calculation"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Role salary"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="{Binding PreviewRoleSalary,
                                                      Mode=OneWay,
                                                      StringFormat='{}{0:$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Daily salary"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="{Binding PreviewDailySalary,
                                                      Mode=OneWay,
                                                      StringFormat='{}{0:$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Hourly salary"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="{Binding PreviewHourlySalary,
                                                      Mode=OneWay,
                                                      StringFormat='{}{0:$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Weekday OT salary"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Text="{Binding PreviewWeekdayOtSalary,
                                                      Mode=OneWay,
                                                      StringFormat='{}{0:+$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Weekend OT salary"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Text="{Binding PreviewWeekendOtSalary,
                                                      Mode=OneWay,
                                                      StringFormat='{}{0:+$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Reward"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Text="{Binding SelectedSalary.Reward,
                                                      Mode=OneWay,
                                                      TargetNullValue=0,
                                                      StringFormat='{}{0:+$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Evaluation penalty"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding SelectedSalary.Penalty,
                                                      Mode=OneWay,
                                                      TargetNullValue=0,
                                                      StringFormat='{}{0:-$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Late penalty"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding PreviewLatePenalty,
                                                      Mode=OneWay,
                                                      StringFormat='{}{0:-$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Absent deduction"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding PreviewAbsentDeduction,
                                                      Mode=OneWay,
                                                      StringFormat='{}{0:-$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Unpaid leave deduction"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Opacity="0.7" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding PreviewUnpaidDayOffDeduction,
                                                      Mode=OneWay,
                                                      StringFormat='{}{0:-$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Gross salary"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="{Binding PreviewGrossSalary,
                                                      Mode=OneWay,
                                                      StringFormat='{}{0:$#,##0.00}'}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Total deductions"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Text="{Binding PreviewTotalDeductions,
                                                      Mode=OneWay,
                                                      StringFormat='{}{0:-$#,##0.00}'}" />
                        </Grid>

                        <!-- Preview total -->

                        <Border Margin="0,10,0,18"
                                Padding="14"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="9">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Text="Preview Total" />

                                <TextBlock Grid.Column="1"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Text="{Binding PreviewTotalSalary,
                                                          Mode=OneWay,
                                                          StringFormat='{}{0:$#,##0.00}'}" />

                            </Grid>

                        </Border>

                        <!-- Validation error -->

                        <TextBlock Margin="0,0,0,14"
                                   Style="{StaticResource ValidationMessageStyle}"
                                   Text="{Binding SelectedSalary.ValidationMessage}" />

                        <!-- Payroll actions -->

                        <Button Height="40"
                                Margin="0,0,0,10"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding CreatePayrollCommand}"
                                Content="Create Employee Payroll" />

                        <Button Height="40"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeletePayrollCommand}"
                                Content="Delete Employee Payroll" />

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>
