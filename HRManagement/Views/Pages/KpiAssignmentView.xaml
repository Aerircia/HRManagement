<UserControl x:Class="HRManagement.Views.Pages.KpiAssignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HRManagement.Views.Pages"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             d:DesignWidth="1400" d:DesignHeight="900"
             Background="Transparent">

    <!--
        KPI Assignment / Management (Admin + Manager).

        Layout mirrors ManageAttendancesView.xaml:
          Row 0: page title
          Row 1: 4 stat cards (StatCardStyle / StatIconBadgeStyle from
                 ManageRequestsStyles.xaml, same as ManageAttendances)
          Row 2: left card = employee search/filter + DataGrid
                 right card = selected employee's assigned KPI grid,
                 with an inline progress bar per row and an "Assign
                 KPI" button in the card header.

        Row action buttons (edit/delete) reuse RowIconButtonStyle
        (TableStyles.xaml) with the same Segoe MDL2 glyphs as
        ManageProfilesView.xaml's employee table, so both tables look
        identical.

        A modal "Assign KPI" dialog is layered on top via a root Grid +
        ModalScrimStyle (FormStyles.xaml), the same pattern already
        documented as shared by Add/Edit + delete-confirm popups
        elsewhere in the app. Step 1 (KPI pack cards) and Step 3
        (per-employee checkbox cards) use the new KpiStyles.xaml
        resources.
    -->

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,16">

                <TextBlock Text="KPI Assignment"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <Border Margin="0,10,0,0"
                        Padding="12,9"
                        CornerRadius="6"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasOperationMessage,
                                             Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush"
                                    Value="{DynamicResource SuccessBrush}"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOperationError}"
                                             Value="True">
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="{Binding OperationMessage}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SuccessBrush}"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOperationError}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- Stat row -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">

                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,16,0">
                    <Grid>
                        <Border Style="{StaticResource StatCardAccentStripBlueStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource StatIconBadgeStyle}" Background="{DynamicResource PrimaryBadgeBrush}">
                                <fa:IconBlock Icon="Users" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Employees With KPI" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding TotalAssignedCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,16,0">
                    <Grid>
                        <Border Style="{StaticResource StatCardAccentStripAmberStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource StatIconBadgeStyle}" Background="{DynamicResource WarningBadgeBrush}">
                                <fa:IconBlock Icon="UserClock" Width="18" Height="18" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Not Yet Assigned" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding EmployeesWithoutKpiCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,16,0">
                    <Grid>
                        <Border Style="{StaticResource StatCardAccentStripGreenStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource StatIconBadgeStyle}" Background="{DynamicResource SuccessBadgeBrush}">
                                <fa:IconBlock Icon="ChartLine" Width="18" Height="18" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Avg KPI MTD" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding AverageKpiMtdPercent, StringFormat={}{0}%}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatCardStyle}">
                    <Grid>
                        <Border Style="{StaticResource StatCardAccentStripRedStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource StatIconBadgeStyle}" Background="{DynamicResource DangerBadgeBrush}">
                                <fa:IconBlock Icon="TriangleExclamation" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="At Risk (&lt; 50%)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding AtRiskCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- Bottom row: employee list (left) + KPI detail (right) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Filters + Employee list -->
                <Border Grid.Column="0" Style="{StaticResource TableCardStyle}" Padding="12" Margin="0,0,10,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="0,0,0,8">

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Employee:" VerticalAlignment="Center" Width="90" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Width="210"
                                        Height="28"
                                        HorizontalAlignment="Left">
                                    <TextBox Text="{Binding EmployeeFilter, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Width="180"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             Tag="Search by name or code..."/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Department:" VerticalAlignment="Center" Width="90" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <ComboBox Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding Departments}"
                                          SelectedItem="{Binding SelectedDepartment}"
                                          Width="207"
                                          Height="24" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Month:" VerticalAlignment="Center" Width="90" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <ComboBox Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding AvailableMonths}"
                                          SelectedItem="{Binding SelectedMonth}"
                                          Width="207"
                                          Height="24" />
                            </StackPanel>

                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Employees}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}" IsReadOnly="True"
                                  CanUserReorderColumns="False"
                                  AlternationCount="2"
                                  VerticalAlignment="Top" RowHeight="52"
                                  GridLinesVisibility="None" HeadersVisibility="Column"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  BorderThickness="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>

                                <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Employee" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource PrimaryTintBrush}">
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EmployeeName}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding EmployeeCode}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="KPIs" Binding="{Binding AssignedKpiCount}" Width="46"
                                                     ElementStyle="{StaticResource TableCellTextStyle}"/>
                                <DataGridTextColumn Header="MTD" Binding="{Binding KpiMtdPercent, StringFormat={}{0}%}" Width="60"
                                                     ElementStyle="{StaticResource TableCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Right: selected employee's assigned KPI detail -->
                <Border Grid.Column="1" Style="{StaticResource TableCardStyle}" Padding="20" Margin="12,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Card header: selected employee + Assign button -->
                        <Grid Grid.Row="0" Margin="0,0,0,16" Visibility="{Binding IsEmployeeSelected, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource PrimaryTintBrush}">
                                    <TextBlock Text="{Binding SelectedEmployee.Initials}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedEmployee.EmployeeName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12">
                                        <Run Text="{Binding SelectedEmployee.EmployeeCode, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding SelectedEmployee.Department, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="+ Assign KPI"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding OpenAssignDialogCommand}"
                                    Visibility="{Binding IsAdmin,
                                                         Converter={StaticResource BoolToVisibility}}"
                                    Width="200"
                                    Height="38"
                                    Padding="20,0"/>
                        </Grid>

                        <!-- Empty state -->
                        <TextBlock Grid.Row="1"
                                   Text="Select an employee on the left to view or assign KPIs."
                                   Style="{StaticResource TableEmptyStateStyle}"
                                   Visibility="{Binding IsEmployeeSelected, Converter={StaticResource InverseBoolToVisibility}}"/>

                        <!-- Assigned KPI grid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding AssignedKpis}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True"
                                  CanUserReorderColumns="False"
                                  AlternationCount="2"
                                  GridLinesVisibility="None" HeadersVisibility="Column"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  RowHeight="56"
                                  BorderThickness="0"
                                  Visibility="{Binding IsEmployeeSelected, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="KPI" Binding="{Binding KpiName}" Width="1.4*"
                                                     ElementStyle="{StaticResource TableCellTextStyle}"/>

                                <!-- Read-only display columns - editing now happens exclusively
                                     through the "Edit KPI" modal (EditKpiRowCommand opens it),
                                     not inline in the grid. -->
                                <DataGridTextColumn Header="Target" Binding="{Binding AssignedTarget, StringFormat=N0}" Width="*"
                                                     ElementStyle="{StaticResource TableCellTextStyle}"/>

                                <DataGridTextColumn Header="Current"
                                                     Binding="{Binding CurrentValue, StringFormat=N2}"
                                                     Width="0.8*"
                                                     ElementStyle="{StaticResource TableCellTextStyle}"/>

                                <DataGridTextColumn Header="Pending"
                                                     Binding="{Binding PendingValueDisplay}"
                                                     Width="0.8*"
                                                     ElementStyle="{StaticResource TableCellTextStyle}"/>

                                <DataGridTextColumn Header="Weight"
                                                     Binding="{Binding AssignedWeight, StringFormat={}{0}%}"
                                                     Width="0.65*"
                                                     ElementStyle="{StaticResource TableCellTextStyle}"/>

                                <!-- KPI MTD progress bar -->
                                <DataGridTemplateColumn Header="KPI MTD" Width="1.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="16,0,10,0" VerticalAlignment="Center">
                                                <Grid Height="8" Margin="0,0,0,4">
                                                    <Border CornerRadius="4" Background="{DynamicResource InputBackgroundBrush}"/>
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentageToStarConverter}}"/>
                                                            <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentageToStarConverter}, ConverterParameter=Remainder}"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" CornerRadius="4" Background="{DynamicResource PrimaryBrush}"/>
                                                    </Grid>
                                                </Grid>
                                                <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0.#}%}"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Row action buttons: reuses RowIconButtonStyle + the same
                                     Segoe MDL2 glyphs (E70F edit / E74D delete) as
                                     ManageProfilesView.xaml's employee table, for a matching
                                     look across both tables. -->
                                <DataGridTemplateColumn Header="Approval" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">

                                                <Button Content="Approve"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Width="72"
                                                        Height="30"
                                                        Margin="0,0,6,0"
                                                        Padding="8,0"
                                                        FontSize="11"
                                                        IsEnabled="{Binding CanApprovePending}"
                                                        Command="{Binding DataContext.ApprovePendingCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Content="Reject"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Visibility="{Binding DataContext.IsAdmin,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                                             Converter={StaticResource BoolToVisibility}}"
                                                        Width="66"
                                                        Height="30"
                                                        Margin="0,0,8,0"
                                                        Padding="8,0"
                                                        FontSize="11"
                                                        IsEnabled="{Binding CanRejectPending}"
                                                        Command="{Binding DataContext.RejectPendingCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Style="{StaticResource RowIconButtonStyle}"
                                                        Visibility="{Binding DataContext.IsAdmin,
                                                                             RelativeSource={RelativeSource AncestorType=UserControl},
                                                                             Converter={StaticResource BoolToVisibility}}"
                                                        IsEnabled="{Binding CanModify}"
                                                        Command="{Binding DataContext.EditKpiRowCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE70F;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Button>


                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================
             Assign KPI wizard modal (4 steps)
             ============================================================ -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsAssignDialogOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="18"
                    Width="820"
                    MaxHeight="760"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource CardShadowColor}" BlurRadius="26" ShadowDepth="6" Opacity="0.14" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ===== Header: title + close ===== -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Assign KPI" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <Button Grid.Column="1" Style="{StaticResource RowIconButtonStyle}"
                                Command="{Binding CloseAssignDialogCommand}">
                            <fa:IconBlock Icon="Xmark" Width="16" Height="16" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Button>
                    </Grid>

                    <!-- ===== Step header: 4 numbered circles + connecting line ===== -->
                    <Grid Grid.Row="1" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Grid.ColumnSpan="4" Height="2" Background="{DynamicResource BorderBrush}"
                                VerticalAlignment="Center" Margin="60,0"/>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WizardStep, Converter={StaticResource StepGreaterThanConverter}, ConverterParameter=1}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WizardStep, Converter={StaticResource StepGreaterThanConverter}, ConverterParameter=1}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Month &amp; Pack" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WizardStep, Converter={StaticResource StepGreaterThanConverter}, ConverterParameter=2}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WizardStep, Converter={StaticResource StepGreaterThanConverter}, ConverterParameter=2}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Employees" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WizardStep, Converter={StaticResource StepGreaterThanConverter}, ConverterParameter=3}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WizardStep, Converter={StaticResource StepGreaterThanConverter}, ConverterParameter=3}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Assign KPIs" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="4" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Confirm" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Step body ===== -->
                    <Grid Grid.Row="2">

                        <!-- Step 1: Month -> KPI pack cards, FULL MODAL WIDTH, vertically
                             stacked (one per row), each listing every KPI it contains
                             underneath the header instead of just a count. -->
                        <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Month" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding AvailableMonths}"
                                      SelectedItem="{Binding DialogSelectedMonth}"
                                      Width="200" HorizontalAlignment="Left"
                                      Margin="0,0,0,20"/>

                            <TextBlock Text="KPI Packs for this month" Style="{StaticResource FormLabelStyle}"/>

                            <TextBlock Text="No KPI packs exist for this month yet."
                                       Style="{StaticResource TableEmptyStateStyle}"
                                       Visibility="{Binding DialogMonthlyLists.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440">
                                <ItemsControl ItemsSource="{Binding DialogMonthlyLists}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectMonthlyListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0">
                                                <Border Style="{StaticResource KpiPackCardStyle}">
                                                    <StackPanel>

                                                        <!-- Header: name + department/KPI-count meta -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <fa:IconBlock Icon="ListCheck" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                                                <StackPanel Margin="10,0,0,0">
                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource KpiPackNameTextStyle}"/>
                                                                    <TextBlock Style="{StaticResource KpiPackMetaTextStyle}">
                                                                        <Run Text="{Binding Department, Mode=OneWay}"/>
                                                                        <Run Text=" · "/>
                                                                        <Run Text="{Binding KpiCount, Mode=OneWay}"/>
                                                                        <Run Text=" KPIs"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <fa:IconBlock Grid.Column="1" Icon="CircleCheck" Width="20" Height="20"
                                                                          Foreground="{DynamicResource PrimaryBrush}"
                                                                          VerticalAlignment="Center"
                                                                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}"/>
                                                        </Grid>

                                                        <Border Style="{StaticResource KpiPackDividerStyle}"/>

                                                        <!-- Every KPI in the pack, listed below the header -->
                                                        <ItemsControl ItemsSource="{Binding Details}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Style="{StaticResource KpiPackDetailRowStyle}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="70" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0" Text="{Binding KpiName}" Style="{StaticResource KpiPackDetailNameTextStyle}"/>

                                                                        <TextBlock Grid.Column="1" Margin="10,0" Style="{StaticResource KpiPackDetailValueTextStyle}">
                                                                            <Run Text="{Binding TargetValue, Mode=OneWay, StringFormat=N0}"/>
                                                                            <Run Text=" "/>
                                                                            <Run Text="{Binding MeasurementUnit, Mode=OneWay}"/>
                                                                        </TextBlock>

                                                                        <Border Grid.Column="2" Style="{StaticResource KpiWeightPillStyle}">
                                                                            <TextBlock Style="{StaticResource KpiWeightPillTextStyle}">
                                                                                <Run Text="{Binding Weight, Mode=OneWay}"/>
                                                                                <Run Text="%"/>
                                                                            </TextBlock>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Step 2: Employees multi-select -->
                        <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Choose Employees" Style="{StaticResource FormLabelStyle}" HorizontalAlignment="Left"/>
                                <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                    <Run Text="{Binding DialogSelectedEmployeeCount, Mode=OneWay}"/>
                                    <Run Text=" selected"/>
                                </TextBlock>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                <ItemsControl ItemsSource="{Binding DialogEmployees}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ToggleWizardEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Cursor="Hand"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Margin="0,0,0,8">
                                                <Border CornerRadius="10" Padding="14,10" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryTintBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                  IsHitTestVisible="False" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Text="{Binding Department}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Step 3: per-employee cards. Every KPI in the chosen pack is
                             already listed with a checkbox (checked by default) -
                             unchecking removes it from that employee's assignment.
                             No separate add/remove buttons. -->
                        <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Choose which KPIs apply to each employee" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440">
                                <ItemsControl ItemsSource="{Binding WizardEmployeeCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                                                <StackPanel>

                                                    <!-- Card header: employee + selected count -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PrimaryTintBrush}">
                                                                <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold"
                                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding EmployeeName}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                <TextBlock Text="{Binding EmployeeCode}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock HorizontalAlignment="Right"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                                                <Run Text=" / "/>
                                                                <Run Text="{Binding KpiItems.Count, Mode=OneWay}"/>
                                                                <Run Text=" selected"/>
                                                            </TextBlock>

                                                            <TextBlock Text="{Binding WeightSummary}"
                                                                       Margin="0,3,0,0"
                                                                       HorizontalAlignment="Right"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource DangerBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasValidWeight}"
                                                                                         Value="True">
                                                                                <Setter Property="Foreground"
                                                                                        Value="{DynamicResource SuccessBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Checkbox rows for every KPI in the chosen pack -->
                                                    <ItemsControl ItemsSource="{Binding KpiItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource KpiCheckableRowStyle}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="90" />
                                                                            <ColumnDefinition Width="70" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <CheckBox Grid.Column="0"
                                                                                  VerticalAlignment="Center"
                                                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                                  Command="{Binding DataContext.ToggleKpiSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                  CommandParameter="{Binding}"/>

                                                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding KpiName}" Style="{StaticResource KpiCheckableNameTextStyle}"/>
                                                                            <TextBlock Text="{Binding MeasurementUnit}" Style="{StaticResource KpiCheckableUnitTextStyle}"/>
                                                                        </StackPanel>

                                                                        <TextBox Grid.Column="2" Margin="0,0,6,0"
                                                                                 Style="{StaticResource KpiInlineValueBoxStyle}"
                                                                                 IsEnabled="{Binding IsSelected}"
                                                                                 Text="{Binding AssignedTarget, UpdateSourceTrigger=PropertyChanged}"/>

                                                                        <TextBox Grid.Column="3"
                                                                                 Style="{StaticResource KpiInlineValueBoxStyle}"
                                                                                 IsEnabled="{Binding IsSelected}"
                                                                                 Text="{Binding AssignedWeight, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Step 4: confirmation summary -->
                        <StackPanel Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource SuccessBadgeBrush}">
                                    <fa:IconBlock Icon="Check" Width="18" Height="18" Foreground="{DynamicResource SuccessBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ready to assign" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="{Binding DialogSelectedMonth, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding DialogSelectedList.Name, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                                <ItemsControl ItemsSource="{Binding WizardEmployeeCards}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Orientation="Horizontal">
                                                            <TextBlock Text="{Binding EmployeeName}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Margin="8,0,0,0"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}">
                                                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                                                <Run Text=" KPIs"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding WeightSummary}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding KpiItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"
                                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                                                    <Run Text="• "/>
                                                                    <Run Text="{Binding KpiName, Mode=OneWay}"/>
                                                                    <Run Text=" — "/>
                                                                    <Run Text="{Binding AssignedTarget, Mode=OneWay, StringFormat=N0}"/>
                                                                    <Run Text=" ("/>
                                                                    <Run Text="{Binding AssignedWeight, Mode=OneWay}"/>
                                                                    <Run Text="%)"/>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                    </Grid>

                    <!-- ===== Footer navigation ===== -->
                    <Grid Grid.Row="3" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Back" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="100"
                                Height="40" Padding="24,0"
                                Command="{Binding WizardBackCommand}"
                                Visibility="{Binding IsStep1, Converter={StaticResource InverseBoolToVisibility}}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CloseAssignDialogCommand}"
                                    Width="100"
                                    Height="40" Padding="24,0" Margin="0,0,10,0"/>

                            <Button Content="Next" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding WizardNextCommand}"
                                    Width="100"
                                    Height="40" Padding="24,0"
                                    Visibility="{Binding IsStep4, Converter={StaticResource InverseBoolToVisibility}}"/>

                            <Button Content="Confirm Assign" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ConfirmAssignCommand}"
                                    Width="150"
                                    Height="40" Padding="24,0"
                                    Visibility="{Binding IsStep4, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             Edit KPI modal (Target / Actual / Weight)
             ============================================================ -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsEditDialogOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="18"
                    Width="480"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource CardShadowColor}" BlurRadius="26" ShadowDepth="6" Opacity="0.14" Direction="270"/>
                </Border.Effect>

                <StackPanel DataContext="{Binding EditDialog}">
                    <TextBlock Text="{Binding KpiName}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding MeasurementUnit}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Target" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding AssignedTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Actual" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Weight (%)"
                                   Style="{StaticResource FormLabelStyle}"/>

                        <TextBox Text="{Binding AssignedWeight,
                                               Mode=OneWay,
                                               StringFormat=N2}"
                                 IsReadOnly="True"
                                 IsTabStop="False"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                        <TextBlock Text="Weight is read-only here. Use Assign KPI to rebalance and replace the complete employee KPI set."
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DataContext.CloseEditDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Width="100"
                                Height="40" Padding="24,0" Margin="0,0,10,0"/>
                        <Button Content="Save"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding DataContext.SaveEditDialogCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                IsEnabled="True"
                                Width="100"
                                Height="40"
                                Padding="24,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</UserControl>
