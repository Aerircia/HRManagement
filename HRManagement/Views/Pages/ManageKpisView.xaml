<UserControl x:Class="HRManagement.Views.Pages.ManageKpisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="820"
             Background="{DynamicResource WindowBackgroundBrush}">

    <!--
        "Manage KPI" - Admin-only CRUD over the master KPI catalog (KPI
        table): the company's reusable list of KPIs that KPI packs
        (KpiSet, see KpiAssignmentView) are built from. Styled the same
        way as ManageDepartmentsView (shared TableStyles.xaml /
        FormStyles.xaml / ButtonStyles.xaml tokens), with a wider table
        and a richer Add/Edit form to cover the KPI's extra fields.
    -->

    <Grid>

        <!-- Page content (Admin only) -->
        <Grid Margin="30" Visibility="{Binding HasAccess, Converter={StaticResource BoolToVisibility}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Manage KPI"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Create, edit, and remove the company's reusable KPI catalog"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ New KPI"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}"
                        Width="140"/>
            </Grid>

            <!-- Search -->
            <Border Grid.Row="2" Style="{StaticResource TableSearchBoxContainerStyle}" Width="340" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <fa:IconBlock Grid.Column="0"
                                  Icon="MagnifyingGlass"
                                  Width="14" Height="14"
                                  Margin="0,0,10,0"
                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                  VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource TableSearchTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search KPIs"/>
                </Grid>
            </Border>

            <!-- Table -->
            <Border Grid.Row="3" Style="{StaticResource TableCardStyle}" Margin="0,16,0,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table header -->
                    <Grid Grid.Row="0" Style="{StaticResource TableHeaderRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.4*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="KPI Name" Style="{StaticResource TableHeaderTextStyle}"/>
                        <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource TableHeaderTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="Unit" Style="{StaticResource TableHeaderTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="Target" Style="{StaticResource TableHeaderTextStyle}"/>
                        <TextBlock Grid.Column="4" Text="Method" Style="{StaticResource TableHeaderTextStyle}"/>
                        <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource TableHeaderTextStyle}"/>
                        <TextBlock Grid.Column="6" Text="Actions" Style="{StaticResource TableHeaderTextStyle}" HorizontalAlignment="Center" Margin="0"/>
                    </Grid>

                    <!-- Rows -->
                    <Grid Grid.Row="1">

                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding KpisView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRowDividerStyle}">
                                            <Grid Height="58">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.4*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding KpiName}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           Margin="20,0,10,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Description}"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding KpiType}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding MeasurementUnit}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DefaultTarget}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding CalculationMethod}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="5"
                                                        Style="{StaticResource StatusPillStyle}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="12" FontWeight="SemiBold"/>
                                                </Border>

                                                <StackPanel Grid.Column="6"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">

                                                    <Button Style="{StaticResource RowIconButtonStyle}"
                                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <fa:IconBlock Icon="PenToSquare" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}"/>
                                                    </Button>

                                                    <Button Style="{StaticResource RowIconButtonStyle}"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="4,0,0,0">
                                                        <fa:IconBlock Icon="TrashCan" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}"/>
                                                    </Button>

                                                </StackPanel>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="No KPIs found."
                                   Style="{StaticResource TableEmptyStateStyle}"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

        <!-- Access denied (non Admin) -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="360"
                    Visibility="{Binding HasNoAccess, Converter={StaticResource BoolToVisibility}}">

            <Border Width="64" Height="64"
                    CornerRadius="32"
                    Background="{DynamicResource InputBackgroundBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <fa:IconBlock Icon="TriangleExclamation" Width="24" Height="24"
                              Foreground="{DynamicResource DangerBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Access restricted"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Manage KPI is only available to Admin accounts. Contact your administrator if you believe this is a mistake."
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

        </StackPanel>

        <!-- Add / Edit overlay -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="460"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="{Binding FormTitleText}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="{Binding FormErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="KPI Name" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding FormKpiName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,16"/>

                        <TextBlock Text="Description" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextAreaStyle}"
                                 Height="64" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="KPI Type" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                          ItemsSource="{Binding KpiTypeOptions}"
                                          SelectedItem="{Binding FormKpiType}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Measurement Unit" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                          ItemsSource="{Binding MeasurementUnitOptions}"
                                          SelectedItem="{Binding FormMeasurementUnit}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Default Target" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding FormDefaultTarget, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Calculation Method" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                          ItemsSource="{Binding CalculationMethodOptions}"
                                          SelectedItem="{Binding FormCalculationMethod}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <CheckBox IsChecked="{Binding FormIsActive}" VerticalAlignment="Center"/>
                            <TextBlock Text="Active"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CancelCommand}"/>
                            <Button Grid.Column="2" Content="Save"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveCommand}"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

            </Border>
        </Grid>

        <!-- Delete confirmation overlay -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Remove KPI?"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14">
                        <Run Text="This will permanently delete"/>
                        <Run Text="{Binding PendingDelete.KpiName, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="from your KPI catalog."/>
                    </TextBlock>

                    <TextBlock Text="{Binding DeleteErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               Margin="0,0,0,14"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasDeleteError, Converter={StaticResource BoolToVisibility}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDeleteCommand}"/>
                        <Button Grid.Column="2" Content="Delete"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="{DynamicResource DangerBrush}"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </Grid>

                </StackPanel>

            </Border>
        </Grid>

    </Grid>

</UserControl>
