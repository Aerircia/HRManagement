<UserControl x:Class="HRManagement.Views.Pages.EmployeeEvaluationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1450">

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- Card                                                      -->
        <!-- ========================================================= -->

        <Style x:Key="EvaluationCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="CornerRadius"
                    Value="10" />

            <Setter Property="Padding"
                    Value="18" />

        </Style>

        <!-- ========================================================= -->
        <!-- Section title                                             -->
        <!-- ========================================================= -->

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="17" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <!-- ========================================================= -->
        <!-- Field label                                               -->
        <!-- ========================================================= -->

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}" />

            <Setter Property="Margin"
                    Value="0,0,0,6" />

        </Style>

        <!-- ========================================================= -->
        <!-- TextBox                                                   -->
        <!-- ========================================================= -->

        <Style x:Key="EvaluationTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="MinHeight"
                    Value="38" />

            <Setter Property="Padding"
                    Value="10,7" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}" />

        </Style>

        <!-- ========================================================= -->
        <!-- ComboBox                                                  -->
        <!-- ========================================================= -->

        <Style x:Key="EvaluationComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="MinHeight"
                    Value="38" />

            <Setter Property="Padding"
                    Value="8,5" />

            <Setter Property="VerticalContentAlignment"
                    Value="Center" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}" />

        </Style>

        <!-- ========================================================= -->
        <!-- Secondary button                                          -->
        <!-- ========================================================= -->

        <Style x:Key="EvaluationSecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="MinHeight"
                    Value="38" />

            <Setter Property="Padding"
                    Value="16,8" />

            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

        </Style>

        <!-- ========================================================= -->
        <!-- Danger button                                             -->
        <!-- ========================================================= -->

        <Style x:Key="EvaluationDangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EvaluationSecondaryButtonStyle}">

            <Setter Property="Background"
                    Value="{DynamicResource DangerBrush}" />

            <Setter Property="Foreground"
                    Value="White" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource DangerBrush}" />

        </Style>

        <!-- ========================================================= -->
        <!-- DataGrid                                                  -->
        <!-- ========================================================= -->

        <Style x:Key="EvaluationDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns"
                    Value="False" />

            <Setter Property="CanUserAddRows"
                    Value="False" />

            <Setter Property="CanUserDeleteRows"
                    Value="False" />

            <Setter Property="CanUserResizeRows"
                    Value="False" />

            <Setter Property="IsReadOnly"
                    Value="True" />

            <Setter Property="SelectionMode"
                    Value="Single" />

            <Setter Property="SelectionUnit"
                    Value="FullRow" />

            <Setter Property="HeadersVisibility"
                    Value="Column" />

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal" />

            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource BorderBrush}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Background"
                    Value="{DynamicResource CardBackgroundBrush}" />

            <Setter Property="RowHeight"
                    Value="48" />

            <Setter Property="ColumnHeaderHeight"
                    Value="42" />

            <Setter Property="AlternationCount"
                    Value="2" />

        </Style>

        <!-- ========================================================= -->
        <!-- DataGrid row                                              -->
        <!-- ========================================================= -->

        <Style x:Key="EvaluationDataGridRowStyle"
               TargetType="DataGridRow">

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Style.Triggers>

                <Trigger Property="AlternationIndex"
                         Value="1">

                    <Setter Property="Opacity"
                            Value="0.96" />

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="{DynamicResource PrimaryBrush}" />

                    <Setter Property="Foreground"
                            Value="White" />

                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ========================================================= -->
        <!-- Reward/Penalty badge                                      -->
        <!-- ========================================================= -->

        <Style x:Key="EvaluationTypeBadgeStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource DangerBrush}" />

            <Setter Property="CornerRadius"
                    Value="12" />

            <Setter Property="Padding"
                    Value="10,4" />

            <Setter Property="HorizontalAlignment"
                    Value="Center" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding BonusType, Mode=OneWay}"
                             Value="Reward">

                    <Setter Property="Background"
                            Value="{DynamicResource SuccessBrush}" />

                </DataTrigger>

                <DataTrigger Binding="{Binding BonusType, Mode=OneWay}"
                             Value="Penalty">

                    <Setter Property="Background"
                            Value="{DynamicResource DangerBrush}" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ========================================================= -->
        <!-- Summary                                                   -->
        <!-- ========================================================= -->

        <Style x:Key="SummaryLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}" />

            <Setter Property="Opacity"
                    Value="0.7" />

        </Style>

        <Style x:Key="SummaryValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="20" />

            <Setter Property="FontWeight"
                    Value="Bold" />

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="Margin"
                    Value="0,5,0,0" />

        </Style>

        <!-- ========================================================= -->
        <!-- Loading overlay                                           -->
        <!-- ========================================================= -->

        <Style x:Key="LoadingOverlayStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#80000000" />

            <Setter Property="Visibility"
                    Value="Collapsed" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsLoading,
                                              Mode=OneWay}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ========================================================= -->
        <!-- No employee selected                                      -->
        <!-- ========================================================= -->

        <Style x:Key="NoEmployeeSelectedStyle"
               TargetType="Border">

            <Setter Property="Visibility"
                    Value="Visible" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding HasSelectedEmployee,
                                              Mode=OneWay}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Collapsed" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ========================================================= -->
        <!-- Employee detail content                                   -->
        <!-- ========================================================= -->

        <Style x:Key="EmployeeDetailContentStyle"
               TargetType="Grid">

            <Setter Property="Visibility"
                    Value="Collapsed" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding HasSelectedEmployee,
                                              Mode=OneWay}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ========================================================= -->
        <!-- No employees                                              -->
        <!-- ========================================================= -->

        <Style x:Key="NoEmployeesStyle"
               TargetType="Border">

            <Setter Property="Visibility"
                    Value="Collapsed" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding HasEmployees,
                                              Mode=OneWay}"
                             Value="False">

                    <Setter Property="Visibility"
                            Value="Visible" />

                </DataTrigger>

                <DataTrigger Binding="{Binding IsLoading,
                                              Mode=OneWay}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Collapsed" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ========================================================= -->
        <!-- No evaluations                                            -->
        <!-- ========================================================= -->

        <Style x:Key="NoEvaluationsStyle"
               TargetType="Border">

            <Setter Property="Visibility"
                    Value="Collapsed" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding HasEvaluations,
                                              Mode=OneWay}"
                             Value="False">

                    <Setter Property="Visibility"
                            Value="Visible" />

                </DataTrigger>

                <DataTrigger Binding="{Binding IsLoading,
                                              Mode=OneWay}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Collapsed" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <!-- ============================================================= -->
    <!-- MAIN LAYOUT                                                   -->
    <!-- ============================================================= -->

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- Header                                                    -->
        <!-- ========================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Employee Evaluations"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Margin="0,5,0,0"
                           Opacity="0.7"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Manage employee rewards, penalties and evaluation comments." />

            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <TextBlock Text="Selected period"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Opacity="0.65" />

                <TextBlock Text="{Binding SelectedPeriod,
                                          Mode=OneWay}"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}" />

            </StackPanel>

        </Grid>

        <!-- ========================================================= -->
        <!-- Filters                                                   -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
                Margin="0,0,0,18"
                Style="{StaticResource EvaluationCardStyle}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">

                    <TextBlock Text="Month"
                               Style="{StaticResource FieldLabelStyle}" />

                    <ComboBox ItemsSource="{Binding Months,
                                                   Mode=OneWay}"
                              SelectedItem="{Binding SelectedMonth,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernComboBox}" />

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">

                    <TextBlock Text="Year"
                               Style="{StaticResource FieldLabelStyle}" />

                    <ComboBox ItemsSource="{Binding Years,
                                                   Mode=OneWay}"
                              SelectedItem="{Binding SelectedYear,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernComboBox}" />

                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="0,0,12,0">

                    <TextBlock Text="Department"
                               Style="{StaticResource FieldLabelStyle}" />

                    <ComboBox ItemsSource="{Binding Departments, Mode=OneWay}"
                              SelectedItem="{Binding SelectedDepartment,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DepartmentName"
                              TextSearch.TextPath="DepartmentName"
                              IsTextSearchEnabled="True"
                              IsSynchronizedWithCurrentItem="False"
                              Style="{StaticResource ModernComboBox}" />

                </StackPanel>
                <StackPanel Grid.Column="3"
            Margin="0,0,12,0">

                    <TextBlock Text="Search employee"
               Style="{StaticResource FieldLabelStyle}" />

                    <TextBox Text="{Binding SearchText,
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged}"
             ToolTip="Enter employee name"
             Style="{StaticResource EvaluationTextBoxStyle}" />

                </StackPanel>

                <Button Grid.Column="4"
                        Margin="0,23,8,0"
                        MinWidth="90"
                        Content="Search"
                        Command="{Binding SearchCommand,
                                          Mode=OneWay}"
                        Style="{DynamicResource PrimaryButtonStyle}" />

                <Button Grid.Column="5"
                        Margin="0,23,8,0"
                        MinWidth="80"
                        Content="Clear"
                        Command="{Binding ClearSearchCommand,
                                          Mode=OneWay}"
                        Style="{StaticResource EvaluationSecondaryButtonStyle}" />

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- Main content                                              -->
        <!-- ========================================================= -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================================================== -->
            <!-- Employee list                                        -->
            <!-- ===================================================== -->

            <Border Grid.Column="0"
                    Style="{StaticResource EvaluationCardStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Employees"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Border Grid.Column="1"
                                Padding="10,4"
                                CornerRadius="12"
                                Background="{DynamicResource PrimaryBrush}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding TotalEmployees,
                                                          Mode=OneWay}"
                                           Foreground="White"
                                           FontWeight="SemiBold" />

                                <TextBlock Text=" employees"
                                           Foreground="White"
                                           FontWeight="SemiBold" />

                            </StackPanel>

                        </Border>

                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="0,0,0,12"
                               Opacity="0.65"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Select an employee to view or create evaluations." />

                    <Grid Grid.Row="2">

                        <DataGrid ItemsSource="{Binding Employees,
                                                       Mode=OneWay}"
                                  SelectedItem="{Binding SelectedEmployee,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource EvaluationDataGridStyle}"
                                  RowStyle="{StaticResource EvaluationDataGridRowStyle}"
                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                  RowBackground="Transparent">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Employee"
                                                    Width="*"
                                                    Binding="{Binding FullName,
                                                                      Mode=OneWay}"
                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                <DataGridTextColumn Header="Department"
                                                    Width="125"
                                                    Binding="{Binding DepartmentName,
                                                                      Mode=OneWay}"
                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                <DataGridTextColumn Header="Count"
                                                    Width="60"
                                                    Binding="{Binding EvaluationCount,
                                                                      Mode=OneWay}"
                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                            </DataGrid.Columns>

                        </DataGrid>

                        <Border Style="{StaticResource NoEmployeesStyle}"
                                Background="{DynamicResource CardBackgroundBrush}">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="No employees found"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center" />

                                <TextBlock Margin="0,7,0,0"
                                           Opacity="0.65"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Change the search or department filter."
                                           HorizontalAlignment="Center" />

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

            <!-- ===================================================== -->
            <!-- Employee detail panel                                 -->
            <!-- ===================================================== -->

            <Border Grid.Column="2"
                    Style="{StaticResource EvaluationCardStyle}">

                <Grid>

                    <!-- Khi chưa chọn nhân viên -->

                    <Border Style="{StaticResource NoEmployeeSelectedStyle}">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Select an employee"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" />

                            <TextBlock Margin="0,8,0,0"
                                       Opacity="0.65"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Employee details and evaluation history will appear here."
                                       HorizontalAlignment="Center" />

                        </StackPanel>

                    </Border>

                    <!-- Khi đã chọn nhân viên -->

                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Grid Style="{StaticResource EmployeeDetailContentStyle}"
                              Margin="0,0,8,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ============================================= -->
                            <!-- Employee information                          -->
                            <!-- ============================================= -->

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="{Binding SelectedEmployeeName,
                                                              Mode=OneWay}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />

                                    <StackPanel Margin="0,6,0,0"
                                                Orientation="Horizontal">

                                        <TextBlock Text="{Binding SelectedEmployeeDepartment,
                                                                  Mode=OneWay}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Opacity="0.7" />

                                        <TextBlock Margin="8,0"
                                                   Text="•"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Opacity="0.5" />

                                        <TextBlock Text="{Binding SelectedEmployeeRole,
                                                                  Mode=OneWay}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Opacity="0.7" />

                                    </StackPanel>

                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedPeriod,
                                                          Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}" />

                            </Grid>

                            <!-- ============================================= -->
                            <!-- Summary cards                                 -->
                            <!-- ============================================= -->

                            <Grid Grid.Row="1"
                                  Margin="0,0,0,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Padding="14"
                                        Style="{StaticResource EvaluationCardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="Total Reward"
                                                   Style="{StaticResource SummaryLabelStyle}" />

                                        <TextBlock Text="{Binding TotalReward,
                                                                  Mode=OneWay,
                                                                  StringFormat={}{0:N0} VND}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Style="{StaticResource SummaryValueStyle}" />

                                    </StackPanel>

                                </Border>

                                <Border Grid.Column="2"
                                        Padding="14"
                                        Style="{StaticResource EvaluationCardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="Total Penalty"
                                                   Style="{StaticResource SummaryLabelStyle}" />

                                        <TextBlock Text="{Binding TotalPenalty,
                                                                  Mode=OneWay,
                                                                  StringFormat={}{0:N0} VND}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Style="{StaticResource SummaryValueStyle}" />

                                    </StackPanel>

                                </Border>

                                <Border Grid.Column="4"
                                        Padding="14"
                                        Style="{StaticResource EvaluationCardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="Net Adjustment"
                                                   Style="{StaticResource SummaryLabelStyle}" />

                                        <TextBlock Text="{Binding NetAdjustment,
                                                                  Mode=OneWay,
                                                                  StringFormat={}{0:N0} VND}"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   Style="{StaticResource SummaryValueStyle}" />

                                    </StackPanel>

                                </Border>

                                <Border Grid.Column="6"
                                        Padding="14"
                                        Style="{StaticResource EvaluationCardStyle}">

                                    <StackPanel>

                                        <TextBlock Text="Evaluations"
                                                   Style="{StaticResource SummaryLabelStyle}" />

                                        <TextBlock Text="{Binding EvaluationCount,
                                                                  Mode=OneWay}"
                                                   Style="{StaticResource SummaryValueStyle}" />

                                    </StackPanel>

                                </Border>

                            </Grid>

                            <!-- ============================================= -->
                            <!-- Evaluation form                               -->
                            <!-- ============================================= -->

                            <Border Grid.Row="2"
                                    Margin="0,0,0,16"
                                    Style="{StaticResource EvaluationCardStyle}">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,14">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FormTitle,
                                                                  Mode=OneWay}"
                                                   Style="{StaticResource SectionTitleStyle}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">

                                            <TextBlock Text="{Binding CommentLength,
                                                                      Mode=OneWay}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Opacity="0.6" />

                                            <TextBlock Text="/500"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Opacity="0.6" />

                                        </StackPanel>

                                    </Grid>

                                    <Grid Grid.Row="1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="Reward / Penalty"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <ComboBox ItemsSource="{Binding BonusTypes,
                                                                           Mode=OneWay}"
                                                      SelectedItem="{Binding SelectedBonusType,
                                                                            Mode=TwoWay,
                                                                            UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource EvaluationComboBoxStyle}" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="2">

                                            <TextBlock Text="Evaluation Type"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <ComboBox ItemsSource="{Binding EvaluationTypes,
                                                                           Mode=OneWay}"
                                                      SelectedItem="{Binding EvaluationType,
                                                                            Mode=TwoWay,
                                                                            UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      Style="{StaticResource EvaluationComboBoxStyle}" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="4">

                                            <TextBlock Text="Amount"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <TextBox Text="{Binding Amount,
                                                                   Mode=TwoWay,
                                                                   UpdateSourceTrigger=LostFocus,
                                                                   StringFormat={}{0:0}}"
                                                     ToolTip="Enter reward or penalty amount"
                                                     Style="{StaticResource EvaluationTextBoxStyle}" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="6">

                                            <TextBlock Text="Evaluation Date"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <DatePicker SelectedDate="{Binding BonusDate,
                                                                             Mode=TwoWay,
                                                                             UpdateSourceTrigger=PropertyChanged}"
                                                        MinHeight="38"
                                                        Padding="8,4"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" />

                                        </StackPanel>

                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Margin="0,14,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,14,0">

                                            <TextBlock Text="Comment"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <TextBox Text="{Binding Comment,
                                                                   Mode=TwoWay,
                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="80"
                                                     MaxLength="500"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top"
                                                     Style="{StaticResource EvaluationTextBoxStyle}" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Bottom">

                                            <Button MinWidth="145"
                                                    Margin="0,0,0,8"
                                                    Content="{Binding SaveButtonText,
                                                                      Mode=OneWay}"
                                                    Command="{Binding SaveEvaluationCommand,
                                                                      Mode=OneWay}"
                                                    Style="{DynamicResource PrimaryButtonStyle}" />

                                            <Button MinWidth="145"
                                                    Content="Reset Form"
                                                    Command="{Binding ResetFormCommand,
                                                                      Mode=OneWay}"
                                                    Style="{StaticResource EvaluationSecondaryButtonStyle}" />

                                        </StackPanel>

                                    </Grid>

                                </Grid>

                            </Border>

                            <!-- ============================================= -->
                            <!-- Evaluation history                            -->
                            <!-- ============================================= -->

                            <Border Grid.Row="3"
                                    Margin="0,0,0,10"
                                    Style="{StaticResource EvaluationCardStyle}">

                                <Grid MinHeight="320">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="240" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,12">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="Evaluation History"
                                                       Style="{StaticResource SectionTitleStyle}" />

                                            <TextBlock Margin="0,4,0,0"
                                                       Text="View, edit or delete previous evaluations."
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Opacity="0.65" />

                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                MinWidth="125"
                                                VerticalAlignment="Center"
                                                Content="Delete Selected"
                                                Command="{Binding DeleteEvaluationCommand,
                                                                  Mode=OneWay}"
                                                Style="{StaticResource EvaluationDangerButtonStyle}" />

                                    </Grid>

                                    <Grid Grid.Row="1">

                                        <DataGrid ItemsSource="{Binding Evaluations,
                                                                       Mode=OneWay}"
                                                  SelectedItem="{Binding SelectedEvaluation,
                                                                        Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                  MinHeight="220"
                                                  Style="{StaticResource EvaluationDataGridStyle}"
                                                  RowStyle="{StaticResource EvaluationDataGridRowStyle}"
                                                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                                  RowBackground="Transparent">

                                            <DataGrid.Columns>

                                                <DataGridTemplateColumn Header="Type"
                                                                        Width="100">

                                                    <DataGridTemplateColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <Border Style="{StaticResource EvaluationTypeBadgeStyle}"
                                                                    Opacity="0.75"
                                                                    CornerRadius="10"
                                                                    Height="26"
                                                                    Width="86">

                                                                <TextBlock Text="{Binding BonusType,
                                                                                          Mode=OneWay}"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold" />

                                                            </Border>

                                                        </DataTemplate>

                                                    </DataGridTemplateColumn.CellTemplate>

                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Category"
                                                                    Width="140"
                                                                    Binding="{Binding EvaluationType,
                                                                                      Mode=OneWay}"
                                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                                <DataGridTextColumn Header="Amount"
                                                                    Width="140"
                                                                    Binding="{Binding DisplayAmount,
                                                                                      Mode=OneWay}"
                                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                                <DataGridTextColumn Header="Date"
                                                                    Width="110"
                                                                    Binding="{Binding DisplayDate,
                                                                                      Mode=OneWay}"
                                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                                <DataGridTextColumn Header="Comment"
                                                                    Width="*"
                                                                    Binding="{Binding Comment,
                                                                                      Mode=OneWay}"
                                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                            </DataGrid.Columns>

                                        </DataGrid>

                                        <Border Style="{StaticResource NoEvaluationsStyle}"
                                                Background="{DynamicResource CardBackgroundBrush}">

                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="No evaluations"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           HorizontalAlignment="Center" />

                                                <TextBlock Margin="0,7,0,0"
                                                           Opacity="0.65"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="This employee has no evaluations for the selected period."
                                                           HorizontalAlignment="Center" />

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                    <TextBlock Grid.Row="2"
                                               Margin="0,10,0,0"
                                               Opacity="0.6"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="Select an evaluation row to load it into the edit form." />

                                </Grid>

                            </Border>

                        </Grid>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

        <!-- ========================================================= -->
        <!-- Status message                                            -->
        <!-- ========================================================= -->

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="12,9"
                CornerRadius="7"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">

            <TextBlock Text="{Binding StatusMessage,
                                      Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Opacity="0.8" />

        </Border>

        <!-- ========================================================= -->
        <!-- Loading overlay                                           -->
        <!-- ========================================================= -->

        <Border Grid.RowSpan="4"
                Panel.ZIndex="100"
                Style="{StaticResource LoadingOverlayStyle}">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,20"
                    CornerRadius="10"
                    Background="{DynamicResource CardBackgroundBrush}">

                <StackPanel>

                    <ProgressBar Width="220"
                                 Height="6"
                                 IsIndeterminate="True" />

                    <TextBlock Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="Loading evaluation data..." />

                </StackPanel>

            </Border>

        </Border>

    </Grid>

</UserControl>