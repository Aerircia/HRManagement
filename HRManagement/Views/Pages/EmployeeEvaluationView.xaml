<UserControl x:Class="HRManagement.Views.Pages.EmployeeEvaluationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="1450">


    <!-- MAIN LAYOUT -->

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->

        <Grid Grid.Row="0"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Employee Evaluations"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Margin="0,5,0,0"
                           Opacity="0.7"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Manage employee rewards, penalties and evaluation comments." />

            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <TextBlock Text="Selected period"
                           HorizontalAlignment="Right"
                           Opacity="0.65"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Text="{Binding SelectedPeriod,
                                          Mode=OneWay}"
                           HorizontalAlignment="Right"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}" />

            </StackPanel>

        </Grid>

        <!-- Filters (6a: EvaluationCardStyle -> TableCardStyle) -->

        <Border Grid.Row="1"
                Margin="0,0,0,18"
                Padding="18"
                Style="{StaticResource TableCardStyle}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">

                    <TextBlock Text="Search employee"
                               Style="{StaticResource FieldLabelStyle}" />

                    <TextBox Text="{Binding SearchText,
                                           Mode=TwoWay,
                                           UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Enter employee name"
                             Style="{StaticResource FormTextBoxStyle}" />

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">

                    <TextBlock Text="Month"
                               Style="{StaticResource FieldLabelStyle}" />

                    <ComboBox ItemsSource="{Binding Months,
                                                   Mode=OneWay}"
                              SelectedItem="{Binding SelectedMonth,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernComboBox}" />

                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="0,0,12,0">

                    <TextBlock Text="Year"
                               Style="{StaticResource FieldLabelStyle}" />

                    <ComboBox ItemsSource="{Binding Years,
                                                   Mode=OneWay}"
                              SelectedItem="{Binding SelectedYear,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernComboBox}" />

                </StackPanel>

                <StackPanel Grid.Column="3"
                            Margin="0,0,12,0">

                    <TextBlock Text="Department"
                               Style="{StaticResource FieldLabelStyle}" />

                    <ComboBox ItemsSource="{Binding Departments, Mode=OneWay}"
                              SelectedItem="{Binding SelectedDepartment,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DepartmentName"
                              TextSearch.TextPath="DepartmentName"
                              IsTextSearchEnabled="True"
                              IsSynchronizedWithCurrentItem="False"
                              Style="{StaticResource ModernComboBox}" />

                </StackPanel>

                <Button Grid.Column="4"
                        Margin="0,23,8,0"
                        MinWidth="90"
                        Content="Search"
                        Command="{Binding SearchCommand,
                                          Mode=OneWay}"
                        Style="{DynamicResource PrimaryButtonStyle}" />

                <Button Grid.Column="5"
                        Margin="0,23,8,0"
                        MinWidth="80"
                        Content="Clear"
                        Command="{Binding ClearSearchCommand,
                                          Mode=OneWay}"
                        Style="{StaticResource SecondaryButtonStyle}" />

                <Button Grid.Column="6"
                        Margin="0,23,0,0"
                        MinWidth="90"
                        Content="Refresh"
                        Command="{Binding RefreshCommand,
                                          Mode=OneWay}"
                        Style="{StaticResource SecondaryButtonStyle}" />

            </Grid>

        </Border>

        <!-- Main content -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Employee list (6a: EvaluationCardStyle -> TableCardStyle) -->

            <Border Grid.Column="0"
                    Padding="18"
                    Style="{StaticResource TableCardStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,14">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Employees"
                                   Style="{StaticResource SectionTitleStyle}" />

                        <Border Grid.Column="1"
                                Padding="10,4"
                                CornerRadius="12"
                                Background="{DynamicResource PrimaryBrush}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding TotalEmployees,
                                                          Mode=OneWay}"
                                           Foreground="White"
                                           FontWeight="SemiBold" />

                                <TextBlock Text=" employees"
                                           Foreground="White"
                                           FontWeight="SemiBold" />

                            </StackPanel>

                        </Border>

                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="0,0,0,12"
                               Opacity="0.65"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Select an employee to view or create evaluations." />

                    <Grid Grid.Row="2">

                        <DataGrid ItemsSource="{Binding Employees,
                                                       Mode=OneWay}"
                                  SelectedItem="{Binding SelectedEmployee,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="48"
                                  AlternationCount="2"
                                  RowStyle="{StaticResource EmployeeEvaluationRowStyle}"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Employee"
                                                    Width="*"
                                                    Binding="{Binding FullName,
                                                                      Mode=OneWay}"
                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                <DataGridTextColumn Header="Department"
                                                    Width="125"
                                                    Binding="{Binding DepartmentName,
                                                                      Mode=OneWay}"
                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                <DataGridTextColumn Header="Count"
                                                    Width="60"
                                                    Binding="{Binding EvaluationCount,
                                                                      Mode=OneWay}"
                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                            </DataGrid.Columns>

                        </DataGrid>

                        <Border Style="{StaticResource NoEmployeesStyle}"
                                Background="{DynamicResource CardBackgroundBrush}">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="No employees found"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />

                                <TextBlock Margin="0,7,0,0"
                                           Opacity="0.65"
                                           Text="Change the search or department filter."
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                            </StackPanel>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

            <!-- Employee detail panel (6a: EvaluationCardStyle -> TableCardStyle) -->
            <Border Grid.Column="2"
                    Padding="18"
                    Style="{StaticResource TableCardStyle}">

                <Grid>

                    <!-- No employee selected -->

                    <Border Style="{StaticResource NoEmployeeSelectedStyle}">

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Select an employee"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                            <TextBlock Margin="0,8,0,0"
                                       Opacity="0.65"
                                       Text="Employee details and evaluation history will appear here."
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                        </StackPanel>

                    </Border>

                    <!-- Employee selected -->

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Grid Style="{StaticResource EmployeeDetailContentStyle}"
                              Margin="0,0,8,0">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Employee information -->

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="{Binding SelectedEmployeeName,
                                                              Mode=OneWay}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />

                                    <StackPanel Margin="0,6,0,0"
                                                Orientation="Horizontal">

                                        <TextBlock Text="{Binding SelectedEmployeeDepartment,
                                                                  Mode=OneWay}"
                                                   Opacity="0.7"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                        <TextBlock Margin="8,0"
                                                   Text="•"
                                                   Opacity="0.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                        <TextBlock Text="{Binding SelectedEmployeeRole,
                                                                  Mode=OneWay}"
                                                   Opacity="0.7"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                    </StackPanel>

                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedPeriod,
                                                          Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}" />

                            </Grid>

                            <!-- Summary cards -->

                            <Grid Grid.Row="1"
                                  Margin="0,0,0,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource StatCardStyle}">

                                    <Grid>
                                        <Border Style="{StaticResource StatCardAccentStripGreenStyle}"/>
                                        <StackPanel Margin="0,4,0,0">

                                            <TextBlock Text="Total Reward"
                                                       Style="{StaticResource StatCardEyebrowStyle}" />

                                            <TextBlock Text="{Binding TotalReward,
                                                                      Mode=OneWay,
                                                                      StringFormat={}{0:N0} $}"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       Style="{StaticResource StatCardValueStyle}" />

                                        </StackPanel>
                                    </Grid>

                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource StatCardStyle}">

                                    <Grid>
                                        <Border Style="{StaticResource StatCardAccentStripRedStyle}"/>
                                        <StackPanel Margin="0,4,0,0">

                                            <TextBlock Text="Total Penalty"
                                                       Style="{StaticResource StatCardEyebrowStyle}" />

                                            <TextBlock Text="{Binding TotalPenalty,
                                                                      Mode=OneWay,
                                                                      StringFormat={}{0:N0} $}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Style="{StaticResource StatCardValueStyle}" />

                                        </StackPanel>
                                    </Grid>

                                </Border>

                                <Border Grid.Column="4"
                                        Style="{StaticResource StatCardStyle}">

                                    <Grid>
                                        <Border Style="{StaticResource StatCardAccentStripBlueStyle}"/>
                                        <StackPanel Margin="0,4,0,0">

                                            <TextBlock Text="Net Adjustment"
                                                       Style="{StaticResource StatCardEyebrowStyle}" />

                                            <TextBlock Text="{Binding NetAdjustment,
                                                                      Mode=OneWay,
                                                                      StringFormat={}{0:N0} $}"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       Style="{StaticResource StatCardValueStyle}" />

                                        </StackPanel>
                                    </Grid>

                                </Border>

                                <Border Grid.Column="6"
                                        Style="{StaticResource StatCardStyle}">

                                    <Grid>
                                        <!-- No existing color cue for a plain count card -
                                             purple is the "neutral count" precedent set by
                                             ManageKpisView's "KPI Types" card. -->
                                        <Border Style="{StaticResource StatCardAccentStripPurpleStyle}"/>
                                        <StackPanel Margin="0,4,0,0">

                                            <TextBlock Text="Evaluations"
                                                       Style="{StaticResource StatCardEyebrowStyle}" />

                                            <TextBlock Text="{Binding EvaluationCount,
                                                                      Mode=OneWay}"
                                                       Style="{StaticResource StatCardValueStyle}" />

                                        </StackPanel>
                                    </Grid>

                                </Border>

                            </Grid>

                            <!-- Evaluation form -->

                            <Border Grid.Row="2"
                                    Margin="0,0,0,16"
                                    Padding="18"
                                    Style="{StaticResource TableCardStyle}">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,14">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FormTitle,
                                                                  Mode=OneWay}"
                                                   Style="{StaticResource SectionTitleStyle}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">

                                            <TextBlock Text="{Binding CommentLength,
                                                                      Mode=OneWay}"
                                                       Opacity="0.6"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                                            <TextBlock Text="/500"
                                                       Opacity="0.6"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                                        </StackPanel>

                                    </Grid>

                                    <Grid Grid.Row="1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="Reward / Penalty"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <ComboBox ItemsSource="{Binding BonusTypes,
                                                                           Mode=OneWay}"
                                                      SelectedItem="{Binding SelectedBonusType,
                                                                            Mode=TwoWay,
                                                                            UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource ModernComboBox}" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="2">

                                            <TextBlock Text="Evaluation Type"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <ComboBox ItemsSource="{Binding EvaluationTypes,
                                                                           Mode=OneWay}"
                                                      SelectedItem="{Binding EvaluationType,
                                                                            Mode=TwoWay,
                                                                            UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      Style="{StaticResource ModernComboBox}" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="4">

                                            <TextBlock Text="Amount"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <TextBox Text="{Binding Amount,
                                                                   Mode=TwoWay,
                                                                   UpdateSourceTrigger=LostFocus,
                                                                   StringFormat={}{0:0}}"
                                                     ToolTip="Enter reward or penalty amount"
                                                     Style="{StaticResource FormTextBoxStyle}" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="6">

                                            <TextBlock Text="Evaluation Date"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <DatePicker SelectedDate="{Binding BonusDate,
                                                                             Mode=TwoWay,
                                                                             UpdateSourceTrigger=PropertyChanged}"
                                                        Style="{StaticResource PaperDatePickerLineStyle}"
                                                        MinHeight="38"
                                                        Padding="8,4"/>

                                        </StackPanel>

                                    </Grid>

                                    <Grid Grid.Row="2"
                                          Margin="0,14,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,14,0">

                                            <TextBlock Text="Comment"
                                                       Style="{StaticResource FieldLabelStyle}" />

                                            <TextBox Text="{Binding Comment,
                                                                   Mode=TwoWay,
                                                                   UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="80"
                                                     MaxLength="500"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     VerticalContentAlignment="Top"
                                                     Style="{StaticResource EvaluationTextBoxStyle}" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Bottom">

                                            <Button MinWidth="145"
                                                    Margin="0,0,0,8"
                                                    Content="{Binding SaveButtonText,
                                                                      Mode=OneWay}"
                                                    Command="{Binding SaveEvaluationCommand,
                                                                      Mode=OneWay}"
                                                    Style="{DynamicResource PrimaryButtonStyle}" />

                                            <Button MinWidth="145"
                                                    Content="Reset Form"
                                                    Command="{Binding ResetFormCommand,
                                                                      Mode=OneWay}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />

                                        </StackPanel>

                                    </Grid>

                                </Grid>

                            </Border>

                            <!-- Evaluation history -->

                            <Border Grid.Row="3"
                                    Margin="0,0,0,10"
                                    Padding="18"
                                    Style="{StaticResource TableCardStyle}">

                                <Grid MinHeight="320">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="240" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,12">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="Evaluation History"
                                                       Style="{StaticResource SectionTitleStyle}" />

                                            <TextBlock Margin="0,4,0,0"
                                                       Text="View, edit or delete previous evaluations."
                                                       Opacity="0.65"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                MinWidth="125"
                                                VerticalAlignment="Center"
                                                Content="Delete Selected"
                                                ToolTip="Automatic KPI evaluations are read-only"
                                                Command="{Binding DeleteEvaluationCommand,
                                                                  Mode=OneWay}"
                                                Style="{StaticResource EvaluationDangerButtonStyle}" />

                                    </Grid>

                                    <Grid Grid.Row="1">

                                        <DataGrid ItemsSource="{Binding Evaluations,
                                                                       Mode=OneWay}"
                                                  SelectedItem="{Binding SelectedEvaluation,
                                                                        Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                  MinHeight="220"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserResizeRows="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="None"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  RowHeight="48"
                                                  AlternationCount="2"
                                                  RowStyle="{StaticResource EmployeeEvaluationRowStyle}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">

                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                                            </DataGrid.Resources>

                                            <DataGrid.Columns>

                                                <DataGridTemplateColumn Header="Type"
                                                                        Width="100">

                                                    <DataGridTemplateColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <Border Style="{StaticResource EvaluationTypeBadgeStyle}">

                                                                <TextBlock Text="{Binding BonusType,
                                                                                          Mode=OneWay}"
                                                                           Foreground="White"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold" />

                                                            </Border>

                                                        </DataTemplate>

                                                    </DataGridTemplateColumn.CellTemplate>

                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Category"
                                                                    Width="140"
                                                                    Binding="{Binding EvaluationType,
                                                                                      Mode=OneWay}"
                                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                                <DataGridTemplateColumn Header="Source"
                                                                        Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="Automatic KPI"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EvaluationType}"
                                                                                         Value="KPI">
                                                                                <Setter Property="Visibility"
                                                                                        Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Amount"
                                                                    Width="140"
                                                                    Binding="{Binding DisplayAmount,
                                                                                      Mode=OneWay}"
                                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                                <DataGridTextColumn Header="Date"
                                                                    Width="110"
                                                                    Binding="{Binding DisplayDate,
                                                                                      Mode=OneWay}"
                                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                                <DataGridTextColumn Header="Comment"
                                                                    Width="*"
                                                                    Binding="{Binding Comment,
                                                                                      Mode=OneWay}"
                                                                    ElementStyle="{StaticResource TableCellTextStyle}" />

                                            </DataGrid.Columns>

                                        </DataGrid>

                                        <Border Style="{StaticResource NoEvaluationsStyle}"
                                                Background="{DynamicResource CardBackgroundBrush}">

                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">

                                                <TextBlock Text="No evaluations"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />

                                                <TextBlock Margin="0,7,0,0"
                                                           Opacity="0.65"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Text="This employee has no evaluations for the selected period."
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                    <TextBlock Grid.Row="2"
                                               Margin="0,10,0,0"
                                               Opacity="0.6"
                                               Text="Select an evaluation row to load it into the edit form."
                                               Foreground="{DynamicResource SecondaryTextBrush}" />

                                </Grid>

                            </Border>

                        </Grid>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

        <!-- Status message -->

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="12,9"
                CornerRadius="7"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">

            <TextBlock Text="{Binding StatusMessage,
                                      Mode=OneWay}"
                       TextWrapping="Wrap"
                       Opacity="0.8"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

        </Border>

        <!-- Loading overlay -->

        <Border Grid.RowSpan="4"
                Panel.ZIndex="100"
                Style="{StaticResource LoadingOverlayStyle}">

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,20"
                    CornerRadius="10"
                    Background="{DynamicResource CardBackgroundBrush}">

                <StackPanel>

                    <ProgressBar Width="220"
                                 Height="6"
                                 IsIndeterminate="True" />

                    <TextBlock Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Loading evaluation data..."
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

            </Border>

        </Border>

    </Grid>

</UserControl>
