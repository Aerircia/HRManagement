<UserControl x:Class="HRManagement.Views.Pages.ManageAnnouncementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="900"
             Background="{DynamicResource WindowBackgroundBrush}">

    <!--
        "Help Center" board redesign (see reference screenshot): hero icon +
        title, rounded search pill, a purely-visual "All" tab (no type
        filtering/breadcrumb per request), and a single scrollable list of
        announcement rows (date column, title, truncated preview, posted
        meta line). Add/Edit and Delete-confirm overlays are unchanged in
        behavior, restyled to match.

        All styling lives in Resources/AnnouncementBoardStyles.xaml (merged
        in App.xaml) plus the app's existing shared dictionaries
        (TableStyles.xaml, FormStyles.xaml, ButtonStyles.xaml) - no
        UserControl.Resources block here, so the page can never drift from
        the shared brush/style tokens.
    -->

    <Grid>

        <!-- Page content (Admin only) -->
        <Grid Margin="32" Visibility="{Binding HasAccess, Converter={StaticResource BoolToVisibility}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ Hero header ============ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AnnouncementHeroIconBadgeStyle}">
                    <fa:IconBlock Icon="Bullhorn"
                                  Width="24" Height="24"
                                  FontSize="20"
                                  Foreground="{DynamicResource PrimaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Announcements" Style="{StaticResource AnnouncementHeroTitleStyle}"/>
                    <TextBlock Text="Create and manage the company announcement board"
                               Style="{StaticResource AnnouncementHeroSubtitleStyle}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="+ New Announcement"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}"
                        VerticalAlignment="Center"
                        Width="190"/>
            </Grid>

            <!-- ============ Search ============ -->
            <Border Grid.Row="2" Style="{StaticResource AnnouncementSearchContainerStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <fa:IconBlock Grid.Column="0"
                                  Icon="MagnifyingGlass"
                                  Width="14" Height="14"
                                  Margin="0,0,12,0"
                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                  VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource AnnouncementSearchTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search articles"/>
                </Grid>
            </Border>

            <!-- ============ Visual tab strip (All only - no type filter) ============ -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,18,0,0">
                <TextBlock Text="All" Style="{StaticResource AnnouncementTabStyle}"/>
                <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="16,0" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Announcements.Count, StringFormat='{}{0} announcements'}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ============ Announcement list ============ -->
            <Border Grid.Row="5" Style="{StaticResource AnnouncementListCardStyle}">

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Announcements.Count, Converter={StaticResource ZeroToVisibleConverter}, ConverterParameter=Inverse}">
                        <ItemsControl ItemsSource="{Binding AnnouncementsView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AnnouncementRowDividerStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Date column -->
                                            <StackPanel Grid.Column="0" Style="{StaticResource AnnouncementRowDateBadgeStyle}">
                                                <TextBlock Text="{Binding PostedDateDisplay}" Style="{StaticResource AnnouncementRowDayStyle}"/>
                                            </StackPanel>

                                            <!-- Title + preview -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource AnnouncementRowTitleStyle}"/>
                                                    <Border Style="{StaticResource AnnouncementStatusPillStyle}" Margin="10,0,0,0"
                                                            Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                            Opacity="0.85">
                                                        <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Content}" Style="{StaticResource AnnouncementRowPreviewStyle}"/>

                                                <TextBlock Style="{StaticResource AnnouncementRowMetaStyle}">
                                                    <Run Text="{Binding PostedByName, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding PostedDateDisplay, Mode=OneWay}"/>
                                                </TextBlock>

                                            </StackPanel>

                                            <!-- Row actions -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource AnnouncementRowActionButtonStyle}"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <fa:IconBlock Icon="PenToSquare" Width="14" Height="14" Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource AnnouncementRowActionButtonStyle}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="4,0,0,0">
                                                    <fa:IconBlock Icon="TrashCan" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Announcements.Count, Converter={StaticResource ZeroToVisibleConverter}}">
                        <fa:IconBlock Icon="Bullhorn" Width="30" Height="30" Foreground="{DynamicResource HintTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="No announcements yet" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Create your first announcement to see it here."
                                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

        <!-- Access denied (non Admin) -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="360"
                    Visibility="{Binding HasNoAccess, Converter={StaticResource BoolToVisibility}}">

            <Border Width="64" Height="64"
                    CornerRadius="32"
                    Background="{DynamicResource InputBackgroundBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <fa:IconBlock Icon="TriangleExclamation" Width="24" Height="24"
                              Foreground="{DynamicResource DangerBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Access restricted"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Manage Announcements is only available to Admin accounts. Contact your administrator if you believe this is a mistake."
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

        </StackPanel>

        <!-- Add / Edit overlay -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="480"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="{Binding FormTitleText}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="{Binding FormErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasFormError, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="Title" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,14"/>

                    <TextBlock Text="Content" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding FormContent, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextAreaStyle}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Active" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,2"/>
                            <TextBlock Text="Inactive announcements are hidden from the dashboard board."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding FormIsActive}"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelCommand}"/>
                        <Button Grid.Column="2" Content="Save"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}"/>
                    </Grid>

                </StackPanel>

            </Border>
        </Grid>

        <!-- Delete confirmation overlay -->
        <Grid Style="{StaticResource ModalScrimStyle}"
              Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Remove announcement?"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,8"/>

                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20">
                        <Run Text="This will permanently delete"/>
                        <Run Text="{Binding PendingDelete.Title, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text="from the announcement board."/>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDeleteCommand}"/>
                        <Button Grid.Column="2" Content="Delete"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="{DynamicResource DangerBrush}"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </Grid>

                </StackPanel>

            </Border>
        </Grid>

    </Grid>

</UserControl>
