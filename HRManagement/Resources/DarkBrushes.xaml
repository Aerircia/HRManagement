<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========= Brand ========= -->

    <SolidColorBrush x:Key="PrimaryBrush" Color="#3E6BFF"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#2E5BFF"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#608FFF"/>

    <LinearGradientBrush x:Key="SidebarBackgroundBrush"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#1A233A" Offset="0"/>
        <GradientStop Color="#111726" Offset="0.5"/>
        <GradientStop Color="#0B0E17" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========= Accent ========= -->

    <SolidColorBrush x:Key="AccentBrush" Color="#FF9F1A"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#E58A00"/>

    <!-- ========= Background ========= -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0E17"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#151B28"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1F283E"/>

    <!-- ========= Borders ========= -->

    <SolidColorBrush x:Key="BorderBrush" Color="#263147"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1E2738"/>

    <!-- ========= Text ========= -->

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A3AED0"/>
    <SolidColorBrush x:Key="HintTextBrush" Color="#6B7A99"/>

    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>

    <!-- ========= Sidebar ========= -->

    <SolidColorBrush x:Key="SidebarTextBrush" Color="#A3AED0"/>

    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#121D33"/>

    <SolidColorBrush x:Key="SidebarPressedBrush" Color="#1B2845"/>

    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1F2B48"/>

    <!-- ========= Status ========= -->

    <SolidColorBrush x:Key="SuccessBrush" Color="#05CD99"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB547"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EE5D50"/>
    <SolidColorBrush x:Key="OtBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="WeekendBrush" Color="#4A5568"/>

    <!-- ========= DataGrid ========= -->

    <SolidColorBrush x:Key="TableHeaderBrush" Color="#111726"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#1D263A"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#253350"/>

    <!-- ========= Buttons ========= -->

    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#3E6BFF"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#2E5BFF"/>

    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#FF9F1A"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#E58A00"/>

    <!-- Stat Badge Soft Tints (Dark Mode) -->
    <SolidColorBrush x:Key="PrimaryBadgeBrush" Color="#263E6BFF"/>
    <SolidColorBrush x:Key="WarningBadgeBrush" Color="#26FF9F1A"/>
    <SolidColorBrush x:Key="SuccessBadgeBrush" Color="#2605CD99"/>
    <SolidColorBrush x:Key="DangerBadgeBrush" Color="#26EE5D50"/>

</ResourceDictionary>