<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark counterpart of Brushes.xaml. Same key set, so swapping which
        dictionary is merged in App.xaml (see the commented-out line there)
        is the only thing needed to flip themes. Kept in sync with the new
        light palette's hue (blue brand, navy-ish darks) rather than the
        old accent-orange-heavy dark theme.
    -->

    <!-- ========= Brand ========= -->

    <SolidColorBrush x:Key="PrimaryBrush" Color="#5B7FF0"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#3E63DD"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#83A0FF"/>

    <SolidColorBrush x:Key="PrimaryTintBrush" Color="#1B2545"/>

    <LinearGradientBrush x:Key="SidebarBackgroundBrush"
                         StartPoint="0,0"
                         EndPoint="0,1">
        <GradientStop Color="#161B2E" Offset="0"/>
        <GradientStop Color="#11152420" Offset="0.5"/>
        <GradientStop Color="#0D1120" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========= Accent ========= -->

    <SolidColorBrush x:Key="AccentBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#D88F0F"/>

    <!-- ========= Background ========= -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D1120"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161B2E"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E2540"/>

    <!-- ========= Borders ========= -->

    <SolidColorBrush x:Key="BorderBrush" Color="#262E4D"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#1E2540"/>

    <!-- ========= Text ========= -->

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F5FC"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8A93B8"/>
    <SolidColorBrush x:Key="HintTextBrush" Color="#5B6489"/>

    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>

    <!-- ========= Sidebar ========= -->

    <SolidColorBrush x:Key="SidebarTextBrush" Color="#A9B1D6"/>

    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1B2138"/>

    <SolidColorBrush x:Key="SidebarPressedBrush" Color="#232B48"/>

    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#1F2745"/>

    <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="#83A0FF"/>

    <!-- ========= Status ========= -->

    <SolidColorBrush x:Key="SuccessBrush" Color="#22C77E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F1594B"/>
    <SolidColorBrush x:Key="OtBrush" Color="#9678FF"/>
    <SolidColorBrush x:Key="WeekendBrush" Color="#5B6489"/>

    <!-- ========= DataGrid ========= -->

    <SolidColorBrush x:Key="TableHeaderBrush" Color="#11162A"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#1B2138"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#212A4A"/>

    <!-- ========= Buttons ========= -->

    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#5B7FF0"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#3E63DD"/>

    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#D88F0F"/>

    <!-- Stat Badge Soft Tints (Dark Mode) -->
    <SolidColorBrush x:Key="PrimaryBadgeBrush" Color="#265B7FF0"/>
    <SolidColorBrush x:Key="WarningBadgeBrush" Color="#26F5A623"/>
    <SolidColorBrush x:Key="SuccessBadgeBrush" Color="#2622C77E"/>
    <SolidColorBrush x:Key="DangerBadgeBrush" Color="#26F1594B"/>

    <!-- ========= Shadows ========= -->
    <Color x:Key="CardShadowColor">#40000000</Color>

    <!-- ========= Attendance calendar status fills ========= -->
    <!-- Status colors kept close to their light-mode hue but nudged for
         legibility on dark cards. WeekendBgBrush/NeutralBgBrush are the
         important fix here: the light theme's #F3F5FA (near-white) was
         previously the ONLY value that existed (AttendanceResources.xaml
         was never swapped by theme), so weekend/empty cells and their
         date-number/status text were nearly invisible against the dark
         canvas. Now a muted dark-slate fill that still contrasts with
         PrimaryTextBrush/SecondaryTextBrush above it. -->
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#22C77E"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#F1594B"/>
    <SolidColorBrush x:Key="OtBgBrush" Color="#9678FF"/>
    <SolidColorBrush x:Key="DayOffBgBrush" Color="#4C9BC4"/>
    <SolidColorBrush x:Key="WeekendBgBrush" Color="#232B48"/>
    <SolidColorBrush x:Key="NeutralBgBrush" Color="#232B48"/>

    <SolidColorBrush x:Key="StatusHeaderTextBrush" Color="#FFFFFF"/>

</ResourceDictionary>
