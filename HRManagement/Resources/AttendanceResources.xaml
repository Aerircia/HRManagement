<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:util="clr-namespace:HRManagement.Utilities">

    <!-- ========= Converters ========= -->
    <!--
        Key is deliberately AttendanceStatusToBrushConverter, not StatusToBrushConverter.
        Converters.xaml separately defines a key literally named "StatusToBrushConverter"
        for HRManagement.Utilities.StatusToBrushConverter (used by request-status pills
        in RequestsView/ManageRequestsView, e.g. "Approved"/"Rejected"/"Pending"). Since
        both dictionaries are merged app-wide in App.xaml, using the same key name here
        previously caused whichever dictionary merges last (Converters.xaml) to silently
        win, so every attendance calendar cell resolved through the REQUEST converter
        instead of this one - its switch doesn't recognize "Present"/"Late"/"Absent"/
        "OT"/"Weekend", so it fell through to a default brush and every cell rendered
        as the same near-white/neutral color regardless of actual attendance status.
        Giving this converter its own unique key fixes that collision.
    -->
    <util:AttendanceStatusToBrushConverter x:Key="AttendanceStatusToBrushConverter" />

    <!-- ========= Attendance status fills ========= -->
    <!-- The actual SuccessBgBrush/WarningBgBrush/DangerBgBrush/OtBgBrush/
         DayOffBgBrush/WeekendBgBrush/NeutralBgBrush/StatusHeaderTextBrush
         values now live in Brushes.xaml (light) and DarkBrushes.xaml (dark),
         NOT here - this dictionary is merged once, globally, in App.xaml and
         is never swapped when the theme changes (only Brushes.xaml/
         DarkBrushes.xaml are, via SettingService.ApplyTheme), so any brush
         defined only in this file would be frozen at its light-mode value
         forever. AttendanceStatusToBrushConverter and the legend swatches in
         AttendanceCalendarView.xaml still reference these keys via
         DynamicResource - they resolve correctly now because the owning
         dictionary itself gets swapped. -->

    <!-- ========= Month navigation button (the "<" / ">" arrows) ========= -->
    <!-- Round, flat icon button using the app's primary brand color, matching
         the look of icon buttons used elsewhere in the shell (e.g. sidebar). -->

    <Style x:Key="CalendarNavButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PrimaryTintBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="16"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========= Action buttons (Check In / Check Out) ========= -->
    <!-- Base pill-shaped button template shared by the primary (Check In)
         and secondary (Check Out) variants below, reusing the app's
         PrimaryButtonBrush / SecondaryButtonBrush brand colors. -->

    <Style x:Key="AttendanceActionButtonBase" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="19"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckInButtonStyle" TargetType="Button" BasedOn="{StaticResource AttendanceActionButtonBase}">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CheckOutButtonStyle" TargetType="Button" BasedOn="{StaticResource AttendanceActionButtonBase}">
        <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryButtonHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
