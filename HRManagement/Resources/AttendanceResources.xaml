<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:util="clr-namespace:HRManagement.Utilities">

    <!-- ========= Converters ========= -->
    <!--
        Key is deliberately AttendanceStatusToBrushConverter, not StatusToBrushConverter.
        Converters.xaml separately defines a key literally named "StatusToBrushConverter"
        for HRManagement.Utilities.StatusToBrushConverter (used by request-status pills
        in RequestsView/ManageRequestsView, e.g. "Approved"/"Rejected"/"Pending"). Since
        both dictionaries are merged app-wide in App.xaml, using the same key name here
        previously caused whichever dictionary merges last (Converters.xaml) to silently
        win, so every attendance calendar cell resolved through the REQUEST converter
        instead of this one - its switch doesn't recognize "Present"/"Late"/"Absent"/
        "OT"/"Weekend", so it fell through to a default brush and every cell rendered
        as the same near-white/neutral color regardless of actual attendance status.
        Giving this converter its own unique key fixes that collision.
    -->
    <util:AttendanceStatusToBrushConverter x:Key="AttendanceStatusToBrushConverter" />

    <!-- ========= Attendance status fills ========= -->
    <!-- Looked up by key from AttendanceStatusToBrushConverter; also used
         directly by legend swatches so the two never drift out of sync. -->

    <SolidColorBrush x:Key="SuccessBgBrush" Color="#05CD99"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FFA754"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#F26D6D"/>
    <SolidColorBrush x:Key="OtBgBrush" Color="#8E6FE0"/>
    <SolidColorBrush x:Key="WeekendBgBrush" Color="#F4F7FE"/>
    <SolidColorBrush x:Key="NeutralBgBrush" Color="#F4F7FE"/>

    <SolidColorBrush x:Key="StatusHeaderTextBrush" Color="#FFFFFF"/>

    <!-- ========= Month navigation button (the "<" / ">" arrows) ========= -->
    <!-- Round, flat icon button using the app's primary brand color, matching
         the look of icon buttons used elsewhere in the shell (e.g. sidebar). -->

    <Style x:Key="CalendarNavButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="15"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource HintTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========= Action buttons (Check In / Check Out) ========= -->
    <!-- Base pill-shaped button template shared by the primary (Check In)
         and secondary (Check Out) variants below, reusing the app's
         PrimaryButtonBrush / SecondaryButtonBrush brand colors. -->

    <Style x:Key="AttendanceActionButtonBase" TargetType="Button">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="19"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CheckInButtonStyle" TargetType="Button" BasedOn="{StaticResource AttendanceActionButtonBase}">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryButtonHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CheckOutButtonStyle" TargetType="Button" BasedOn="{StaticResource AttendanceActionButtonBase}">
        <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
