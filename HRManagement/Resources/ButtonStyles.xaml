<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Button -->
    <!-- Pill button with a soft brand-colored drop shadow (matches the
         "Add Employee" / "+ Create" CTAs in the reference dashboards)
         instead of a flat fill with no elevation. -->

    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button">

        <Setter Property="Foreground"
                Value="{DynamicResource WhiteBrush}"/>

        <Setter Property="Background"
                Value="{DynamicResource PrimaryButtonBrush}"/>

        <Setter Property="BorderBrush"
                Value="Transparent"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Height"
                Value="42"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Padding"
                Value="30,0"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="21">

                        <Border.Effect>
                            <DropShadowEffect Color="#3E63DD" BlurRadius="16" ShadowDepth="4" Opacity="0.28" Direction="270"/>
                        </Border.Effect>

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{DynamicResource PrimaryButtonHoverBrush}"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="Border"
                                    Property="Opacity"
                                    Value="0.88"/>

                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="Border"
                                    Property="Opacity"
                                    Value="0.45"/>

                            <Setter TargetName="Border"
                                    Property="Effect"
                                    Value="{x:Null}"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- Secondary Button -->
    <!-- Outline style (white fill, brand-colored border/text) rather than a
         solid orange fill - reads as a calmer "second-priority" action next
         to the primary blue pill, matching reference dashboards where the
         secondary/ghost button is outlined, not another loud color. -->

    <Style x:Key="SecondaryButtonStyle"
           TargetType="Button">

        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryBrush}"/>

        <Setter Property="Background"
                Value="{DynamicResource CardBackgroundBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="FontSize"
                Value="14"/>

        <Setter Property="FontWeight"
                Value="SemiBold"/>

        <Setter Property="Height"
                Value="42"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Padding"
                Value="30,0"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="{DynamicResource PrimaryTintBrush}"/>

                            <Setter TargetName="Border"
                                    Property="BorderBrush"
                                    Value="{DynamicResource PrimaryBrush}"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="Border"
                                    Property="Opacity"
                                    Value="0.85"/>

                        </Trigger>

                        <Trigger Property="IsEnabled"
                                 Value="False">

                            <Setter TargetName="Border"
                                    Property="Opacity"
                                    Value="0.45"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- Window Circle Button (Minimize) -->

    <Style x:Key="WindowCircleButtonStyle"
           TargetType="Button">

        <Setter Property="Width"
                Value="28"/>

        <Setter Property="Height"
                Value="28"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Background"
                Value="#14000000"/>

        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryTextBrush}"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="FontWeight"
                Value="Bold"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="#22000000"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="Border"
                                    Property="Opacity"
                                    Value="0.8"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- Close Button -->

    <Style x:Key="CloseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource WindowCircleButtonStyle}">

        <Setter Property="Background"
                Value="{DynamicResource DangerBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource WhiteBrush}"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                                 Value="True">

                            <Setter TargetName="Border"
                                    Property="Background"
                                    Value="#D63C30"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                                 Value="True">

                            <Setter TargetName="Border"
                                    Property="Opacity"
                                    Value="0.8"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <!-- Sidebar Navigation Button -->
    <!-- Selected/hover states render as a soft blue pill with blue text
         (SidebarSelectedBrush/SidebarSelectedTextBrush) since the sidebar
         itself is now a light surface, not a dark gradient. The active page
         is resolved via a MultiBinding (NavItemBrushConverter) comparing
         SidebarViewModel.CurrentPageType against each button's own
         CommandParameter, so Background/Foreground reflect the selected
         page without any per-button DataTrigger boilerplate in Sidebar.xaml.
         Hover/pressed still layer on top via the template triggers below. -->

    <Style x:Key="NavigationButtonStyle"
       TargetType="Button">

        <Setter Property="Height"
            Value="44"/>

        <Setter Property="Margin"
            Value="0,3"/>

        <Setter Property="Padding"
            Value="15,0"/>

        <Setter Property="HorizontalContentAlignment"
            Value="Stretch"/>

        <Setter Property="VerticalContentAlignment"
            Value="Center"/>

        <Setter Property="BorderThickness"
            Value="0"/>

        <Setter Property="Cursor"
            Value="Hand"/>

        <Setter Property="FontSize"
            Value="14"/>

        <Setter Property="FontWeight"
            Value="SemiBold"/>

        <!-- Selected state: compares the DataContext's CurrentPageType
             (SidebarViewModel) against this button's own CommandParameter
             (the page's ViewModel Type, e.g. {x:Type vm:DashboardViewModel})
             so the active nav item renders as a soft blue pill with blue
             text instead of every item looking identical. Falls back to
             Transparent/SidebarTextBrush when nothing matches (including
             design-time, where CurrentPageType may not resolve). -->

        <Setter Property="Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource NavItemBrushConverter}" ConverterParameter="Background">
                    <Binding Path="CurrentPageType"/>
                    <Binding RelativeSource="{RelativeSource Self}" Path="CommandParameter"/>
                </MultiBinding>
            </Setter.Value>
        </Setter>

        <Setter Property="Foreground">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource NavItemBrushConverter}" ConverterParameter="Foreground">
                    <Binding Path="CurrentPageType"/>
                    <Binding RelativeSource="{RelativeSource Self}" Path="CommandParameter"/>
                </MultiBinding>
            </Setter.Value>
        </Setter>

        <!-- Left accent bar shown only on the active nav item, using the
             same NavItemBrushConverter/CurrentPageType comparison already
             driving Background/Foreground above - reuses that MultiBinding
             rather than adding a second comparison mechanism. Returns a 3
             on match / 0 otherwise via ConverterParameter="AccentBar" (new
             mode on the existing converter), so inactive items render with
             no bar at all instead of a transparent one (avoids any layout
             shift from an invisible-but-present border). -->
        <Setter Property="Tag">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource NavItemBrushConverter}" ConverterParameter="AccentBar">
                    <Binding Path="CurrentPageType"/>
                    <Binding RelativeSource="{RelativeSource Self}" Path="CommandParameter"/>
                </MultiBinding>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Grid>

                        <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">

                            <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <!-- Active-item indicator: 3px solid bar flush to
                             the left edge, corner-radius 0 per the "no
                             rounded corners on single-sided borders" rule -
                             a rounded single edge reads as a rendering
                             glitch, not an accent. Width is bound to Tag
                             (0 or 3) so it only occupies space when active;
                             sitting outside Border above so it isn't
                             clipped by the pill's own CornerRadius="10". -->
                        <Border x:Name="AccentBar"
                                Width="{TemplateBinding Tag}"
                                CornerRadius="0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource PrimaryBrush}"
                                Margin="0,6"/>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="Border"
                                Property="Background"
                                Value="{DynamicResource SidebarHoverBrush}"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                             Value="True">

                            <Setter TargetName="Border"
                                Property="Background"
                                Value="{DynamicResource SidebarSelectedBrush}"/>

                        </Trigger>

                        <Trigger Property="IsEnabled"
                             Value="False">

                            <Setter Property="Opacity"
                                Value="0.45"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <Style x:Key="TopBarIconButtonStyle"
       TargetType="Button">

        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="Border"
                        Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="{TemplateBinding Background}">

                        <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="Border"
                                Property="Background"
                                Value="{DynamicResource InputBackgroundBrush}"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                             Value="True">

                            <Setter TargetName="Border"
                                Property="Background"
                                Value="{DynamicResource PrimaryTintBrush}"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

    <!-- Shell-specific icon button (TopBar notification/support/logout,
         TitleBar minimize/maximize/close): same shape/template as
         TopBarIconButtonStyle but with ShellIconHoverBrush instead of
         InputBackgroundBrush/PrimaryTintBrush, since those are tuned for
         white card backgrounds and would be invisible against the
         saturated-blue shell. Kept as a separate style rather than
         repointing TopBarIconButtonStyle itself, because that style is
         also reused on white-card content elsewhere (e.g. RequestsView's
         back button) where the card-safe hover colors are still correct. -->
    <Style x:Key="ShellIconButtonStyle"
       TargetType="Button">

        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border x:Name="Border"
                        Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="{TemplateBinding Background}">

                        <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver"
                             Value="True">

                            <Setter TargetName="Border"
                                Property="Background"
                                Value="{DynamicResource ShellIconHoverBrush}"/>

                        </Trigger>

                        <Trigger Property="IsPressed"
                             Value="True">

                            <Setter TargetName="Border"
                                Property="Background"
                                Value="{DynamicResource ShellIconHoverBrush}"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>
