<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>

    <!-- Background -->
    <Color x:Key="BackgroundColor">#F5F7FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>

    <!-- Border -->
    <Color x:Key="BorderColor">#D9DCE3</Color>

    <!-- Text -->
    <Color x:Key="PrimaryTextColor">#1F2937</Color>
    <Color x:Key="SecondaryTextColor">#6B7280</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>

</ResourceDictionary>