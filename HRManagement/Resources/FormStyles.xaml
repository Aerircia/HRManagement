<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================
        Shared "Add / Edit" form field styles.
        ============================================================
        Consolidated (Phase 2 step 3): ManageProfilesView, ManageContractsView,
        ManageAnnouncementsView, and ProfileView previously each defined their
        own near-identical local copies of FormLabelStyle / FormTextBoxStyle /
        FormComboBoxStyle / FormDatePickerStyle inside UserControl.Resources.
        Those local copies have been removed from all four views; the plain
        "FormXxxStyle" keys below (merged once in App.xaml) are now the only
        definitions, so every Add/Edit form in the app renders identically
        without four copies drifting independently. Keeping the plain
        (non-"Shared"-prefixed) key names means each view's body markup -
        e.g. Style="{StaticResource FormLabelStyle}" - needed zero changes
        beyond deleting the local <Style> blocks.

        Modernized here: soft input fill, no border by default (matches the
        reference dashboards' minimal search/inputs), focus-friendly
        contrast, rounded 10px corners.
    -->

    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Multi-line variant (Content/Description/Comment fields) -->
    <Style x:Key="FormTextAreaStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
        <Setter Property="Height" Value="120"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="12,10"
                                      VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FormDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Shared overlay/dialog surface used by Add/Edit and Delete-confirm
         popups (ManageProfilesView, ManageContractsView,
         ManageAnnouncementsView all build this by hand today via
         SurfaceCardStyle + a manual semi-transparent Grid background). -->
    <Style x:Key="ModalScrimStyle" TargetType="Grid">
        <Setter Property="Background" Value="#59131A33"/>
    </Style>

</ResourceDictionary>
