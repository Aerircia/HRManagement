<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================
        Shared "Add / Edit" form field styles.
        ============================================================
        ManageProfilesView, ManageContractsView, ManageAnnouncementsView,
        and ProfileView each currently define their own near-identical copies
        of FormLabelStyle / FormTextBoxStyle / FormComboBoxStyle /
        FormDatePickerStyle inside UserControl.Resources. Those page-local
        copies still take precedence (WPF resource lookup resolves the
        nearest ancestor first), so nothing below changes any existing page
        today - this file exists so those pages can be pointed at ONE
        shared, modernized definition in a future pass instead of four
        copies drifting independently. Merged in App.xaml as an additive,
        non-breaking dictionary.

        Modernized here: soft input fill, no border by default (matches the
        reference dashboards' minimal search/inputs), focus-friendly
        contrast, rounded 10px corners.
    -->

    <Style x:Key="SharedFormLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="SharedFormTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Multi-line variant (Content/Description/Comment fields) -->
    <Style x:Key="SharedFormTextAreaStyle" TargetType="TextBox" BasedOn="{StaticResource SharedFormTextBoxStyle}">
        <Setter Property="Height" Value="120"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="12,10"
                                      VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SharedFormComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SharedFormDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Shared overlay/dialog surface used by Add/Edit and Delete-confirm
         popups (ManageProfilesView, ManageContractsView,
         ManageAnnouncementsView all build this by hand today via
         SurfaceCardStyle + a manual semi-transparent Grid background). -->
    <Style x:Key="ModalScrimStyle" TargetType="Grid">
        <Setter Property="Background" Value="#59131A33"/>
    </Style>

</ResourceDictionary>
