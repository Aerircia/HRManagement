<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Summary card -->

    <Style x:Key="SummaryCardBorderStyle"
        TargetType="Border">
        <Setter Property="Background"
             Value="{DynamicResource CardBackgroundBrush}" />

        <Setter Property="BorderBrush"
             Value="{DynamicResource BorderBrush}" />

        <Setter Property="BorderThickness"
             Value="1" />

        <Setter Property="CornerRadius"
             Value="12" />

        <Setter Property="Padding"
             Value="18" />

        <Setter Property="Margin"
             Value="0,0,12,0" />
    </Style>

    <!-- Section card -->

    <Style x:Key="SectionCardBorderStyle"
        TargetType="Border">
        <Setter Property="Background"
             Value="{DynamicResource CardBackgroundBrush}" />

        <Setter Property="BorderBrush"
             Value="{DynamicResource BorderBrush}" />

        <Setter Property="BorderThickness"
             Value="1" />

        <Setter Property="CornerRadius"
             Value="12" />

        <Setter Property="Padding"
             Value="20" />
    </Style>

    <!-- Labels and headers -->

    <Style x:Key="FieldLabelStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize"
             Value="12" />

        <Setter Property="FontWeight"
             Value="SemiBold" />

        <Setter Property="Foreground"
             Value="{DynamicResource SecondaryTextBrush}" />

        <Setter Property="Opacity"
             Value="0.7" />

        <Setter Property="Margin"
             Value="0,0,0,6" />
    </Style>

    <Style x:Key="SectionTitleStyle"
        TargetType="TextBlock">
        <Setter Property="FontSize"
             Value="17" />

        <Setter Property="FontWeight"
             Value="SemiBold" />

        <Setter Property="Foreground"
             Value="{DynamicResource PrimaryTextBrush}" />

        <Setter Property="Margin"
             Value="0,0,0,16" />
    </Style>

    <!-- Input controls -->

    <!-- ComboBox / Buttons Uses the project's shared ModernComboBox
      and PrimaryButtonStyle/SecondaryButtonStyle (Resources/ButtonStyles.xaml)
      instead of page-local styles, so this page matches the rest of the app.
      The project has no shared "danger" button, so this local style reuses
      PrimaryButtonStyle's pill shape/template but swaps in DangerBrush. -->

    <Style x:Key="DangerButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource PrimaryButtonStyle}">

        <Setter Property="Background"
             Value="{DynamicResource DangerBrush}" />

    </Style>

    <!-- Summary card accent strip (Task 5, minimal option)
        Color mapping is an interpretation, not a literal application
        of "match the icon badge color" - these summary cards have no
        icon badges at all, only colored value text, so the value
        text's existing accent color is used as the closest analog:
        Total Employees          -> neutral/PrimaryTextBrush -> blue
        Payroll Created          -> SuccessBrush             -> green
        Payroll Pending          -> DangerBrush              -> red
        Estimated Monthly Salary -> PrimaryBrush             -> blue
      Flagging this substitution per UI_FIX_TASKS.md Task 5's own
      instruction to flag rather than silently resolve it. -->
    <Style x:Key="SummaryCardAccentStripStyle"
        TargetType="Border">
        <Setter Property="Height" Value="4"/>
        <Setter Property="CornerRadius" Value="12,12,0,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="-18,-18,-18,0"/>
    </Style>

    <Style x:Key="SummaryCardAccentStripBlueStyle" TargetType="Border" BasedOn="{StaticResource SummaryCardAccentStripStyle}">
        <Setter Property="Background" Value="{DynamicResource CardAccentBlueBrush}"/>
    </Style>

    <Style x:Key="SummaryCardAccentStripGreenStyle" TargetType="Border" BasedOn="{StaticResource SummaryCardAccentStripStyle}">
        <Setter Property="Background" Value="{DynamicResource CardAccentGreenBrush}"/>
    </Style>

    <Style x:Key="SummaryCardAccentStripRedStyle" TargetType="Border" BasedOn="{StaticResource SummaryCardAccentStripStyle}">
        <Setter Property="Background" Value="{DynamicResource CardAccentRedBrush}"/>
    </Style>



    <!-- =====================================================
      Payroll status badge
      ===================================================== -->

    <Style x:Key="PayrollStatusBadgeStyle"
        TargetType="Border">
        <Setter Property="CornerRadius"
             Value="10" />

        <Setter Property="Padding"
             Value="9,4" />

        <Setter Property="HorizontalAlignment"
             Value="Center" />

        <Setter Property="Background"
             Value="{DynamicResource DangerBrush}" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsPayrollCreated}"
                      Value="True">
                <Setter Property="Background"
                     Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>

        </Style.Triggers>
    </Style>

    <!-- =====================================================
      Validation text
      ===================================================== -->

    <Style x:Key="ValidationMessageStyle"
        TargetType="TextBlock">
        <Setter Property="Foreground"
             Value="{DynamicResource DangerBrush}" />

        <Setter Property="FontSize"
             Value="12" />

        <Setter Property="TextWrapping"
             Value="Wrap" />

        <Setter Property="Visibility"
             Value="Collapsed" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding HasValidationError}"
                      Value="True">
                <Setter Property="Visibility"
                     Value="Visible" />
            </DataTrigger>

        </Style.Triggers>
    </Style>

    <!-- =====================================================
      DataGrid
      ===================================================== -->

    <Style x:Key="ManageSalaryDataGridStyle"
        TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns"
             Value="False" />

        <Setter Property="CanUserAddRows"
             Value="False" />

        <Setter Property="CanUserDeleteRows"
             Value="False" />

        <Setter Property="CanUserResizeRows"
             Value="False" />

        <Setter Property="IsReadOnly"
             Value="True" />

        <Setter Property="SelectionMode"
             Value="Single" />

        <Setter Property="SelectionUnit"
             Value="FullRow" />

        <Setter Property="HeadersVisibility"
             Value="Column" />

        <Setter Property="GridLinesVisibility"
             Value="Horizontal" />

        <Setter Property="HorizontalGridLinesBrush"
             Value="{DynamicResource BorderBrush}" />

        <Setter Property="VerticalGridLinesBrush"
             Value="Transparent" />

        <Setter Property="BorderBrush"
             Value="{DynamicResource BorderBrush}" />

        <Setter Property="BorderThickness"
             Value="1" />

        <Setter Property="Background"
             Value="{DynamicResource CardBackgroundBrush}" />

        <Setter Property="RowHeight"
             Value="56" />

        <Setter Property="ColumnHeaderHeight"
             Value="48" />

        <Setter Property="AlternationCount"
             Value="2" />

        <Setter Property="CanUserResizeColumns"
             Value="True" />

        <Setter Property="MinColumnWidth"
             Value="45" />
    </Style>

    <Style x:Key="ManageSalaryDataGridCellStyle"
        TargetType="DataGridCell">
        <Setter Property="Padding"
             Value="10,5" />

        <Setter Property="VerticalContentAlignment"
             Value="Center" />

        <Setter Property="HorizontalContentAlignment"
             Value="Center" />

        <Setter Property="Background"
             Value="Transparent" />

        <Setter Property="Foreground"
             Value="{DynamicResource PrimaryTextBrush}" />

        <Setter Property="BorderThickness"
             Value="0" />

        <Setter Property="FocusVisualStyle"
             Value="{x:Null}" />
    </Style>

    <Style x:Key="ManageSalaryColumnHeaderStyle"
        TargetType="DataGridColumnHeader">
        <Setter Property="FontWeight"
             Value="SemiBold" />

        <Setter Property="Padding"
             Value="10,5" />

        <Setter Property="HorizontalContentAlignment"
             Value="Left" />

        <Setter Property="VerticalContentAlignment"
             Value="Center" />

        <Setter Property="Background"
             Value="{DynamicResource CardBackgroundBrush}" />

        <Setter Property="Foreground"
             Value="{DynamicResource SecondaryTextBrush}" />

        <Setter Property="BorderBrush"
             Value="{DynamicResource BorderBrush}" />

        <Setter Property="BorderThickness"
             Value="0,0,0,1" />
    </Style>

    <!-- =====================================================
      Loading overlay visibility
      ===================================================== -->

    <Style x:Key="LoadingOverlayStyle"
        TargetType="Border">
        <Setter Property="Visibility"
             Value="Collapsed" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsLoading}"
                      Value="True">
                <Setter Property="Visibility"
                     Value="Visible" />
            </DataTrigger>

        </Style.Triggers>
    </Style>

    <!-- =====================================================
      Empty state visibility
      ===================================================== -->

    <Style x:Key="EmptyStateStyle"
        TargetType="StackPanel">
        <Setter Property="Visibility"
             Value="Collapsed" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding HasData}"
                      Value="False">

                <Setter Property="Visibility"
                     Value="Visible" />

            </DataTrigger>

            <DataTrigger Binding="{Binding IsLoading}"
                      Value="True">

                <Setter Property="Visibility"
                     Value="Collapsed" />

            </DataTrigger>

        </Style.Triggers>
    </Style>
    
</ResourceDictionary>