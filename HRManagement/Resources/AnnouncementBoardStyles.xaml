<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================
        Manage Announcements - "Help Center" board redesign
        ============================================================
        Styles for the read-style announcement board layout (large hero
        icon + title, rounded search pill, tab strip, list of announcement
        rows with a title + truncated preview + posted date). Built purely
        from the app's existing brand tokens (Brushes.xaml / DarkBrushes.xaml)
        so it automatically follows the light/dark theme toggle - no new
        hex colors are introduced here.

        Merged once at the app level (App.xaml), same pattern as
        ManageRequestsStyles.xaml / RequestFormStyles.xaml, so no
        UserControl.Resources block is needed in ManageAnnouncementsView.xaml.
    -->

    <!-- ========= Hero header (icon badge + title + subtitle) ========= -->

    <Style x:Key="AnnouncementHeroIconBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryTintBrush}"/>
    </Style>

    <Style x:Key="AnnouncementHeroTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style x:Key="AnnouncementHeroSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- ========= Search pill (rounded, icon-leading, matches reference) ========= -->

    <Style x:Key="AnnouncementSearchContainerStyle" TargetType="Border">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="18,0"/>
    </Style>

    <Style x:Key="AnnouncementSearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <!-- ========= Tab strip (All / News / Activities look) ========= -->
    <!-- A single "All announcements" indicator tab - kept purely visual,
         since the page intentionally has no type filtering/breadcrumb. -->

    <Style x:Key="AnnouncementTabStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Padding" Value="0,0,0,12"/>
    </Style>

    <!-- ========= Announcement list row ========= -->

    <Style x:Key="AnnouncementRowDateBadgeStyle" TargetType="StackPanel">
        <Setter Property="Width" Value="64"/>
    </Style>

    <Style x:Key="AnnouncementRowDayStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
    </Style>

    <Style x:Key="AnnouncementRowTimeStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="AnnouncementRowTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="AnnouncementRowPreviewStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="AnnouncementRowMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource HintTextBrush}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="AnnouncementRowDividerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,18"/>
    </Style>

    <!-- Row action buttons (edit / delete), shown on hover-friendly icon
         buttons reusing the shared RowIconButtonStyle look but sized to sit
         beside the list row instead of inside a DataGrid cell. -->
    <Style x:Key="AnnouncementRowActionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" CornerRadius="9" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small status pill kept beside the title for Active/Inactive, reusing
         the app's badge brushes. -->
    <Style x:Key="AnnouncementStatusPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBadgeBrush}"/>
    </Style>

    <!-- ========= Card container for the whole list (soft shadow, rounded) ========= -->

    <Style x:Key="AnnouncementListCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="24,4"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource CardShadowColor}" BlurRadius="22" ShadowDepth="3" Opacity="0.06" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
