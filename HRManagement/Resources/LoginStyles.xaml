<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========= Login-specific brushes ========= -->

    <!-- Diagonal blue panel gradient (top-left lighter brand blue to
         bottom-right deeper brand blue), matching the reference image's
         right-hand wavy panel. Built from PrimaryLightBrush/PrimaryBrush/
         PrimaryDarkBrush colors rather than new one-off hex values. -->
    <LinearGradientBrush x:Key="LoginPanelGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B82F2" Offset="0"/>
        <GradientStop Color="#3E63DD" Offset="0.55"/>
        <GradientStop Color="#2947B8" Offset="1"/>
    </LinearGradientBrush>

    <!-- Soft white text/icon tone used over the blue panel for secondary
         copy (subtitle, footer), distinct from WhiteBrush's full-opacity
         headings. -->
    <SolidColorBrush x:Key="LoginOnPanelMutedBrush" Color="#D7E1FB"/>

    <!-- ========= Window chrome buttons (minimize / close) ========= -->
    <!-- Rounded ghost buttons that pick up a soft tint on hover instead of
         the previous flat semi-transparent black circles, so they read as
         intentional UI rather than an afterthought. -->

    <Style x:Key="LoginWindowButtonStyle" TargetType="Button">

        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="17">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Close button: same ghost treatment, but hover/pressed states shift
         to the app's DangerBrush so intent (destructive) is unambiguous,
         instead of the old solid-red-circle-always look. -->
    <Style x:Key="LoginCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource LoginWindowButtonStyle}">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="17">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D63C30"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- ========= Sign-in card input fields (username / password) ========= -->
    <!-- Pill-shaped, icon-leading inputs matching the reference card, built
         on the app's existing InputBackgroundBrush/BorderBrush tokens
         rather than new ones. -->

    <Style x:Key="LoginInputContainerStyle" TargetType="Border">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="23"/>
    </Style>

    <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>

    <!-- Pill-shaped variant of BindablePasswordBox's container, applied via
         a Border wrapper in the view since BindablePasswordBox already owns
         its own internal Border - see LoginWindow.xaml for usage notes. -->
    <Style x:Key="LoginPasswordHostStyle" TargetType="Border">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="23"/>
    </Style>

    <!-- ========= Primary login button (pill, full width of card) ========= -->
    <!-- Distinct key from the app-wide PrimaryButtonStyle (kept separate on
         purpose: this one is intentionally full-width/taller to match the
         reference "Login" button proportions) but shares the same brand
         color + shadow language as PrimaryButtonStyle in ButtonStyles.xaml. -->

    <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">

        <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="23">

                        <Border.Effect>
                            <DropShadowEffect Color="#3E63DD" BlurRadius="18" ShadowDepth="5" Opacity="0.30" Direction="270"/>
                        </Border.Effect>

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- "Forgot password?" link-style button -->
    <Style x:Key="LoginLinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
