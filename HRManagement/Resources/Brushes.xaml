<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================
        ENERPIZE-STYLE LIGHT THEME - "White / Light-Blue" token set
        ============================================================
        Palette reference: soft white/light-blue admin dashboards
        (see design refs: Enerpize/Folkd/Checkdo style dashboards).

        Design tokens:
          Brand blue   #3E63DD  (vivid but not neon - reads as "product blue")
          Brand deep   #2947B8  (hover/pressed)
          Brand tint   #EEF2FF  (selected/soft backgrounds)
          Surface      #FFFFFF  (cards)
          Canvas       #F5F7FB  (window/app background - cool near-white)
          Ink          #1B2559  (primary text - deep navy, not pure black)
          Muted ink    #8A93B8  (secondary text)
          Hairline     #E7EBF5  (borders/dividers)

        Status colors kept close to the original app (green/amber/red/violet)
        but slightly desaturated to sit quietly against the lighter canvas.
    -->

    <!-- ========= Brand ========= -->

    <SolidColorBrush x:Key="PrimaryBrush" Color="#3E63DD"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#2947B8"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#6C8AF0"/>

    <!-- Soft brand tint, used for selected pills / icon badges over white -->
    <SolidColorBrush x:Key="PrimaryTintBrush" Color="#EEF2FF"/>

    <!-- Real saturated echo of LoginWindow's LoginPanelGradientBrush
         (#5B82F2/#3E63DD/#2947B8), used for the app shell (Sidebar/TopBar/
         TitleBar) so the product identity established at login actually
         carries through into the signed-in app.

         Earlier version of these tokens diluted the login gradient down
         to near-white pastel tints (#EEF2FF-#DAE3FA) - at that lightness
         it lost all "blue-ness" and just read as another shade of gray
         next to white page cards, and all three shell regions used the
         same values, so there was no depth differentiation between them
         either. This version uses the login panel's actual saturation and
         gives each region a distinct tone so the shell reads with real
         presence: TitleBarBackgroundBrush darkest (topmost, sets the
         anchor), ShellChromeGradientBrush (TopBar) mid-tone,
         SidebarBackgroundBrush lightest/fullest diagonal expression
         (largest surface, closest analog to the login panel itself).

         Because these are now real saturated blues, shell text/icons
         switch to light/white variants (see SidebarTextBrush etc. below)
         instead of the dark-navy text that worked on the old pastel
         version. -->
    <LinearGradientBrush x:Key="TitleBarBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2947B8" Offset="0"/>
        <GradientStop Color="#233E9E" Offset="0.6"/>
        <GradientStop Color="#1D3486" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShellChromeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3757CC" Offset="0"/>
        <GradientStop Color="#2E4CB8" Offset="0.6"/>
        <GradientStop Color="#2947B8" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Sidebar gets the fullest, most diagonal gradient of the three
         chrome regions (four stops vs. three, wider hue swing) since it's
         the largest continuous shell surface and the one closest in
         spirit to LoginWindow's own panel gradient. -->
    <LinearGradientBrush x:Key="SidebarBackgroundBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#4A6EE0" Offset="0"/>
        <GradientStop Color="#3E63DD" Offset="0.4"/>
        <GradientStop Color="#2E4EB8" Offset="0.75"/>
        <GradientStop Color="#243F9E" Offset="1"/>
    </LinearGradientBrush>
    <!-- ========= Accent (secondary brand - warm, used sparingly) ========= -->

    <SolidColorBrush x:Key="AccentBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#D88F0F"/>

    <!-- ========= Background ========= -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F3F5FA"/>

    <!-- Subtle diagonal wash for the page canvas behind content (Border
         wrapping ContentControl in MainWindow.xaml) - muted echo of the
         LoginWindow's blue panel gradient so the app doesn't feel like a
         different product once you're past the login screen. Kept very
         light (all three stops are near-white/near-canvas) so it reads as
         gentle depth, not a colored background fighting the cards on it. -->
    <LinearGradientBrush x:Key="PageCanvasBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F6F8FD" Offset="0"/>
        <GradientStop Color="#ECF0FB" Offset="0.55"/>
        <GradientStop Color="#E7ECFA" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========= Card accent strips ========= -->
    <!-- Top-border color coding for stat/summary cards (PTO=blue,
         Compensation/success=green, Tenure/warning=amber, Performance/
         danger=red) - same hues as the existing status brushes below, so
         a card's accent strip always matches its own status pill/badge
         color rather than introducing a second unrelated palette. -->
    <SolidColorBrush x:Key="CardAccentBlueBrush" Color="#3E63DD"/>
    <SolidColorBrush x:Key="CardAccentGreenBrush" Color="#12B76A"/>
    <SolidColorBrush x:Key="CardAccentAmberBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="CardAccentRedBrush" Color="#F04438"/>
    <SolidColorBrush x:Key="CardAccentPurpleBrush" Color="#7C5CFC"/>

    <!-- ========= Borders ========= -->

    <SolidColorBrush x:Key="BorderBrush" Color="#E7EBF5"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#EDF0F8"/>

    <!-- ========= Text ========= -->

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B2559"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8A93B8"/>
    <SolidColorBrush x:Key="HintTextBrush" Color="#B7BEDA"/>

    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>

    <!-- ========= Shell text (TopBar/TitleBar on saturated blue) ========= -->
    <!-- PrimaryTextBrush/SecondaryTextBrush/DividerBrush above are tuned
         for white card backgrounds and are unreadable against the real
         saturated blue ShellChromeGradientBrush/TitleBarBackgroundBrush
         now in use - these are the on-shell equivalents, applied directly
         in TopBar.xaml/TitleBar.xaml rather than changing the general
         tokens (which are still correct everywhere else in the app). -->
    <SolidColorBrush x:Key="ShellTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ShellSecondaryTextBrush" Color="#C7D2F5"/>
    <SolidColorBrush x:Key="ShellDividerBrush" Color="#FFFFFF" Opacity="0.18"/>
    <SolidColorBrush x:Key="ShellIconHoverBrush" Color="#FFFFFF" Opacity="0.12"/>

    <!-- ========= Sidebar (saturated blue surface, light text, white
         active-state indicator) ========= -->
    <!-- Flipped from dark-navy-text-on-pastel to light-text-on-saturated-
         blue now that SidebarBackgroundBrush above is a real blue gradient
         rather than a near-white tint - #5B6489 dark text had roughly
         1.3:1 contrast against the new background and was effectively
         unreadable. -->

    <!-- Inactive nav item text/icon: translucent white rather than solid,
         so the active item's solid white text still reads as a clear step
         up in emphasis. -->
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#C7D2F5"/>

    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#FFFFFF" Opacity="0.10"/>

    <SolidColorBrush x:Key="SidebarPressedBrush" Color="#FFFFFF" Opacity="0.16"/>

    <!-- Selected nav item: translucent white pill (works on a real dark-
         blue surface, unlike the previous solid near-white fill which
         depended on a light sidebar background to read as a "tint"). -->
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#FFFFFF" Opacity="0.16"/>

    <!-- Text color on the active/selected nav item: solid white, paired
         with the left accent bar (PrimaryBrush) added via
         NavItemBrushConverter's AccentBar mode - the combination of
         solid-white text + translucent pill + white accent bar is the
         active-state signal now, replacing the old blue-text-on-tint
         approach that only worked on a light sidebar. -->
    <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="#FFFFFF"/>

    <!-- ========= Status ========= -->

    <SolidColorBrush x:Key="SuccessBrush" Color="#12B76A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F04438"/>
    <SolidColorBrush x:Key="OtBrush" Color="#7C5CFC"/>
    <SolidColorBrush x:Key="WeekendBrush" Color="#8A93B8"/>

    <!-- ========= DataGrid ========= -->

    <!-- Deepened from #F7F9FD: that value sat only ~2-3% darker than the
         white CardBackgroundBrush behind it, so header rows visually
         blended into the body rows instead of reading as a distinct band.
         #EAEEF7 gives a clearly separated cool-gray strip while staying
         light enough not to compete with row content. -->
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#EAEEF7"/>
    <SolidColorBrush x:Key="TableHeaderTextBrush" Color="#5C6690"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F6F8FE"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#FAFBFE"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#EBF0FF"/>

    <!-- ========= Buttons ========= -->

    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#3E63DD"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#3253C3"/>

    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#D88F0F"/>

    <!-- Stat Badge Soft Tints (Light Mode) - flat pastel fills (not alpha
         overlays) so they render identically over any card background,
         matching the pill/badge look in the reference dashboards. -->
    <SolidColorBrush x:Key="PrimaryBadgeBrush" Color="#EAF0FE"/>
    <SolidColorBrush x:Key="WarningBadgeBrush" Color="#FDF1DF"/>
    <SolidColorBrush x:Key="SuccessBadgeBrush" Color="#E4F8EE"/>
    <SolidColorBrush x:Key="DangerBadgeBrush" Color="#FDEAE8"/>

    <!-- Added for the purple ("OT"/CardAccentPurple family) stat-card
         icon badge - same flat-pastel-tint pattern as the four badges
         above, previously missing so purple-accented stat cards (e.g.
         Manage KPI's "KPI Types" card) had no matching badge fill. -->
    <SolidColorBrush x:Key="PurpleBadgeBrush" Color="#F0EBFF"/>

    <!-- ========= Shadows (shared DropShadow color/opacity tokens) ========= -->
    <!-- Centralized so TableStyles/ProfileView/DashboardView card shadows
         share one soft, cool-toned shadow instead of each file picking a
         slightly different color/opacity by hand. -->
    <Color x:Key="CardShadowColor">#1A2B3674</Color>

    <!-- ========= Attendance calendar status fills ========= -->
    <!-- Moved here (and mirrored in DarkBrushes.xaml) from AttendanceResources.xaml
         so they swap with the rest of the palette via SettingService.ApplyTheme.
         AttendanceResources.xaml is merged once, globally, and never swapped -
         so any brush defined only there is frozen at whatever it was set to at
         startup regardless of theme. Keeping the same keys means
         AttendanceCalendarView.xaml, AttendanceStatusToBrushConverter, and the
         legend swatches don't need any changes beyond DynamicResource lookups. -->
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#12B76A"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#F04438"/>
    <SolidColorBrush x:Key="OtBgBrush" Color="#7C5CFC"/>
    <SolidColorBrush x:Key="DayOffBgBrush" Color="#63ADD0"/>
    <SolidColorBrush x:Key="WeekendBgBrush" Color="#F3F5FA"/>
    <SolidColorBrush x:Key="NeutralBgBrush" Color="#F3F5FA"/>

    <SolidColorBrush x:Key="StatusHeaderTextBrush" Color="#FFFFFF"/>

</ResourceDictionary>
