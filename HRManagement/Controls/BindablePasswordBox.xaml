<UserControl x:Class="HRManagement.Controls.BindablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             x:Name="Root"
             Height="42">

    <!-- All brush references below are DynamicResource, not StaticResource -
         this control is created once and kept alive for the life of its
         host (LoginWindow, SettingsView), so a StaticResource lookup here
         freezes at whatever theme was active on load and never sees
         SettingService.ApplyTheme's later dictionary swap (same class of
         bug as the attendance legend swatches). -->
    <Border Background="{DynamicResource InputBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            CornerRadius="8">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <!-- Password -->

            <PasswordBox x:Name="PasswordBox"
                         Grid.Column="0"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <!-- Visible Text -->

            <TextBox x:Name="TextBox"
                     Grid.Column="0"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     Visibility="Collapsed"
                     TextChanged="TextBox_TextChanged"/>

            <!-- Eye Button -->

            <Button x:Name="ToggleButton"
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ToggleButton_Click">

                <fa:IconBlock x:Name="EyeIcon"
                              Icon="Eye"
                              Width="16"
                              Height="16"
                              Foreground="{DynamicResource SecondaryTextBrush}"/>

            </Button>

        </Grid>

    </Border>

</UserControl>