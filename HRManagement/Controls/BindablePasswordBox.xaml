<UserControl x:Class="HRManagement.Controls.BindablePasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             x:Name="Root"
             Height="42">

    <Border Background="{StaticResource InputBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <!-- Lock Icon -->

            <fa:IconBlock Grid.Column="0"
                          Icon="Lock"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource SecondaryTextBrush}" />

            <!-- Password -->

            <PasswordBox x:Name="PasswordBox"
                         Grid.Column="1"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <!-- Visible Text -->

            <TextBox x:Name="TextBox"
                     Grid.Column="1"
                     Margin="0,0,10,0"
                     VerticalContentAlignment="Center"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{StaticResource PrimaryTextBrush}"
                     Visibility="Collapsed"
                     TextChanged="TextBox_TextChanged"/>

            <!-- Eye Button -->

            <Button x:Name="ToggleButton"
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ToggleButton_Click">

                <fa:IconBlock x:Name="EyeIcon"
                              Icon="Eye"
                              Width="16"
                              Height="16"
                              Foreground="{StaticResource SecondaryTextBrush}"/>

            </Button>

        </Grid>

    </Border>

</UserControl>