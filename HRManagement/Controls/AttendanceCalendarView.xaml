<UserControl x:Class="HRManagement.Controls.AttendanceCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HRManagement.Controls"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignWidth="700" d:DesignHeight="640">

    <!--
        Single reusable calendar: month navigation + weekday header + the
        7-column day grid + a bottom status legend. DataContext must be an
        AttendanceViewModel (CurrentMonth, Days, PrevMonthCommand,
        NextMonthCommand).

        Both AttendanceView (the logged-in user's own calendar) and
        ManageAttendancesView (an admin/manager viewing another employee's
        calendar via ChildAttendanceViewModel) embed this control instead
        of each keeping their own copy of the DataTemplate, so there is
        exactly one place that defines what a calendar cell looks like -
        and, as of the attendance redesign, one place that defines the
        legend too (previously duplicated/owned by AttendanceView.xaml).

        Resources (StatusToBrushConverter, BoolToVisibility, brushes, etc.)
        come from AttendanceResources.xaml, merged once at the app level
        via App.xaml - this control does not merge its own copy, to avoid
        the duplicate-resource-key problems that existed previously.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Month navigation -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource CalendarNavButtonStyle}"
                    Command="{Binding PrevMonthCommand}" />
            <TextBlock Text="{Binding CurrentMonth, StringFormat='MMMM yyyy'}"
                       Width="150"
                       TextAlignment="Center"
                       FontWeight="Bold" FontSize="16"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center" Margin="16,0" />
            <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource CalendarNavButtonStyle}"
                    Command="{Binding NextMonthCommand}" />
        </StackPanel>

        <!-- Days of week header -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
            <TextBlock Text="Mon" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="Tue" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="Wed" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="Thu" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="Fri" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="Sat" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="Sun" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
        </UniformGrid>

        <!-- Calendar grid: every cell gets the SAME fixed height regardless of how
             many week-rows the visible month needs, so the card size never jumps
             between a 4-row and a 6-row month. The ScrollViewer only kicks in if
             a 6-row month can't fit the available vertical space. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Fixed Height keeps every cell identical no matter how many
                             lines of content (times, lateness, status) it has, and no
                             matter whether the month renders 5 or 6 week-rows. -->
                        <Border Height="96"
                                Margin="4"
                                CornerRadius="8"
                                BorderThickness="1"
                                Background="{Binding Status, Converter={StaticResource AttendanceStatusToBrushConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <!-- Leading/trailing days from adjacent months: subdued placeholder -->
                                        <DataTrigger Binding="{Binding IsFillerCell}" Value="True">
                                            <Setter Property="Opacity" Value="0.35" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="8,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Date number -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding Date, StringFormat='dd/MM'}"
                                           FontWeight="Bold" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasStatus}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Weekend">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Before Hire Date">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Row 1: Hours worked (dominant content), with a smaller
                                     HH:mm-HH:mm range beneath it. Only shown when the day
                                     actually has both a check-in and check-out and isn't a
                                     plain weekend/before-hire day (see ShouldShowWorkedHours). -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                            Visibility="{Binding ShouldShowWorkedHours, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding WorkedHoursDisplay}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Left" />
                                    <TextBlock FontSize="10" Foreground="White" Opacity="0.9">
                                        <Run Text="{Binding CheckIn, StringFormat='{}{0:HH:mm}', Mode=OneWay}"/>
                                        <Run Text="–"/>
                                        <Run Text="{Binding CheckOut, StringFormat='{}{0:HH:mm}', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Row 2: Status word -->
                                <TextBlock Grid.Row="2"
                                           Text="{Binding DisplayStatusWord}"
                                           FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Weekend">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Before Hire Date">
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasStatus}" Value="False">
                                                    <Setter Property="Foreground" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom legend: moved here from AttendanceView.xaml so both consumers
             (AttendanceView, ManageAttendancesView) get it automatically since
             this control is shared. Reuses the same status brushes as the cells
             themselves (AttendanceStatusToBrushConverter's keys) - no new colors. -->
        <UniformGrid Grid.Row="3" Rows="1" Margin="0,14,0,0" HorizontalAlignment="Center">
            <UniformGrid.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal"/>
                    <Setter Property="Margin" Value="10,0"/>
                </Style>
            </UniformGrid.Resources>

            <StackPanel>
                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource SuccessBgBrush}" Stroke="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" Ontime" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
            <StackPanel>
                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource WarningBgBrush}" Stroke="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" Late" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
            <StackPanel>
                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource DangerBgBrush}" Stroke="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" Absent" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
            <StackPanel>
                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource WeekendBgBrush}" Stroke="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" Weekend" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
            <StackPanel>
                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource OtBgBrush}" Stroke="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" OT" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
            <StackPanel>
                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource DayOffBgBrush}" Stroke="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" Day Off" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
            <StackPanel>
                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource NeutralBgBrush}" Stroke="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" Before hire date" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>
        </UniformGrid>
    </Grid>
</UserControl>
